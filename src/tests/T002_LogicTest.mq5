//+------------------------------------------------------------------+
//|                                          T002_LogicTest.mq5      |
//|                                                                  |
//|  T002 - MT5 script that runs the controlled-data cases of the    |
//|  PROPOSED H4 model against src/include/H4Structure.mqh.          |
//|                                                                  |
//|  STATUS: WRITTEN BUT NOT COMPILED AND NOT RUN. MetaEditor was    |
//|  not available. The case data block below is generated from      |
//|  tests/t002_reference_test.py (--emit-mql); the expected strings |
//|  therefore come from the Python MODEL. A PASS in MT5 would show  |
//|  that the MQL5 code agrees with that model on these cases; it    |
//|  says nothing about whether the rules are what the client wants. |
//|                                                                  |
//|  This is a SCRIPT (OnStart): it belongs under MQL5/Scripts/, NOT |
//|  under Experts. Install: copy the whole repository src/ folder   |
//|  to <terminal data folder>/MQL5/Scripts/velo_src/ so that these  |
//|  two paths exist side by side:                                   |
//|    MQL5/Scripts/velo_src/tests/T002_LogicTest.mq5                |
//|    MQL5/Scripts/velo_src/include/H4Structure.mqh                 |
//|  (the include "../include/H4Structure.mqh" is relative to this   |
//|  file, so tests/ and include/ must stay siblings). Compile it,   |
//|  drag the script on any chart, read the Experts log for          |
//|  "T002 LOGIC TEST". Install layout NOT tested in MT5.            |
//+------------------------------------------------------------------+
#property copyright "velireci"
#property version   "1.00"
#property script_show_inputs

#include "../include/H4Structure.mqh"

#define T2_PERIOD 14400

int g_pass = 0;
int g_fail = 0;

void Check(const bool cond, const string label)
  {
   if(cond)
     {
      g_pass++;
      PrintFormat("  PASS %s", label);
     }
   else
     {
      g_fail++;
      PrintFormat("  FAIL %s", label);
     }
  }

datetime T2Base(void) { return(D'2026.01.05 00:00'); }

//--- d holds high,low,close triples; bar i opens at base + i * 4h
void T2FillBars(const double &d[], const int count, MqlRates &bars[])
  {
   ArrayResize(bars, count);
   for(int i = 0; i < count; i++)
     {
      bars[i].time  = T2Base() + (datetime)(i * T2_PERIOD);
      bars[i].high  = d[3 * i];
      bars[i].low   = d[3 * i + 1];
      bars[i].close = d[3 * i + 2];
      bars[i].open  = d[3 * i + 2];
     }
  }

