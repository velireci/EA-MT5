// END GENERATED CASE DATA

int T2FindCase(const string name)
  {
   for(int i = 0; i < T2_CASE_COUNT; i++)
     {
      MqlRates b[];
      int n, l, r;
      double p;
      string nm, ex;
      T2LoadCase(i, b, n, l, r, p, nm, ex);
      if(nm == name)
         return(i);
     }
   return(-1);
  }

SH4Swing T2MkSwing(const bool is_high, const int idx, const double price)
  {
   SH4Swing s;
   s.id = StringFormat("S%d%s", idx, is_high ? "H" : "L");
   s.is_high = is_high;
   s.index = idx;
   s.pivot_time = T2Base() + (datetime)(idx * T2_PERIOD);
   s.confirm_time = T2Base() + (datetime)((idx + 3) * T2_PERIOD);
   s.price = price;
   return(s);
  }

//--- 1. every generated case: summary string must equal the model's
void TestGeneratedCases(void)
  {
   Print("--- generated cases (summary string equality with the Python model)");
   for(int i = 0; i < T2_CASE_COUNT; i++)
     {
      MqlRates bars[];
      int n, l, r;
      double price;
      string name, expected;
      T2LoadCase(i, bars, n, l, r, price, name, expected);
      SH4Swing sw[];
      SH4Fvg fv[];
      SH4Result res;
      int ns, nf;
      H4Analyze(bars, n, l, r, T2_PERIOD, sw, ns, fv, nf, res);
      string got = H4Summary(sw, ns, fv, nf, res, price);
      bool ok = (got == expected);
      Check(ok, name);
      if(!ok)
        {
         Print("    expected: ", expected);
         Print("    got:      ", got);
        }
     }
  }

//--- 2. synthetic swing lists: missing interval
void TestMissingInterval(void)
  {
   Print("--- missing interval (synthetic swing lists)");
   SH4Swing a[];
   SH4Result res;
   ZeroMemory(res);
   // bearish by values, both highs after the latest low -> UNDEFINED
   ArrayResize(a, 4);
   a[0] = T2MkSwing(false, 1, 20.0);
   a[1] = T2MkSwing(false, 3, 10.0);
   a[2] = T2MkSwing(true, 5, 40.0);
   a[3] = T2MkSwing(true, 7, 30.0);
   int d = H4DeriveDirection(a, 4);
   H4DeriveInterval(a, 4, d, res);
   Check(d == H4_DIR_BEARISH && res.range_state == H4_RNG_UNDEFINED, "no swing high before latest low -> UNDEFINED");
   // H <= L
   a[0] = T2MkSwing(false, 1, 25.0);
   a[1] = T2MkSwing(true, 2, 30.0);
   a[2] = T2MkSwing(true, 4, 8.0);
   a[3] = T2MkSwing(false, 6, 20.0);
   d = H4DeriveDirection(a, 4);
   H4DeriveInterval(a, 4, d, res);
   Check(d == H4_DIR_BEARISH && res.range_state == H4_RNG_UNDEFINED, "H <= L -> UNDEFINED");
   // bullish: lows only after the latest high
   a[0] = T2MkSwing(true, 1, 20.0);
   a[1] = T2MkSwing(true, 3, 30.0);
   a[2] = T2MkSwing(false, 5, 5.0);
   a[3] = T2MkSwing(false, 7, 8.0);
   d = H4DeriveDirection(a, 4);
   H4DeriveInterval(a, 4, d, res);
   Check(d == H4_DIR_BULLISH && res.range_state == H4_RNG_UNDEFINED, "bullish: no swing low before latest high -> UNDEFINED");
   // undefined interval -> no candidate
   SH4Fvg f[];
   ArrayResize(f, 1);
   f[0].bullish = true;
   f[0].state = H4_FVG_FRESH;
   f[0].lower = 1.0;
   f[0].upper = 2.0;
   H4ClassifyFvgs(f, 1, res);
   Check(f[0].cls == H4_CLS_NONE, "undefined interval -> FVG never an IRL candidate");
  }

//--- 3. classification
void TestClassification(void)
  {
   Print("--- OUTSIDE / OPPOSITE classification");
   SH4Result res;
   ZeroMemory(res);
   res.direction = H4_DIR_BEARISH;
   res.range_state = H4_RNG_VALID;
   res.range_high = 2081.0;
   res.range_low = 2023.0;
   SH4Fvg f[];
   ArrayResize(f, 5);
   double lo[5] = {2079.0, 2075.0, 2057.0, 2073.0, 2023.0};
   double up[5] = {2087.0, 2083.0, 2063.0, 2079.0, 2081.0};
   bool bu[5]   = {false, false, false, true, false};
   for(int i = 0; i < 5; i++)
     {
      f[i].bullish = bu[i];
      f[i].lower = lo[i];
      f[i].upper = up[i];
      f[i].state = H4_FVG_FRESH;
     }
   H4ClassifyFvgs(f, 5, res);
   Check(f[0].cls == H4_CLS_OUTSIDE && f[1].cls == H4_CLS_OUTSIDE && f[2].cls == H4_CLS_IRL &&
         f[3].cls == H4_CLS_OPPOSITE, "partial overlap/outside -> OUTSIDE, inside -> IRL, wrong type -> OPPOSITE");
   Check(f[4].cls == H4_CLS_IRL, "containment inclusive at interval edges");
  }

//--- 4. ERL taken helper
void TestErl(void)
  {
   Print("--- ERL taken helper");
   MqlRates b[];
   double d1[] = {50,40,45, 60,20,40, 55,45,50, 56,46,50, 57,47,50};
   T2FillBars(d1, 5, b);
   Check(H4ErlTakenTime(b, 5, 21.0, true, b[2].time) == 0, "touch BEFORE range_known_time does not count");
   double d2[] = {50,40,45, 60,20,40, 55,45,50, 56,18,50, 90,80,85, 95,85,90};
   T2FillBars(d2, 6, b);
   Check(H4ErlTakenTime(b, 6, 21.0, true, b[2].time) == b[3].time, "TAKEN keeps first touching bar though price moves away");
   Check(H4ErlTakenTime(b, 6, 21.0, true, b[4].time) == 0, "later known_time: not taken");
   Check(H4ErlTakenTime(b, 6, 56.0, false, b[2].time) == b[3].time, "BUY: High >= ERL counts (equality)");
  }

//--- 5. tie-break by ID
void TestTieBreak(void)
  {
   Print("--- selection tie-break");
   SH4Result res;
   ZeroMemory(res);
   res.direction = H4_DIR_BEARISH;
   res.range_state = H4_RNG_VALID;
   SH4Fvg f[];
   ArrayResize(f, 2);
   string ids[2] = {"F202601050400D", "F202601050000D"};
   for(int i = 0; i < 2; i++)
     {
      f[i].id = ids[i];
      f[i].lower = 10.0;
      f[i].upper = 12.0;
      f[i].state = H4_FVG_FRESH;
      f[i].cls = H4_CLS_IRL;
      f[i].confirm_time = 777;
     }
   int order[];
   int c = H4SelectIrl(f, 2, res, 5.0, order);
   Check(c == 2 && f[order[0]].id == "F202601050000D", "distance and confirm_time tie -> ID ascending");
  }

//--- 6. no look-ahead: prefix analysis vs full analysis restricted to T
void TestNoLookahead(const string name)
  {
   PrintFormat("--- prefix vs full (no look-ahead): %s", name);
   int id = T2FindCase(name);
   if(id < 0)
     {
      Check(false, "case found: " + name);
      return;
     }
   MqlRates bars[];
   int n, l, r;
   double price;
   string nm, ex;
   T2LoadCase(id, bars, n, l, r, price, nm, ex);
   SH4Swing fsw[];
   SH4Fvg ffv[];
   SH4Result fres;
   int fns, fnf;
   H4Analyze(bars, n, l, r, T2_PERIOD, fsw, fns, ffv, fnf, fres);

   bool ok = true;
   bool poison_ok = true;
   for(int k = 8; k <= n; k++)
     {
      datetime T = bars[k - 1].time + T2_PERIOD;
      SH4Swing psw[];
      SH4Fvg pfv[];
      SH4Result pres;
      int pns, pnf;
      H4Analyze(bars, k, l, r, T2_PERIOD, psw, pns, pfv, pnf, pres);

      //--- full swings confirmed by T
      SH4Swing rs[];
      int nrs = 0;
      for(int i = 0; i < fns; i++)
         if(fsw[i].confirm_time <= T)
           {
            ArrayResize(rs, nrs + 1);
            rs[nrs] = fsw[i];
            nrs++;
           }
      bool same = (nrs == pns);
      for(int i = 0; same && i < nrs; i++)
         same = (rs[i].id == psw[i].id && rs[i].confirm_time == psw[i].confirm_time && rs[i].price == psw[i].price);

      //--- full FVGs confirmed by T, states re-evaluated with k bars only
      SH4Fvg rf[];
      int nrf = 0;
      for(int i = 0; i < fnf; i++)
         if(ffv[i].confirm_time <= T)
           {
            ArrayResize(rf, nrf + 1);
            rf[nrf] = ffv[i];
            nrf++;
           }
      H4EvalFvgStates(bars, k, rf, nrf);
      same = same && (nrf == pnf);
      for(int i = 0; same && i < nrf; i++)
         same = (rf[i].id == pfv[i].id && rf[i].confirm_time == pfv[i].confirm_time &&
                 rf[i].lower == pfv[i].lower && rf[i].upper == pfv[i].upper && rf[i].state == pfv[i].state);

      //--- direction / interval from the restricted swing list
      SH4Result tmp;
      ZeroMemory(tmp);
      int d = H4DeriveDirection(rs, nrs);
      H4DeriveInterval(rs, nrs, d, tmp);
      same = same && d == pres.direction && tmp.range_state == pres.range_state &&
             tmp.range_high == pres.range_high && tmp.range_low == pres.range_low &&
             tmp.range_known_time == pres.range_known_time;
      ok = ok && same;

      //--- poison: values after index k-1 must never be read
      MqlRates bad[];
      ArrayResize(bad, n);
      for(int i = 0; i < n; i++)
         bad[i] = bars[i];
      for(int i = k; i < n; i++)
        {
         bad[i].high = 99999.0;
         bad[i].low = -99999.0;
         bad[i].close = 0.0;
        }
      SH4Swing zsw[];
      SH4Fvg zfv[];
      SH4Result zres;
      int zns, znf;
      H4Analyze(bad, k, l, r, T2_PERIOD, zsw, zns, zfv, znf, zres);
      poison_ok = poison_ok && (H4Summary(zsw, zns, zfv, znf, zres, price) ==
                                H4Summary(psw, pns, pfv, pnf, pres, price));
     }
   Check(ok, "prefix == full restricted to what was knowable at T");
   Check(poison_ok, "bars after the analysed count never influence the result");
  }

//--- 7. IDs
void TestIds(void)
  {
   Print("--- IDs");
   int id = T2FindCase("bear_invalid_eq");
   MqlRates bars[];
   int n, l, r;
   double price;
   string nm, ex;
   T2LoadCase(id, bars, n, l, r, price, nm, ex);
   SH4Swing sw[];
   SH4Fvg fv[];
   SH4Result res;
   int ns, nf;
   H4Analyze(bars, n, l, r, T2_PERIOD, sw, ns, fv, nf, res);
   string first = H4Summary(sw, ns, fv, nf, res, price);
   H4Analyze(bars, n, l, r, T2_PERIOD, sw, ns, fv, nf, res);
   Check(first == H4Summary(sw, ns, fv, nf, res, price), "analysis is deterministic");
   bool unique = true;
   for(int i = 0; i < nf; i++)
     {
      for(int j = i + 1; j < nf; j++)
         if(fv[i].id == fv[j].id)
            unique = false;
      if(StringLen(fv[i].id) != 14)
         unique = false;
     }
   for(int i = 0; i < ns; i++)
      for(int j = i + 1; j < ns; j++)
         if(sw[i].id == sw[j].id)
            unique = false;
   Check(unique, "FVG/swing IDs unique, FVG ID is F + 12 digits + U|D");
   Check(H4TimeStamp(T2Base()) == "202601050000", "ID time stamp is built from the raw time value");
  }

//--- 7. pure decisions (mirrored in tests/t002_reference_test.py test_pure_decisions)
void TestPureDecisions(void)
  {
   Print("--- history state, stall, tick arithmetic, map transitions, panel wording");
   Check(H4HistoryState(6, 300, 2, 2) == H4_HIST_INSUFFICIENT, "history 6 of 300 (min 11) -> INSUFFICIENT");
   Check(H4HistoryState(11, 300, 2, 2) == H4_HIST_PARTIAL, "history 11 of 300 -> PARTIAL");
   Check(H4HistoryState(299, 300, 2, 2) == H4_HIST_PARTIAL, "history 299 of 300 -> PARTIAL");
   Check(H4HistoryState(300, 300, 2, 2) == H4_HIST_COMPLETE, "history 300 of 300 -> COMPLETE");
   Check(H4HistoryText(H4_HIST_INSUFFICIENT, 6, 300, false) == "INSUFFICIENT HISTORY (6 of 300 bars)", "text INSUFFICIENT");
   Check(H4HistoryText(H4_HIST_INSUFFICIENT, 6, 300, true) == "INSUFFICIENT HISTORY (6 of 300 bars, loading stalled; retrying)", "text INSUFFICIENT stalled");
   Check(H4HistoryText(H4_HIST_PARTIAL, 120, 300, false) == "PARTIAL HISTORY (120 of 300, refreshing)", "text PARTIAL refreshing");
   Check(H4HistoryText(H4_HIST_PARTIAL, 120, 300, true) == "PARTIAL HISTORY (120 of 300, loading stalled; retrying)", "text PARTIAL stalled");
   Check(H4HistoryText(H4_HIST_COMPLETE, 300, 300, false) == "HISTORY COMPLETE (300 of 300)", "text COMPLETE");
   bool no_claim = true;
   for(int st = 0; st <= 2; st++)
      for(int sl = 0; sl <= 1; sl++)
         if(StringFind(H4HistoryText(st, 100, 300, sl == 1), "no more on server") >= 0)
            no_claim = false;
   Check(no_claim, "no history text claims \"no more on server\"");
   datetime t1 = T2Base();
   datetime t0 = t1 - (datetime)T2_PERIOD;
   Check(H4HistoryImproved(100, t1, 101, t1), "more bars -> improved");
   Check(H4HistoryImproved(100, t1, 100, t0), "older first bar -> improved");
   Check(!H4HistoryImproved(100, t1, 100, t1), "same count and first bar -> not improved");
   Check(!H4HistoryImproved(100, t1, 99, t1), "fewer bars -> not improved");
   Check(!H4HistoryImproved(0, 0, 0, 0), "nothing yet -> not improved");
   Check(!H4HistStalled(H4_HIST_PARTIAL, 19, 20), "partial, 19 idle checks -> not stalled yet");
   Check(H4HistStalled(H4_HIST_PARTIAL, 20, 20), "partial, 20 idle checks -> stalled (slower cadence, NOT stopped)");
   Check(H4HistStalled(H4_HIST_INSUFFICIENT, 25, 20), "insufficient, 25 idle checks -> stalled");
   Check(!H4HistStalled(H4_HIST_COMPLETE, 99, 20), "complete -> never stalled");
   Check(H4ElapsedMs((uint)5000, (uint)2000) == 3000, "elapsed ms without wrap");
   Check(H4ElapsedMs(5, (uint)4294967290) == 11, "elapsed ms across the GetTickCount wrap (unsigned subtraction)");
   Check(H4ElapsedMs(512, (uint)4294967040) == 768, "elapsed ms across the wrap, second sample");
   Check(H4MapTransition(true, false) == H4_ACT_CLEAR, "map + failed build -> CLEAR");
   Check(H4MapTransition(false, true) == H4_ACT_REBUILT, "no map + ok build -> REBUILT");
   Check(H4MapTransition(true, true) == H4_ACT_REFRESHED, "map + ok build -> REFRESHED");
   Check(H4MapTransition(false, false) == H4_ACT_NONE, "no map + failed build -> NONE");
   SH4Result r;
   ZeroMemory(r);
   r.direction = H4_DIR_BEARISH;
   r.range_state = H4_RNG_VALID;
   r.erl_state = H4_ERL_UNTOUCHED;
   Check(H4SetupActive(r, 1), "bearish, valid, ERL untouched, 1 candidate -> active");
   Check(!H4SetupActive(r, 0), "no selectable candidate -> inactive");
   r.erl_state = H4_ERL_TAKEN;
   Check(!H4SetupActive(r, 1), "ERL TAKEN -> inactive");
   r.erl_state = H4_ERL_UNTOUCHED;
   r.range_state = H4_RNG_UNDEFINED;
   Check(!H4SetupActive(r, 1), "interval not valid -> inactive");
   r.range_state = H4_RNG_VALID;
   r.direction = H4_DIR_MIXED;
   Check(!H4SetupActive(r, 1), "direction not trending -> inactive");
   string z = "F1 FRESH [10.00 - 12.00]";
   Check(H4IrlPanelText(true, H4_ERL_UNTOUCHED, z, false) == "nearest IRL: F1 FRESH [10.00 - 12.00] ahead -> ERL", "UNTOUCHED ahead wording");
   Check(H4IrlPanelText(true, H4_ERL_UNTOUCHED, z, true) == "nearest IRL: F1 FRESH [10.00 - 12.00] INSIDE -> ERL", "UNTOUCHED inside wording");
   Check(H4IrlPanelText(false, H4_ERL_TAKEN, z, false) == "candidate (inactive: ERL TAKEN): F1 FRESH [10.00 - 12.00] ahead", "TAKEN wording has no -> ERL");
   Check(StringFind(H4IrlPanelText(false, H4_ERL_TAKEN, z, true), "-> ERL") < 0, "TAKEN inside wording has no -> ERL");
  }

//--- 8. map lifecycle scenarios. Twin of Sim / run_scenario in
//--- tests/t002_reference_test.py: a scripted fake data source driven over
//--- simulated seconds through the SAME step functions the EA calls
//--- (H4LifeDecide / H4LifeOnCopy). The transcript of every scenario must equal
//--- the one generated from the Python model. This still is not MT5 CopyRates.
#define T2_LOOKBACK 300
#define T2_BASE_IDX 1000

SH4Life g_lf;
int     s_first = 0, s_last = 0, s_seen = -1, s_t = 0;
bool    s_ready = true, s_fail = false, s_mismatch = false, s_drawn = false, s_hist = false;
int     s_wlast = 0;
ulong   s_start = 0;
string  s_ev = "";

datetime T2SimTime(const int k) { return(T2Base() + (datetime)((T2_BASE_IDX + k) * T2_PERIOD)); }

void T2Ev(const string kind, const string text)
  {
   if(s_ev != "")
      s_ev += " | ";
   s_ev += StringFormat("t=%d %s", s_t, kind);
   if(text != "")
      s_ev += ":" + text;
  }

void T2SimCopy(const string kind_char, int &got, datetime &oldest, bool &newest_ok)
  {
   T2Ev(kind_char, "");
   if(s_fail)
     {
      got = -1;
      oldest = 0;
      newest_ok = false;
      return;
     }
   got = MathMin(T2_LOOKBACK, s_last - s_first + 1);
   if(got <= 0)
     {
      got = 0;                 // no closed bar in range (as-of before the history)
      oldest = 0;
      newest_ok = false;
      return;
     }
   datetime watcher_open = T2SimTime(s_wlast) + (datetime)(s_mismatch ? T2_PERIOD : 0);
   oldest = T2SimTime(s_last - got + 1);
   newest_ok = H4NewestOk(s_hist, T2SimTime(s_last), watcher_open);
  }

void T2Apply(const SH4LifeOut &o)
  {
   if(o.log_hist)
      T2Ev("HIST", g_lf.hist_text);
   if(o.do_clear)
     {
      T2Ev("CLEAR", o.clear_reason);
      s_drawn = false;
     }
  }

bool T2SimBuild(void)
  {
   int got;
   datetime oldest;
   bool ok;
   T2SimCopy("B", got, oldest, ok);
   SH4LifeOut o;
   H4LifeOnCopy(g_lf, H4_ATT_BUILD, got, oldest, ok, T2_LOOKBACK, 2, 2, o);
   T2Apply(o);
   if(!o.rebuilt)
      return(false);
   if(o.log_rebuilt != "")
      T2Ev("REBUILT", o.log_rebuilt);
   T2Ev("MAP", IntegerToString(got));
   s_drawn = true;
   return(true);
  }

bool T2SimProbe(void)
  {
   int got;
   datetime oldest;
   bool ok;
   T2SimCopy("P", got, oldest, ok);
   SH4LifeOut o;
   H4LifeOnCopy(g_lf, H4_ATT_PROBE, got, oldest, true, T2_LOOKBACK, 2, 2, o);
   T2Apply(o);
   if(o.attempt == H4_ATT_BUILD)
      return(T2SimBuild());
   return(false);
  }

void T2SimPoll(const int t)
  {
   s_t = t;
   bool new_bar = false;
   if(s_ready)
     {
      new_bar = (s_seen >= 0 && s_wlast > s_seen);
      s_seen = s_wlast;
     }
   ulong full = s_start + (ulong)t * 1000;
   uint now_ms = (uint)(full % (ulong)4294967296);
   SH4LifeOut o;
   H4LifeDecide(g_lf, s_ready, "H4 series not ready: SIM", H4NewBarForLife(s_hist, new_bar),
                now_ms, T2_LOOKBACK, o);
   T2Apply(o);
   if(s_ready)
     {
      if(o.attempt == H4_ATT_PROBE)
         T2SimProbe();
      else
         if(o.attempt == H4_ATT_BUILD)
            T2SimBuild();
     }
  }

//--- ops: 0 first, 1 last, 2 ready, 3 fail, 4 mismatch, 5 watcher last, 6 historical mode, 9 nop
string T2RunScenario(const int id, string &name, string &expected)
  {
   ulong start_ms;
   int first, last, duration;
   int acts[];
   T2LoadScenario(id, name, start_ms, first, last, duration, acts, expected);
   H4LifeInit(g_lf);
   s_first = first;
   s_last = last;
   s_wlast = last;
   s_hist = false;
   s_seen = -1;
   s_ready = true;
   s_fail = false;
   s_mismatch = false;
   s_drawn = false;
   s_start = start_ms;
   s_ev = "";
   for(int t = 0; t <= duration; t++)
     {
      for(int i = 0; i + 2 < ArraySize(acts); i += 3)
         if(acts[i] == t)
           {
            int op = acts[i + 1];
            int val = acts[i + 2];
            switch(op)
              {
               case 0: s_first = val; break;
               case 1:
                  s_last = val;
                  if(!s_hist)
                     s_wlast = val;
                  break;
               case 2: s_ready = (val != 0); break;
               case 3: s_fail = (val != 0); break;
               case 4: s_mismatch = (val != 0); break;
               case 5: s_wlast = val; break;
               case 6: s_hist = (val != 0); break;
              }
           }
      T2SimPoll(t);
     }
   s_ev += StringFormat(" | END map=%d drawn=%d noprog=%d text=%s", g_lf.have_map ? 1 : 0,
                        s_drawn ? 1 : 0, g_lf.noprog, g_lf.hist_text);
   return(s_ev);
  }

void TestLifecycle(void)
  {
   Print("--- map lifecycle scenarios (scripted fake source; transcript must equal the Python model's)");
   string trs[];
   string names[];
   ArrayResize(trs, T2_SCN_COUNT);
   ArrayResize(names, T2_SCN_COUNT);
   bool no_claim = true;
   for(int id = 0; id < T2_SCN_COUNT; id++)
     {
      string nm, ex;
      trs[id] = T2RunScenario(id, nm, ex);
      names[id] = nm;
      bool same = (trs[id] == ex);
      Check(same, "lifecycle scenario " + nm + ": transcript equals the Python model");
      if(!same)
         PrintFormat("    got:      %s\n    expected: %s", trs[id], ex);
      if(StringFind(trs[id], "no more on server") >= 0)
         no_claim = false;
     }
   Check(no_claim, "no lifecycle scenario claims \"no more on server\"");
   //--- a few explicit expectations (not only transcript equality)
   Check(StringFind(trs[0], "t=60 HIST:PARTIAL HISTORY (120 of 300, loading stalled; retrying)") >= 0, "(a) stalled status at the 20th idle check");
   Check(StringFind(trs[0], "t=90 P | t=120 P | t=120 B | t=120 HIST:HISTORY COMPLETE (300 of 300) | t=120 MAP:300") >= 0, "(a) 30 s cadence, rebuilt at t=120 without a new bar");
   Check(StringFind(trs[3], "t=18 CLEAR:history probe: CopyRates returned no closed H4 bars") >= 0, "(c) failed probe clears the map");
   Check(StringFind(trs[3], "t=42 REBUILT:history probe: CopyRates returned no closed H4 bars | t=42 MAP:120") >= 0, "(c) recovery rebuilds and logs the reason");
   Check(StringFind(trs[6], "t=16 CLEAR:H4 series not ready: SIM") >= 0, "(d) series not ready clears the map");
   Check(StringFind(trs[10], "t=30 CLEAR:newest copied bar does not match the watcher") >= 0, "(f) mismatch clears the map");
   Check(StringFind(trs[11], "t=0 B | t=0 HIST:HISTORY COMPLETE (300 of 300) | t=0 MAP:300 | END") >= 0, "(g) complete history: a single copy in 600 s");
   Check(trs[13] == trs[14] && trs[13] == trs[15], "(i) unsigned tick arithmetic: wrapped runs equal the unwrapped run");
   //--- historical review scenarios (indexes 16..21 = j1..j6)
   Check(StringFind(trs[16], "t=0 B | t=0 HIST:HISTORY COMPLETE (300 of 300) | t=0 MAP:300 | END map=1") >= 0 &&
         StringFind(trs[16], "t=30") < 0 && StringFind(trs[16], "t=60") < 0, "(j1) historical: new bars do not recompute or redraw");
   Check(StringFind(trs[17], "t=30 B | t=30 MAP:300 | t=60 B | t=60 MAP:300") >= 0, "(j2) live contrast: new bars rebuild");
   Check(StringFind(trs[18], "CLEAR") < 0 && StringFind(trs[18], "END map=1 drawn=1") >= 0, "(j3) historical: watcher ahead of the as-of set never clears the map");
   Check(StringFind(trs[19], "t=15 B | t=15 HIST:HISTORY COMPLETE (300 of 300) | t=15 MAP:300") >= 0 && StringFind(trs[19], "CLEAR") < 0,
         "(j4) as-of before the history: rebuilt when the history completes");
   Check(StringFind(trs[20], "t=27 P | t=27 B | t=27 HIST:HISTORY COMPLETE (300 of 300) | t=27 MAP:300") >= 0, "(j5) partial history completes in historical mode");
   Check(StringFind(trs[21], "t=16 CLEAR:H4 series not ready: SIM") >= 0 && StringFind(trs[21], "t=30 REBUILT:H4 series not ready: SIM") >= 0,
         "(j6) series not ready clears and rebuilds in historical mode");
  }

//--- 9. historical review (as-of): filter, no look-ahead, price, direction evidence.
//--- Twin of test_asof_filter / test_asof_no_lookahead / test_asof_price /
//--- test_direction_evidence in tests/t002_reference_test.py.
#define T2_MIRROR 4200.0

void TestAsOfFilter(void)
  {
   Print("--- as-of filter (H4ClosedCountAsOf and helpers)");
   double d[30];
   for(int i = 0; i < 10; i++)
     {
      d[3 * i]     = 10.0 + i;
      d[3 * i + 1] = 5.0 + i;
      d[3 * i + 2] = 7.5 + i;
     }
   MqlRates bars[];
   T2FillBars(d, 10, bars);
   Check(H4ClosedCountAsOf(bars, 10, bars[5].time + T2_PERIOD, T2_PERIOD) == 6, "bar closing exactly at AsOfTime is included");
   Check(H4ClosedCountAsOf(bars, 10, bars[5].time + T2_PERIOD - 1, T2_PERIOD) == 5, "bar closing 1 s after AsOfTime is excluded");
   Check(H4ClosedCountAsOf(bars, 10, bars[6].time, T2_PERIOD) == 6, "bar opening exactly at AsOfTime is excluded");
   Check(H4ClosedCountAsOf(bars, 10, bars[5].time + 3600, T2_PERIOD) == 5, "AsOfTime in the middle of bar 5: bar 5 excluded");
   Check(H4ClosedCountAsOf(bars, 10, bars[0].time, T2_PERIOD) == 0, "AsOfTime at the open of the first bar -> 0");
   Check(H4ClosedCountAsOf(bars, 10, T2Base() - 10 * T2_PERIOD, T2_PERIOD) == 0, "AsOfTime before all history -> 0");
   Check(H4ClosedCountAsOf(bars, 10, bars[0].time + T2_PERIOD - 1, T2_PERIOD) == 0, "AsOfTime 1 s before the first close -> 0");
   Check(H4ClosedCountAsOf(bars, 10, bars[0].time + T2_PERIOD, T2_PERIOD) == 1, "AsOfTime exactly at the first close -> 1");
   Check(H4ClosedCountAsOf(bars, 10, T2Base() + 1000000000, T2_PERIOD) == 10, "AsOfTime far in the future -> all bars");
   Check(H4ClosedCountAsOf(bars, 0, T2Base() + 1000000000, T2_PERIOD) == 0, "no bars -> 0");
   Check(H4ClosedCountAsOf(bars, 4, T2Base() + 1000000000, T2_PERIOD) == 4, "only the first n bars are looked at");
   Check(H4ClosedCountAsOf(bars, 10, bars[2].time + 3600, 3600) == 3, "period is a parameter");
   int prev = -1;
   bool mono = true;
   for(int k = 0; k < 12 * T2_PERIOD; k += 1800)
     {
      int c = H4ClosedCountAsOf(bars, 10, T2Base() + k, T2_PERIOD);
      mono = mono && c >= prev && c <= 10;
      prev = c;
     }
   Check(mono, "count never decreases as AsOfTime grows");
   datetime ft = T2Base() + 7 * T2_PERIOD;
   Check(H4EffectiveAsOf(T2Base() + 100 * T2_PERIOD, ft) == ft, "AsOfTime in the future is capped at the forming bar open");
   Check(H4EffectiveAsOf(T2Base() + 3 * T2_PERIOD, ft) == T2Base() + 3 * T2_PERIOD, "AsOfTime in the past is kept");
   Check(H4EffectiveAsOf(T2Base() + 3 * T2_PERIOD, 0) == T2Base() + 3 * T2_PERIOD, "unknown forming bar -> no cap");
   Check(H4ClosedCountAsOf(bars, 10, H4EffectiveAsOf(T2Base() + 1000000000, bars[7].time), T2_PERIOD) == 7,
         "future AsOfTime never counts the forming bar");
   Check(H4AsOfSetStart(300, 300) == 0 && H4AsOfSetStart(10, 300) == 0 && H4AsOfSetStart(350, 300) == 50 &&
         H4AsOfSetStart(301, 300) == 1, "set clipped to the newest lookback closed bars");
  }

//--- bars[0..cnt-1] kept; every later bar replaced; 6 more garbage bars appended
void T2Garbage(const MqlRates &bars[], const int n, const int cnt, const int variant, MqlRates &out[])
  {
   ArrayResize(out, n + 6);
   for(int j = 0; j < n + 6; j++)
     {
      if(j < cnt)
        {
         out[j] = bars[j];
         continue;
        }
      out[j].time = T2Base() + (datetime)(j * T2_PERIOD);
      if(variant == 0)
        {
         out[j].high  = 99999.0 + j;
         out[j].low   = -99999.0;
         out[j].close = (j % 2 == 0 ? 99999.0 : -99999.0);
        }
      else
         if(j < n)
           {
            out[j].high  = T2_MIRROR - bars[j].low;
            out[j].low   = T2_MIRROR - bars[j].high;
            out[j].close = T2_MIRROR - bars[j].close;
           }
         else
           {
            double k = (j - n + 1) * 50.0;
            out[j].high  = 6000.0 + k + 5.0;
            out[j].low   = 6000.0 + k - 5.0;
            out[j].close = 6000.0 + k;
           }
      out[j].open = out[j].close;
     }
  }

//--- the EA's historical path without the CopyRates call: filter, clip, analyse,
//--- summary with the historical price (close of the last bar of the set)
bool T2AsOfRun(const MqlRates &src[], const int srcn, const datetime asof, const int lb,
               const int l, const int r, string &summ, string &verdict, int &closed, int &dir_res, int &dir_ev)
  {
   closed = H4ClosedCountAsOf(src, srcn, asof, T2_PERIOD);
   if(closed <= 0)
      return(false);
   int start = H4AsOfSetStart(closed, lb);
   int cnt = closed - start;
   MqlRates st[];
   ArrayResize(st, cnt);
   for(int i = 0; i < cnt; i++)
      st[i] = src[start + i];
   SH4Swing sw[];
   SH4Fvg fv[];
   SH4Result res;
   int ns, nf;
   H4Analyze(st, cnt, l, r, T2_PERIOD, sw, ns, fv, nf, res);
   double price = H4SelectionPrice(true, st[cnt - 1].close, 0.0, 0.0);
   summ = H4Summary(sw, ns, fv, nf, res, price);
   SH4DirEvidence ev;
   H4DirectionEvidence(sw, ns, 2, ev);
   verdict = ev.verdict;
   dir_res = res.direction;
   dir_ev = ev.direction;
   return(true);
  }

void TestAsOfNoLookahead(void)
  {
   Print("--- as-of path: no look-ahead (truncated series == full series with garbage after AsOfTime)");
   for(int id = 0; id < T2_ASOF_COUNT; id++)
     {
      string name, exp_sum, exp_ver;
      int m, extra, lb, exp_cnt;
      T2LoadAsOf(id, name, m, extra, lb, exp_cnt, exp_sum, exp_ver);
      int ci = T2FindCase(name);
      if(ci < 0)
        {
         Check(false, "case found: " + name);
         continue;
        }
      MqlRates bars[];
      int n, l, r;
      double price;
      string nm, ex;
      T2LoadCase(ci, bars, n, l, r, price, nm, ex);
      datetime asof = bars[m - 1].time + T2_PERIOD + extra;
      bool ok = true;
      for(int variant = 0; variant < 2; variant++)
        {
         MqlRates g[];
         T2Garbage(bars, n, exp_cnt, variant, g);
         string sm, vd;
         int closed, dr, de;
         bool got = T2AsOfRun(g, ArraySize(g), asof, lb, l, r, sm, vd, closed, dr, de);
         ok = ok && got && closed == exp_cnt && sm == exp_sum && vd == exp_ver && dr == de;
        }
      //--- plain truncated series, no as-of function
      int s0 = (exp_cnt > lb ? exp_cnt - lb : 0);
      MqlRates tr[];
      ArrayResize(tr, exp_cnt - s0);
      for(int i = s0; i < exp_cnt; i++)
         tr[i - s0] = bars[i];
      SH4Swing tsw[];
      SH4Fvg tfv[];
      SH4Result tres;
      int tns, tnf;
      H4Analyze(tr, exp_cnt - s0, l, r, T2_PERIOD, tsw, tns, tfv, tnf, tres);
      ok = ok && (H4Summary(tsw, tns, tfv, tnf, tres, tr[exp_cnt - s0 - 1].close) == exp_sum);
      Check(ok, StringFormat("as-of %s m=%d extra=%d lookback=%d: result == truncated == Python model, garbage ignored",
                             name, m, extra, lb));
     }
  }

void TestAsOfPrice(void)
  {
   Print("--- historical price = close of the last closed bar; a live bid never changes the selection");
   int ci = T2FindCase("bear_touched_inside_two");
   MqlRates bars[];
   int n, l, r;
   double price;
   string nm, ex;
   T2LoadCase(ci, bars, n, l, r, price, nm, ex);
   SH4Swing sw[];
   SH4Fvg fv[];
   SH4Result res;
   int ns, nf;
   H4Analyze(bars, n, l, r, T2_PERIOD, sw, ns, fv, nf, res);
   double last_close = bars[n - 1].close;
   double bids[] = {0.0, -1.0, 1.0, 2036.0, 2055.0, 2058.0, 2070.0, 1000000.0};
   string base = H4Summary(sw, ns, fv, nf, res, H4SelectionPrice(true, last_close, 0.0, 0.0));
   bool same = true;
   for(int i = 0; i < ArraySize(bids); i++)
     {
      double p = H4SelectionPrice(true, last_close, bids[i], 1234.5);
      same = same && p == last_close && H4Summary(sw, ns, fv, nf, res, p) == base;
     }
   Check(same, "historical selection identical for any live bid");
   Check(H4SelectionPrice(false, 99.0, 2055.0, 1.0) == 2055.0 && H4SelectionPrice(false, 99.0, 0.0, 7.5) == 7.5 &&
         H4SelectionPrice(false, 99.0, -3.0, 7.5) == 7.5, "live mode keeps bid (previous price when bid is invalid)");
   int o1[], o3[];
   int c1 = H4SelectIrl(fv, nf, res, 2055.0, o1);
   int c3 = H4SelectIrl(fv, nf, res, 2070.0, o3);
   Check(c1 > 0 && c3 == 0, "sanity: the selection depends on the price, so the bid test has power");
  }

string T2Verdict(const SH4Swing &sw[], const int ns)
  {
   SH4DirEvidence ev;
   H4DirectionEvidence(sw, ns, 2, ev);
   return(ev.verdict);
  }

//--- every generated case: verdict text equals the Python model's, and on every
//--- prefix of every case the evidence direction equals H4DeriveDirection
void T2EvidenceSweep(bool &all_text, bool &all_dir, int &prefixes)
  {
   all_text = true;
   all_dir = true;
   prefixes = 0;
   for(int i = 0; i < T2_CASE_COUNT; i++)
     {
      MqlRates cb[];
      int cn, cl, cr;
      double cp;
      string cnm, cex;
      T2LoadCase(i, cb, cn, cl, cr, cp, cnm, cex);
      SH4Swing csw[];
      SH4Fvg cfv[];
      SH4Result cres;
      int cns, cnf;
      H4Analyze(cb, cn, cl, cr, T2_PERIOD, csw, cns, cfv, cnf, cres);
      if(T2Verdict(csw, cns) != T2EvidenceExpected(i))
        {
         all_text = false;
         PrintFormat("    verdict mismatch in %s: got '%s' expected '%s'", cnm, T2Verdict(csw, cns), T2EvidenceExpected(i));
        }
      for(int k = 1; k <= cn; k++)
        {
         SH4Swing psw[];
         SH4Fvg pfv[];
         SH4Result pres;
         int pns, pnf;
         H4Analyze(cb, k, cl, cr, T2_PERIOD, psw, pns, pfv, pnf, pres);
         SH4DirEvidence pev;
         H4DirectionEvidence(psw, pns, 2, pev);
         prefixes++;
         if(pev.direction != pres.direction || pev.direction != H4DeriveDirection(psw, pns))
            all_dir = false;
        }
     }
  }

void TestDirectionEvidence(void)
  {
   Print("--- direction evidence");
   bool all_text, all_dir;
   int prefixes;
   T2EvidenceSweep(all_text, all_dir, prefixes);
   Check(all_text, "verdict text equals the Python model for all generated cases");
   Check(all_dir, StringFormat("evidence direction == H4DeriveDirection on %d prefixes of all cases", prefixes));

   int id = T2FindCase("bear_base");
   MqlRates b[];
   int n, l, r;
   double price;
   string nm, ex;
   T2LoadCase(id, b, n, l, r, price, nm, ex);
   SH4Swing sw[];
   SH4Fvg fv[];
   SH4Result res;
   int ns, nf;
   H4Analyze(b, n, l, r, T2_PERIOD, sw, ns, fv, nf, res);
   SH4DirEvidence ev;
   H4DirectionEvidence(sw, ns, 2, ev);
   Check(ev.direction == H4_DIR_BEARISH && ev.h_cmp == H4_CMP_LOWER && ev.l_cmp == H4_CMP_LOWER &&
         ev.h_old < ev.h_new && ev.l_old < ev.l_new && ev.h_old_pivot < ev.h_new_pivot && ev.l_old_pivot < ev.l_new_pivot,
         "bear_base: BEARISH, LH + LL, swings older -> newer");
   Check(ev.h_new_price == sw[ev.h_new].price && ev.h_new_pivot == sw[ev.h_new].pivot_time &&
         ev.h_new_confirm == sw[ev.h_new].confirm_time && ev.l_old_price == sw[ev.l_old].price,
         "price, pivot_time and confirm_time are carried");
   int tagged = 0;
   for(int i = 0; i < ns; i++)
      if(H4IsDirSwing(ev, i))
         tagged++;
   Check(tagged == 4 && !H4IsDirSwing(ev, -1), "exactly four swings are tagged dir");
   id = T2FindCase("bull_base");
   T2LoadCase(id, b, n, l, r, price, nm, ex);
   H4Analyze(b, n, l, r, T2_PERIOD, sw, ns, fv, nf, res);
   H4DirectionEvidence(sw, ns, 2, ev);
   Check(ev.direction == H4_DIR_BULLISH && ev.h_cmp == H4_CMP_HIGHER && ev.l_cmp == H4_CMP_HIGHER, "bull_base: BULLISH, HH + HL");

   //--- synthetic swing lists: ties, opposite pairs, too few swings
   SH4Swing s1[];
   ArrayResize(s1, 4);
   s1[0] = T2MkSwing(true, 3, 110);  s1[1] = T2MkSwing(false, 6, 100);
   s1[2] = T2MkSwing(true, 9, 105);  s1[3] = T2MkSwing(false, 12, 100);
   H4DirectionEvidence(s1, 4, 2, ev);
   Check(ev.direction == H4_DIR_MIXED && ev.l_cmp == H4_CMP_EQUAL && H4DeriveDirection(s1, 4) == H4_DIR_MIXED &&
         StringFind(ev.verdict, "= EQ => MIXED (EQ is not a trend)") >= 0, "tie on the lows -> EQ -> MIXED");
   s1[1] = T2MkSwing(false, 6, 90);  s1[3] = T2MkSwing(false, 12, 95);
   H4DirectionEvidence(s1, 4, 2, ev);
   Check(ev.direction == H4_DIR_MIXED && H4DeriveDirection(s1, 4) == H4_DIR_MIXED &&
         StringFind(ev.verdict, "= HL => MIXED (highs LH but lows HL)") >= 0, "opposite pairs: highs LH, lows HL -> MIXED");
   s1[0] = T2MkSwing(true, 3, 110);  s1[2] = T2MkSwing(true, 9, 115);  s1[3] = T2MkSwing(false, 12, 85);
   H4DirectionEvidence(s1, 4, 2, ev);
   Check(ev.direction == H4_DIR_MIXED && StringFind(ev.verdict, "(highs HH but lows LL)") >= 0, "opposite pairs: highs HH, lows LL -> MIXED");
   s1[2] = T2MkSwing(true, 9, 110);  s1[3] = T2MkSwing(false, 12, 90);
   H4DirectionEvidence(s1, 4, 2, ev);
   Check(ev.direction == H4_DIR_MIXED && ev.h_cmp == H4_CMP_EQUAL && ev.l_cmp == H4_CMP_EQUAL, "all four equal -> MIXED");
   SH4Swing s2[];
   ArrayResize(s2, 3);
   s2[0] = T2MkSwing(false, 3, 90);  s2[1] = T2MkSwing(true, 6, 110);  s2[2] = T2MkSwing(false, 9, 85);
   H4DirectionEvidence(s2, 3, 2, ev);
   Check(ev.direction == H4_DIR_UNKNOWN && ev.verdict == "only 1 swing high => UNKNOWN", "only 1 swing high => UNKNOWN");
   H4DirectionEvidence(s2, 0, 2, ev);
   Check(ev.direction == H4_DIR_UNKNOWN && ev.verdict == "no swing high and no swing low => UNKNOWN", "no swings => UNKNOWN");

   //--- deterministic random sweep (ties are common): never disagrees with H4DeriveDirection
   long seed = 12345;
   int bad = 0;
   bool seen[4];
   seen[0] = seen[1] = seen[2] = seen[3] = false;
   for(int it = 0; it < 4000; it++)
     {
      seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
      int len = (int)((seed >> 8) % 9);
      SH4Swing rs[];
      ArrayResize(rs, len);
      for(int j = 0; j < len; j++)
        {
         seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
         bool hi = (((seed >> 5) & 1) == 1);
         double pr = 100.0 + (double)((seed >> 9) % 4);
         rs[j] = T2MkSwing(hi, 3 * j, pr);
        }
      H4DirectionEvidence(rs, len, 2, ev);
      if(ev.direction != H4DeriveDirection(rs, len))
         bad++;
      seen[ev.direction] = true;
     }
   Check(bad == 0 && seen[0] && seen[1] && seen[2] && seen[3], "evidence direction == H4DeriveDirection on 4000 random swing lists, all outcomes occur");
  }

void TestHistoricalPure(void)
  {
   Print("--- historical lifecycle helpers");
   datetime w = T2Base() + 1010 * T2_PERIOD;
   datetime a = T2Base() + 999 * T2_PERIOD;
   Check(!H4NewestOk(false, a, w) && H4NewestOk(true, a, w), "live newest==watcher fails for an as-of set; historical accepts it");
   Check(H4NewestOk(true, a, a) && !H4NewestOk(true, w + T2_PERIOD, w) && H4NewestOk(true, a, 0) && H4NewestOk(false, a, 0) &&
         H4NewestOk(false, a, a), "newest-bar test: historical newest <= watcher, unknown watcher accepts");
   Check(H4NewBarForLife(false, true) && !H4NewBarForLife(true, true) && !H4NewBarForLife(false, false) && !H4NewBarForLife(true, false),
         "new_bar reaches the lifecycle only in live mode");
  }

void OnStart(void)
  {
   Print("T002 LOGIC TEST start - proposed H4 model, MQL5 vs Python-model expectations");
   TestGeneratedCases();
   TestMissingInterval();
   TestClassification();
   TestErl();
   TestTieBreak();
   TestNoLookahead("bear_invalid_eq");
   TestNoLookahead("bull_invalid_eq");
   TestNoLookahead("bear_touched_inside_two");
   TestIds();
   TestPureDecisions();
   TestLifecycle();
   TestAsOfFilter();
   TestAsOfNoLookahead();
   TestAsOfPrice();
   TestDirectionEvidence();
   TestHistoricalPure();
   PrintFormat("T002 LOGIC TEST finished: %d passed, %d failed", g_pass, g_fail);
  }
