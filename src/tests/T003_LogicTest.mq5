//+------------------------------------------------------------------+
//|                                          T003_LogicTest.mq5      |
//|                                                                  |
//|  T003 - MT5 script that runs the controlled-data cases of the    |
//|  PROPOSED H4 bias model against src/include/H4Bias.mqh.          |
//|                                                                  |
//|  STATUS: WRITTEN BUT NOT COMPILED AND NOT RUN. MetaEditor was    |
//|  not available. The case data block below is generated from      |
//|  tests/t003_reference_test.py (--emit-mql); the expected         |
//|  transcripts therefore come from the Python MODEL. A PASS in MT5 |
//|  would show that the MQL5 code agrees with that model on these   |
//|  cases; it says nothing about whether the rules are what the     |
//|  client wants. All T003 rules are PROPOSALS.                     |
//|                                                                  |
//|  This is a SCRIPT (OnStart): it belongs under MQL5/Scripts/, NOT |
//|  under Experts. Install: copy the whole repository src/ folder   |
//|  to <terminal data folder>/MQL5/Scripts/velo_src/ so that these  |
//|  paths exist side by side:                                       |
//|    MQL5/Scripts/velo_src/tests/T003_LogicTest.mq5                |
//|    MQL5/Scripts/velo_src/include/H4Bias.mqh                      |
//|    MQL5/Scripts/velo_src/include/H4Structure.mqh                 |
//|  (the include "../include/H4Bias.mqh" is relative to this file). |
//|  Compile it, drag the script on any chart, read the Experts log  |
//|  for "T003 LOGIC TEST". Install layout NOT tested in MT5.        |
//|                                                                  |
//|  Deferred groups are printed as DEFERRED and are NEVER counted   |
//|  as PASS: tests 9, 18, 20, drawing/panel tests, M5/M15.          |
//+------------------------------------------------------------------+
#property copyright "velireci"
#property version   "1.00"
#property script_show_inputs

#include "../include/H4Bias.mqh"

#define T3_PERIOD 14400

int g_pass = 0;
int g_fail = 0;
int g_deferred = 0;

void Check(const bool cond, const string label)
  {
   if(cond)
     {
      g_pass++;
      PrintFormat("  PASS %s", label);
     }
   else
     {
      g_fail++;
      PrintFormat("  FAIL %s", label);
     }
  }

void Deferred(const string label)
  {
   g_deferred++;
   PrintFormat("  DEFERRED (not implemented in this round): %s", label);
  }

datetime T3Base(void) { return(D'2026.01.05 00:00'); }

//--- d holds high,low,close triples; bar i opens at base + (first + i) * 4h
void T3FillBars(const double &d[], const int count, const int first, MqlRates &bars[])
  {
   ArrayResize(bars, count);
   for(int i = 0; i < count; i++)
     {
      bars[i].time  = T3Base() + (datetime)((first + i) * T3_PERIOD);
      bars[i].high  = d[3 * i];
      bars[i].low   = d[3 * i + 1];
      bars[i].close = d[3 * i + 2];
      bars[i].open  = d[3 * i + 2];
     }
  }

//--- like T3FillBars, with explicit open-time slots (4h periods after the base): weekend or
//--- history-gap cases whose bars are not contiguous in time
void T3FillBarsAt(const double &d[], const int count, const int &sl[], MqlRates &bars[])
  {
   ArrayResize(bars, count);
   for(int i = 0; i < count; i++)
     {
      bars[i].time  = T3Base() + (datetime)(sl[i] * T3_PERIOD);
      bars[i].high  = d[3 * i];
      bars[i].low   = d[3 * i + 1];
      bars[i].close = d[3 * i + 2];
      bars[i].open  = d[3 * i + 2];
     }
  }

