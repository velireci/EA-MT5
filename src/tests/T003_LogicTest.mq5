string T3CsvExpectedName(void) { return("velo_t003_diag_XAUUSD.r_202601050400.csv"); }
// END GENERATED CASE DATA

//+------------------------------------------------------------------+
//| helpers                                                          |
//+------------------------------------------------------------------+
void T3Params(const int lookback, const int rebuild, const int hard_cap, SH3Params &p)
  {
   H3ParamsDefault(p);
   p.lookback = lookback;
   p.rebuild  = rebuild;
   p.hard_cap = hard_cap;
  }

int T3FindCase(const string name)
  {
   for(int i = 0; i < T3_CASE_COUNT; i++)
     {
      MqlRates b[];
      int n, kind, lb, rb, cap;
      string nm, ex;
      T3LoadCase(i, b, n, kind, lb, rb, cap, nm, ex);
      if(nm == name)
         return(i);
     }
   return(-1);
  }

//--- load a case by name; returns false if it does not exist
bool T3Get(const string name, MqlRates &bars[], int &n, int &kind, SH3Params &p, string &expected)
  {
   int id = T3FindCase(name);
   if(id < 0)
      return(false);
   int lb, rb, cap;
   string nm;
   T3LoadCase(id, bars, n, kind, lb, rb, cap, nm, expected);
   T3Params(lb, rb, cap, p);
   return(true);
  }

string T3ReplayTextOf(const MqlRates &bars[], const int n, const SH3Params &p)
  {
   SH3Rep rep;
   SH3Track tr[];
   SH3Event ev[];
   string keys[];
   H3Replay(bars, n, p, rep, tr, ev, keys, false);
   return(H3ReplayText(rep, tr, ev));
  }

string T3EvalTextOf(const MqlRates &bars[], const int n, const SH3Params &p)
  {
   SH3Eval e;
   SH3Track tr[];
   SH3Event ev[];
   H3Evaluate(bars, n, p, e, tr, ev);
   return(H3EvalText(e, tr, ev));
  }

//--- kind 2: the diagnostic report of the evaluation (H3Diagnose)
string T3DiagTextOf(const MqlRates &bars[], const int n, const SH3Params &p)
  {
   SH3Eval e;
   SH3Track tr[];
   SH3Event ev[];
   H3Evaluate(bars, n, p, e, tr, ev);
   SH3Diag d;
   H3Diagnose(bars, n, p, e, d);
   return(H3DiagText(d));
  }

//--- the text of any case (replay, evaluation or diagnostics by kind)
string T3CaseText(const MqlRates &bars[], const int n, const int kind, const SH3Params &p)
  {
   if(kind == 0)
      return(T3ReplayTextOf(bars, n, p));
   if(kind == 2)
      return(T3DiagTextOf(bars, n, p));
   return(T3EvalTextOf(bars, n, p));
  }

void T3AddBar(MqlRates &bars[], int &n, const datetime t, const double high, const double low, const double close)
  {
   ArrayResize(bars, n + 1, 64);
   bars[n].time  = t;
   bars[n].high  = high;
   bars[n].low   = low;
   bars[n].close = close;
   bars[n].open  = close;
   n++;
  }

//--- copy src[from..from+count-1] into dst
void T3Slice(const MqlRates &src[], const int from, const int count, MqlRates &dst[])
  {
   ArrayResize(dst, count);
   ArrayCopy(dst, src, 0, from, count);
  }

//--- index of the bar with this open time, or -1
int T3IndexOfTime(const MqlRates &bars[], const int n, const datetime t)
  {
   for(int i = 0; i < n; i++)
     {
      if(bars[i].time == t)
         return(i);
     }
   return(-1);
  }

bool T3Contains(const string text, const string part)
  {
   return(StringFind(text, part) >= 0);
  }

int T3CountEvents(const SH3Event &events[], const int ne, const int type)
  {
   int c = 0;
   for(int i = 0; i < ne; i++)
     {
      if(events[i].type == type)
         c++;
     }
   return(c);
  }

//+------------------------------------------------------------------+
//| 1. every generated case: transcript equality with the model      |
//+------------------------------------------------------------------+
void TestGeneratedCases(void)
  {
   Print("--- generated cases (transcript equality with the Python model)");
   for(int i = 0; i < T3_CASE_COUNT; i++)
     {
      MqlRates bars[];
      int n, kind, lb, rb, cap;
      string name, expected;
      T3LoadCase(i, bars, n, kind, lb, rb, cap, name, expected);
      SH3Params p;
      T3Params(lb, rb, cap, p);
      string got = T3CaseText(bars, n, kind, p);
      bool ok = (got == expected);
      Check(ok, name);
      if(!ok)
        {
         int k = 0;
         int lim = (StringLen(got) < StringLen(expected) ? StringLen(got) : StringLen(expected));
         while(k < lim && StringGetCharacter(got, k) == StringGetCharacter(expected, k))
            k++;
         PrintFormat("    first difference at character %d (got %d chars, expected %d chars)", k, StringLen(got), StringLen(expected));
         Print("    expected: ", StringSubstr(expected, (k > 80 ? k - 80 : 0), 240));
         Print("    got:      ", StringSubstr(got, (k > 80 ? k - 80 : 0), 240));
        }
     }
  }

//+------------------------------------------------------------------+
//| 2. unit tests: P10 resolver, level derivation                    |
//+------------------------------------------------------------------+
SH4Swing T3MkSwing(const bool is_high, const int i, const double price)
  {
   SH4Swing s;
   datetime t = T3Base() + (datetime)((i * 6) * T3_PERIOD);
   s.id = H4TimeStamp(t) + (is_high ? "H" : "L");
   s.is_high = is_high;
   s.index = i * 6;
   s.pivot_time = t;
   s.confirm_time = t + (datetime)(3 * T3_PERIOD);
   s.price = price;
   return(s);
  }

void TestUnits(void)
  {
   Print("--- unit tests (P10 resolver, level derivation)");
   int rd;
   int r1 = H3P10Resolve(1, 1, H3_BEAR, rd);
   Check(r1 == H3_R_CONFLICT && rd == H3_NONE, "CONFLICT is not overwritten by the seed on that bar");
   int r2 = H3P10Resolve(1, 1, H3_NONE, rd);
   Check(r2 == H3_R_CONFLICT, "CONFLICT without a seed");
   int r3 = H3P10Resolve(1, 0, H3_BEAR, rd);
   Check(r3 == H3_R_BREAK && rd == H3_BULL, "a break outranks a seed in the opposite direction");
   int r4 = H3P10Resolve(0, 1, H3_BULL, rd);
   Check(r4 == H3_R_BREAK && rd == H3_BEAR, "a down break outranks a bullish seed");
   int r5 = H3P10Resolve(0, 0, H3_BEAR, rd);
   Check(r5 == H3_R_SEED && rd == H3_BEAR, "the seed applies again on the next bar (no break)");
   int r6 = H3P10Resolve(0, 0, H3_NONE, rd);
   Check(r6 == H3_R_NONE, "no break, no conflict, no seed: NONE");

   SH4Swing a[];
   bool hl, he, hi;
   SH3Cand lv, ex, li;
   ArrayResize(a, 5);
   a[0] = T3MkSwing(false, 0, 95.0);
   a[1] = T3MkSwing(true, 1, 117.0);
   a[2] = T3MkSwing(false, 2, 73.0);
   H3DeriveLevel(a, 3, H3_BEAR, hl, lv, he, ex, hi, li);
   Check(hl && lv.price == 117.0 && !hi, "unit: L0, S, L1 (lower) -> level S");
   a[2] = T3MkSwing(false, 2, 95.0);
   H3DeriveLevel(a, 3, H3_BEAR, hl, lv, he, ex, hi, li);
   Check(!hl, "unit: an equal low is not a lower low (strict) -> undefined");
   a[0] = T3MkSwing(false, 0, 95.0);
   a[1] = T3MkSwing(true, 1, 117.0);
   a[2] = T3MkSwing(true, 2, 117.0);
   a[3] = T3MkSwing(false, 3, 73.0);
   H3DeriveLevel(a, 4, H3_BEAR, hl, lv, he, ex, hi, li);
   Check(hl && lv.pivot_time == T3Base() + (datetime)(6 * T3_PERIOD), "unit: equal highs -> the earliest one is the level (AMBIGUITY 11)");
   a[0] = T3MkSwing(false, 0, 95.0);
   a[1] = T3MkSwing(true, 1, 117.0);
   a[2] = T3MkSwing(false, 2, 73.0);
   a[3] = T3MkSwing(true, 3, 100.0);
   a[4] = T3MkSwing(false, 4, 80.0);
   H3DeriveLevel(a, 5, H3_BEAR, hl, lv, he, ex, hi, li);
   Check(hl && lv.price == 117.0 && hi && li.price == 100.0, "unit: latest LL stays L1; the corrective high is the interior level");
   H3DeriveLevel(a, 2, H3_BEAR, hl, lv, he, ex, hi, li);
   Check(!hl && !he, "unit: a single low -> no lower low -> no level and no LL candidate");
   a[0] = T3MkSwing(true, 0, 100.0);
   a[1] = T3MkSwing(false, 1, 80.0);
   a[2] = T3MkSwing(true, 2, 110.0);
   H3DeriveLevel(a, 3, H3_BULL, hl, lv, he, ex, hi, li);
   Check(hl && lv.price == 80.0, "unit: bullish mirror (HH, lowest low between)");
   //--- identities are built from times only
   datetime t1 = T3Base();
   Check(H3LevelId("SH", t1, t1 + (datetime)T3_PERIOD, t1 + (datetime)(2 * T3_PERIOD)) == "SH202601050000_202601050400_202601050800" &&
         H3ExtId("HH", t1, t1 + (datetime)T3_PERIOD) == "HH202601050000_202601050400" &&
         H3EventId(H3_EV_WICK, t1, "SHx") == "WICK@202601050000#SHx", "identity strings are built from absolute time stamps");
  }

//+------------------------------------------------------------------+
//| 8. no look-ahead (as-of results, garbage after T, prefix = full) |
//+------------------------------------------------------------------+
void TestNoLookahead(void)
  {
   Print("--- 8. historical analysis: no look-ahead");
   string names[] = {"a_wick_then_break", "b2_active_retro", "b2_none_touched", "w_a_is_wick", "c_history",
                     "e_sweep_fvg_touch", "s_sweep_fvg_touch", "w_invalid_after_reconf", "m_w_break_in_reconf",
                     "r10_flip", "r10_retouch", "r10_sweep"};
   int total = 0;
   bool ok_garbage = true;
   bool ok_prefix = true;
   bool ok_keys = true;
   for(int ci = 0; ci < ArraySize(names); ci++)
     {
      MqlRates bars[];
      int n, kind;
      SH3Params p;
      string ex;
      if(!T3Get(names[ci], bars, n, kind, p, ex))
        {
         ok_garbage = false;
         continue;
        }
      SH3Rep full;
      SH3Track ftr[];
      SH3Event fev[];
      string fkeys[];
      H3Replay(bars, n, p, full, ftr, fev, fkeys, true);
      for(int toff = 6; toff <= n * 2; toff++)
        {
         datetime asof = bars[0].time + (datetime)(((long)toff * T3_PERIOD) / 2);
         int cnt = H4ClosedCountAsOf(bars, n, asof, T3_PERIOD);
         if(cnt < 6)
            continue;
         MqlRates garbage[];
         ArrayResize(garbage, n);
         for(int i = 0; i < n; i++)
           {
            if(i < cnt)
              {
               garbage[i] = bars[i];
              }
            else
              {
               garbage[i].time  = bars[i].time;
               garbage[i].high  = 9000.0 + i;
               garbage[i].low   = 8000.0 - i;
               garbage[i].close = 8500.0 + (i % 7);
               garbage[i].open  = garbage[i].close;
              }
           }
         int cnt_g = H4ClosedCountAsOf(garbage, n, asof, T3_PERIOD);
         SH3Rep a;
         SH3Rep g;
         SH3Track atr[];
         SH3Track gtr[];
         SH3Event aev[];
         SH3Event gev[];
         string akeys[];
         string gkeys[];
         H3Replay(bars, cnt, p, a, atr, aev, akeys, false);
         H3Replay(garbage, cnt_g, p, g, gtr, gev, gkeys, false);
         if(cnt_g != cnt || H3ReplayText(a, atr, aev) != H3ReplayText(g, gtr, gev))
            ok_garbage = false;
         //--- prefix events equal the full replay restricted to what was knowable at T
         string fe = "";
         int nfe = 0;
         for(int e = 0; e < full.ne; e++)
           {
            if((long)fev[e].bar_time + T3_PERIOD <= (long)asof)
              {
               fe += (nfe > 0 ? "|" : "") + H3EventText(fev[e]);
               nfe++;
              }
           }
         string pe = "";
         for(int q = 0; q < a.ne; q++)
            pe += (q > 0 ? "|" : "") + H3EventText(aev[q]);
         if(fe != pe)
            ok_prefix = false;
         if(fkeys[cnt - 1] != H3StateKey(a.st, atr, a.nt))
            ok_keys = false;
         total++;
        }
     }
   Check(total > 200 && ok_garbage, "as-of results identical when later bars are replaced by garbage (" + IntegerToString(total) + " as-of times)");
   Check(ok_prefix, "events of a prefix replay equal the full replay restricted to what was knowable at T");
   Check(ok_keys, "the machine state at T of the full replay equals the state of the prefix replay");
  }

//+------------------------------------------------------------------+
//| 10. BUY mirror: structural equality of mirrored controlled series |
//+------------------------------------------------------------------+
void TestMirror(void)
  {
   Print("--- 10. BUY mirror (one symmetric implementation)");
   int pairs = 0;
   int bad = 0;
   for(int i = 0; i < T3_CASE_COUNT; i++)
     {
      MqlRates b[];
      int n, kind, lb, rb, cap;
      string nm, ex;
      T3LoadCase(i, b, n, kind, lb, rb, cap, nm, ex);
      if(kind != 0 || StringSubstr(nm, 0, 2) == "m_")
         continue;
      MqlRates mb[];
      int mn, mkind;
      SH3Params mp;
      string mex;
      if(!T3Get("m_" + nm, mb, mn, mkind, mp, mex))
         continue;
      SH3Params p;
      T3Params(lb, rb, cap, p);
      SH3Rep ra;
      SH3Rep rm;
      SH3Track ta[];
      SH3Track tm[];
      SH3Event ea[];
      SH3Event em[];
      string ka[];
      string km[];
      H3Replay(b, n, p, ra, ta, ea, ka, false);
      H3Replay(mb, mn, mp, rm, tm, em, km, false);
      bool same = (ra.ne == rm.ne && ra.nt == rm.nt && ra.st.dir == -rm.st.dir && ra.st.phase == rm.st.phase &&
                   ra.st.origin == rm.st.origin && ra.st.has_level == rm.st.has_level && ra.st.frozen == rm.st.frozen &&
                   ra.st.wk_src == rm.st.wk_src && ra.st.wk_det == rm.st.wk_det && ra.st.wk_retro == rm.st.wk_retro &&
                   ra.st.sweep_time == rm.st.sweep_time && ra.st.recon_reason == rm.st.recon_reason &&
                   (ra.st.rec_id == "") == (rm.st.rec_id == ""));
      for(int e = 0; e < ra.ne && same; e++)
        {
         if(ea[e].type != em[e].type || ea[e].bar_time != em[e].bar_time)
            same = false;
        }
      for(int k = 0; k < ra.nt && same; k++)
        {
         if(ta[k].invalid != tm[k].invalid || ta[k].recorded != tm[k].recorded)
            same = false;
        }
      if(ra.st.has_level && rm.st.has_level && ra.st.lv_pivot != rm.st.lv_pivot)
         same = false;
      pairs++;
      if(!same)
        {
         bad++;
         Print("    mirror mismatch: ", nm);
        }
     }
   Check(pairs >= 25 && bad == 0, "BUY results mirror SELL results on " + IntegerToString(pairs) + " mirrored controlled series");
  }

//+------------------------------------------------------------------+
//| invariants over every replay case (13, 19)                       |
//+------------------------------------------------------------------+
void TestInvariants(void)
  {
   Print("--- invariants over all replay cases");
   int bad_first = 0;
   int bad_internal = 0;
   int checked = 0;
   for(int i = 0; i < T3_CASE_COUNT; i++)
     {
      MqlRates b[];
      int n, kind, lb, rb, cap;
      string nm, ex;
      T3LoadCase(i, b, n, kind, lb, rb, cap, nm, ex);
      if(kind != 0)
         continue;
      SH3Params p;
      T3Params(lb, rb, cap, p);
      SH3Rep r;
      SH3Track tr[];
      SH3Event ev[];
      string keys[];
      H3Replay(b, n, p, r, tr, ev, keys, true);
      int starts = 0;
      int first_bias = r.ne;
      for(int e = 0; e < r.ne; e++)
        {
         if(ev[e].type == H3_EV_BREAK_SET || ev[e].type == H3_EV_SEED)
           {
            starts++;
            if(first_bias == r.ne)
               first_bias = e;
           }
        }
      bool pre = false;
      for(int q = 0; q < first_bias; q++)
        {
         if(ev[q].market)
            pre = true;
        }
      if(starts > 1 || pre)
         bad_first++;
      for(int w = 0; w < r.ne; w++)
        {
         if(ev[w].type == H3_EV_INT_SWEEP || ev[w].type == H3_EV_INT_BREAK)
           {
            int idx = T3IndexOfTime(b, n, ev[w].bar_time);
            if(idx < 1 || T3Contains(keys[idx - 1], ";LV=-;"))
               bad_internal++;
           }
        }
      checked++;
     }
   Check(checked > 60 && bad_first == 0, "BREAK_SET/SEED at most once, first, only from NONE; no flip/wick before a bias exists");
   Check(bad_internal == 0, "every INTERNAL_SWEEP / INTERNAL_BREAK was raised with a defined protecting level");
  }

//+------------------------------------------------------------------+
//| technical requirement (a): IDs are absolute and window-stable    |
//+------------------------------------------------------------------+
void TestIds(void)
  {
   Print("--- technical requirement (a): identities use absolute times, stable under window shifts");
   //--- format: only letters, digits, '_', '+', '@', '#' and 12-digit time stamps
   int bad = 0;
   for(int i = 0; i < T3_CASE_COUNT; i++)
     {
      MqlRates b[];
      int n, kind, lb, rb, cap;
      string nm, ex;
      T3LoadCase(i, b, n, kind, lb, rb, cap, nm, ex);
      if(kind != 0)
         continue;
      SH3Params p;
      T3Params(lb, rb, cap, p);
      SH3Rep r;
      SH3Track tr[];
      SH3Event ev[];
      string keys[];
      H3Replay(b, n, p, r, tr, ev, keys, false);
      for(int e = 0; e < r.ne; e++)
        {
         string id = H3EventId(ev[e].type, ev[e].bar_time, ev[e].ref);
         int at = StringFind(id, "@");
         if(at <= 0 || StringFind(id, "#") != at + 13)
            bad++;
         if(StringLen(ev[e].ref) < 14)
            bad++;
        }
     }
   Check(bad == 0, "event IDs are type@12-digit time#reference");
   string names[] = {"w_a_is_wick", "b2_none_touched", "e_sweep_fvg_touch", "c_history", "b2_active_retro", "m_w_a_is_wick"};
   int shifts[6][4] = {{1, 2, 3, 5}, {1, 2, 4, 0}, {1, 3, 6, 0}, {1, 2, 3, 0}, {1, 2, 3, 5}, {1, 2, 3, 0}};
   int common_total = 0;
   bool stable = true;
   for(int c = 0; c < 6; c++)
     {
      MqlRates b[];
      int n, kind;
      SH3Params p;
      string ex;
      if(!T3Get(names[c], b, n, kind, p, ex))
        {
         stable = false;
         continue;
        }
      SH3Rep full;
      SH3Track ftr[];
      SH3Event fev[];
      string fk[];
      H3Replay(b, n, p, full, ftr, fev, fk, false);
      for(int s = 0; s < 4; s++)
        {
         int sft = shifts[c][s];
         if(sft == 0)
            continue;
         MqlRates sb[];
         T3Slice(b, sft, n - sft, sb);
         SH3Rep sh;
         SH3Track str[];
         SH3Event sev[];
         string sk[];
         H3Replay(sb, n - sft, p, sh, str, sev, sk, false);
         for(int e = 0; e < sh.ne; e++)
           {
            for(int f = 0; f < full.ne; f++)
              {
               if(fev[f].type == sev[e].type && fev[f].bar_time == sev[e].bar_time)
                 {
                  common_total++;
                  if(H3EventId(fev[f].type, fev[f].bar_time, fev[f].ref) != H3EventId(sev[e].type, sev[e].bar_time, sev[e].ref))
                     stable = false;
                 }
              }
           }
         if(sh.st.has_level && full.st.has_level && sh.st.lv_price == full.st.lv_price && sh.st.lv_id != full.st.lv_id)
            stable = false;
         for(int k = 0; k < sh.nt; k++)
           {
            bool found = false;
            for(int m = 0; m < full.nt; m++)
              {
               if(ftr[m].id == str[k].id)
                  found = true;
              }
            if(!found && full.st.phase == sh.st.phase)
               stable = false;
           }
        }
     }
   Check(common_total >= 10 && stable, "the same event/level/FVG keeps the same ID when the window start moves (" + IntegerToString(common_total) + " common events compared)");
  }

//+------------------------------------------------------------------+
//| 15. determinism and restart                                      |
//+------------------------------------------------------------------+
void TestDeterminism(void)
  {
   Print("--- 15. determinism and restart (no stored state)");
   bool ok = true;
   for(int i = 0; i < T3_CASE_COUNT; i++)
     {
      MqlRates b[];
      int n, kind, lb, rb, cap;
      string nm, ex;
      T3LoadCase(i, b, n, kind, lb, rb, cap, nm, ex);
      SH3Params p;
      T3Params(lb, rb, cap, p);
      MqlRates copy[];
      T3Slice(b, 0, ArraySize(b), copy);
      if(T3CaseText(b, n, kind, p) != T3CaseText(copy, n, kind, p))
         ok = false;
     }
   Check(ok, "the same bars always give the same state, events and flag");
   MqlRates b[];
   int n, kind;
   SH3Params p;
   string ex;
   T3Get("p16a_converged_break", b, n, kind, p, ex);
   string first = T3EvalTextOf(b, n, p);
   string dummy = T3EvalTextOf(b, 50, p);
   dummy = T3EvalTextOf(b, 61, p);
   string second = T3EvalTextOf(b, n, p);
   Check(first == second, "a restart (other evaluations in between) rebuilds the same state: nothing is kept between calls");
  }

//+------------------------------------------------------------------+
//| 16/17 depth-sensitivity check and window behaviour               |
//+------------------------------------------------------------------+
void TestDepth(void)
  {
   Print("--- 16/17. depth-sensitivity check and window behaviour");
   MqlRates b[];
   int n, kind;
   SH3Params p;
   string ex;
   SH3Eval e;
   SH3Track tr[];
   SH3Event ev[];
   T3Get("p16a_converged_break", b, n, kind, p, ex);
   H3Evaluate(b, n, p, e, tr, ev);
   Check(e.reliable && e.flag == H3_FLAG_CONVERGED && T3Contains(e.reason, "converged at depth 64 vs 44") && H3ReportedDirection(e) == "BULL",
         "a: A and B agree: CONVERGED, text says \"converged at depth 64 vs 44\"");
   Check(e.r_eff == 64 && e.b_depth == 44 && e.warm == 20 && e.chk == 20 && e.r_req == 64,
         "a: the depths used are reported (request, effective, B depth, warm-up, check depth)");
   T3Get("p16a_converged_seed", b, n, kind, p, ex);
   H3Evaluate(b, n, p, e, tr, ev);
   Check(e.reliable && e.flag == H3_FLAG_SEEDED && e.st.origin == H3_ORG_SEED, "a: origin SEED_SWINGS gives SEEDED (weaker)");
   //--- extra older quiet bars leave the final state and events identical
   bool same = true;
   string bn[] = {"p16a_converged_break", "p16a_converged_seed"};
   int ms[] = {0, 7, 19, 33};
   for(int c = 0; c < 2; c++)
     {
      T3Get(bn[c], b, n, kind, p, ex);
      SH3Params pl;
      T3Params(20, 1000, 5000, pl);
      SH3Eval base;
      SH3Track btr[];
      SH3Event bev[];
      H3Evaluate(b, n, pl, base, btr, bev);
      string base_ev = H3EventsText(bev, base.ne, 0);
      for(int mi = 0; mi < 4; mi++)
        {
         int m = ms[mi];
         MqlRates all[];
         int na = 0;
         ArrayResize(all, 0);
         for(int i = 0; i < m; i++)
           {
            int cc = 100 + (i % 2 == 0 ? 4 : 0);
            T3AddBar(all, na, b[0].time - (datetime)((m - i) * T3_PERIOD), cc + 5.0, cc - 5.0, (double)cc);
           }
         for(int j = 0; j < n; j++)
            T3AddBar(all, na, b[j].time, b[j].high, b[j].low, b[j].close);
         SH3Eval x;
         SH3Track xtr[];
         SH3Event xev[];
         H3Evaluate(all, na, pl, x, xtr, xev);
         if(!(x.reliable && x.key == base.key && H3EventsText(xev, x.ne, 0) == base_ev))
            same = false;
        }
     }
   Check(same, "a: extra older (quiet) bars added in a property test leave the final state and events identical");
   //--- b: REWRITTEN in revision 10 (the old check relied on the frozen HOLD of revisions 6-7). p16b_ab_difference is an
   //--- older bias (A: started by a BREAK) next to a window that starts later and SEEDS the same direction: with the
   //--- structure not frozen both replays reach the SAME level, setup and candidates; only the origin NAME differs
   //--- (provenance). It is the POSITIVE control R19, compared at replay level from the bar after B's own start event.
   T3Get("p16b_ab_difference", b, n, kind, p, ex);
   SH3Rep ra;
   SH3Rep rb2;
   SH3Track ta[];
   SH3Track tb[];
   SH3Event ea[];
   SH3Event eb[];
   string ka[];
   string kb[];
   MqlRates bb[];
   H3Replay(b, n, p, ra, ta, ea, ka, false);
   T3Slice(b, 20, n - 20, bb);
   H3Replay(bb, n - 20, p, rb2, tb, eb, kb, false);
   int seed_ix = -1;
   for(int xs = 0; xs < rb2.ne; xs++)
     {
      if(eb[xs].type == H3_EV_SEED && seed_ix < 0)
         seed_ix = xs;
     }
   string org_note;
   string why19 = H3AbCompare(ra, ta, ea, rb2, tb, eb, eb[seed_ix].bar_time + (datetime)T3_PERIOD, (datetime)4000000000, 0, "", org_note);
   Check(why19 == "" && org_note == "ORG_DIFF A=BREAK B=SEED",
         "R19: origin differs only by NAME (A BREAK, B SEED), same level, setup, candidates and events afterwards: no AB_* reason, ORG_DIFF reported");
   Check(H3StateKey(ra.st, ta, ra.nt) == H3StateKey(rb2.st, tb, rb2.nt) && ra.st.origin != rb2.st.origin && ra.st.dir == rb2.st.dir,
         "R19: the compared keys of A and B are equal although the origin name differs");
   //--- the SC-1 type negative control (must stay LIMITED)
   T3Get("sc1_limited", b, n, kind, p, ex);
   H3Evaluate(b, n, p, e, tr, ev);
   string txt = H3EvalText(e, tr, ev);
   H3Replay(b, n, p, ra, ta, ea, ka, false);
   T3Slice(b, n - e.b_depth, e.b_depth, bb);
   H3Replay(bb, e.b_depth, p, rb2, tb, eb, kb, false);
   Check(!e.reliable && e.flag == H3_FLAG_LIMITED && H3ReportedDirection(e) == "UNKNOWN" && T3Contains(e.reason, "AB_STRUCTURE_DIFF") &&
         T3Contains(e.reason, "AB_SETUP_DIFF") && e.ne == 0,
         "b (SC-1 negative control): wick above the level, decline, rebuilt HH/HL, all closes below: LIMITED_BY_HISTORY with AB_STRUCTURE_DIFF (not made to converge), direction UNKNOWN, no market event");
   Check(ra.st.dir == H3_BEAR && ra.st.phase == H3_PH_HOLD && rb2.st.dir == H3_BULL, "b: the replays really disagree (A BEAR/HOLD, B BULL)");
   Check(!T3Contains(txt, ";ST=") && !T3Contains(txt, ";EV=") && T3Contains(txt, ";DIAG="),
         "b: the report asserts no state and no event, only a diagnostic");
   //--- c: anchor in the warm-up
   T3Get("p16c_anchor_warmup", b, n, kind, p, ex);
   H3Evaluate(b, n, p, e, tr, ev);
   H3Replay(b, n, p, ra, ta, ea, ka, false);
   T3Slice(b, 20, n - 20, bb);
   H3Replay(bb, n - 20, p, rb2, tb, eb, kb, false);
   Check(!e.reliable && e.reason == "ANCHOR_IN_WARMUP" && H3StateKey(ra.st, ta, ra.nt) == H3StateKey(rb2.st, tb, rb2.nt),
         "c: the anchor lies in the warm-up: LIMITED although A and B agree");
   //--- e: same final state, different event inside B's trusted region
   T3Get("p16e_event_only_diff", b, n, kind, p, ex);
   H3Evaluate(b, n, p, e, tr, ev);
   H3Replay(b, n, p, ra, ta, ea, ka, false);
   T3Slice(b, e.chk, n - e.chk, bb);
   H3Replay(bb, n - e.chk, p, rb2, tb, eb, kb, false);
   bool fa_flip = false;
   bool fb_break = false;
   bool fb_flip = false;
   for(int x1 = 0; x1 < ra.ne; x1++)
     {
      if(ea[x1].bar_time >= e.trusted_from && ea[x1].type == H3_EV_FLIP)
         fa_flip = true;
     }
   for(int x2 = 0; x2 < rb2.ne; x2++)
     {
      if(eb[x2].bar_time >= e.trusted_from && eb[x2].type == H3_EV_BREAK_SET)
         fb_break = true;
      if(eb[x2].bar_time >= e.trusted_from && eb[x2].type == H3_EV_FLIP)
         fb_flip = true;
     }
   Check(!e.reliable && e.reason == "AB_EVENT_DIFF" && H3StateKey(ra.st, ta, ra.nt) == H3StateKey(rb2.st, tb, rb2.nt) && fa_flip && fb_break && !fb_flip,
         "e: same final state but A flips (older bias) where B starts from NONE (BREAK_SET): LIMITED on the event difference alone");
   //--- d: documented limitation
   SH3Eval e60;
   SH3Eval e140;
   T3Get("p16d_limit_r60", b, n, kind, p, ex);
   H3Evaluate(b, n, p, e60, tr, ev);
   SH3Params p140;
   T3Params(20, 140, 5000, p140);
   H3Evaluate(b, n, p140, e140, tr, ev);
   Check(e60.reliable && e60.flag == H3_FLAG_SEEDED && e60.reason == "converged at depth 60 vs 40" && H3ReportedDirection(e60) == "BEAR",
         "d: documented limitation: at depth 60 the state is reliable (\"converged at depth 60 vs 40\")");
   Check(e140.key != e60.key && e140.st.dir == H3_BULL,
         "d: more history (depth 140) gives a different state: the older difference is undetectable at depth 60 (LIMIT recorded, not detected)");
   //--- wording
   bool words = true;
   bool forms = true;
   for(int i = 0; i < T3_CASE_COUNT; i++)
     {
      MqlRates cb[];
      int cn, ck, lb, rb, cap;
      string nm, cex;
      T3LoadCase(i, cb, cn, ck, lb, rb, cap, nm, cex);
      if(ck != 1)
         continue;
      SH3Params cp;
      T3Params(lb, rb, cap, cp);
      string t_ = T3EvalTextOf(cb, cn, cp);
      if(T3Contains(t_, "unchanged") || T3Contains(t_, "additional history") || T3Contains(t_, "more history"))
         words = false;
      if(!(T3Contains(t_, "converged at depth") || T3Contains(t_, "FLAG=LIMITED_BY_HISTORY")))
         forms = false;
     }
   Check(words, "no report text claims the state is unchanged by more/additional history");
   Check(forms, "every flag text is \"converged at depth X vs Y\" or LIMITED_BY_HISTORY");
   //--- 17: reduced depth, failed copy, hard cap, defaults
   T3Get("p17_reduced_depth", b, n, kind, p, ex);
   H3Evaluate(b, 50, p, e, tr, ev);
   Check(e.flag == H3_FLAG_LIMITED && e.reason == "SHORT_HISTORY" && T3Contains(e.note, "reduced depth 50 of 60") && H3ReportedDirection(e) == "UNKNOWN" && e.ne == 0,
         "depth below 3*L: \"reduced depth 50 of 60\", LIMITED, UNKNOWN, no event");
   T3Get("p17_reduced_depth_ok", b, n, kind, p, ex);
   H3Evaluate(b, n, p, e, tr, ev);
   Check(e.reliable && T3Contains(e.note, "reduced depth 64 of 200"), "depth below R but at least 3*L: evaluated, \"reduced depth 64 of 200\" logged");
   SH3Event none[];
   int nn;
   H3Evaluate(b, 0, p, e, tr, ev);
   Check(!e.has_state && e.ne == 0 && e.reason == "NO_BARS" && H3ConsumeNew(e, ev, 0, T3_PERIOD, none, nn) == H3_C_NOT_RELIABLE,
         "a failed/empty copy: no state, no event");
   T3Get("p17_hard_cap", b, n, kind, p, ex);
   H3Evaluate(b, n, p, e, tr, ev);
   Check(e.r_eff == 61 && T3Contains(e.note, "clamped to HARD_CAP 61"), "a request above HARD_CAP is clamped and logged");
   SH3Params pd;
   H3ParamsDefault(pd);
   Check(pd.rebuild == 1000 && pd.hard_cap == 5000 && pd.lookback == 300 && H3WarmUp(pd) == 300 && H3CheckDepth(pd) == 300,
         "defaults: R 1000, HARD_CAP 5000, L 300, warm-up = check depth = L");
  }

//+------------------------------------------------------------------+
//| 16 (units): A/B comparison and previous-state rule, pure         |
//+------------------------------------------------------------------+
void TestAbUnits(void)
  {
   Print("--- 16 (units). A/B comparison and previous-state rule as pure functions");
   //--- REWRITTEN in revision 10: H3AbReasons takes the STRUCTURE keys, the SETUP keys and the event signatures separately
   Check(H3AbReasons("S", "S", "U", "U", "E1", "E1", H3_BULL, 100, 50, "") == "", "agreement on structure, setup, events and anchor: reliable");
   Check(H3AbReasons("S", "S", "U", "U", "E1", "E2", H3_BULL, 100, 50, "") == "AB_EVENT_DIFF", "same state, an event differs inside B's trusted region: LIMITED (event reason only)");
   Check(H3AbReasons("S1", "S2", "U", "U", "E", "E", H3_BULL, 100, 50, "") == "AB_STRUCTURE_DIFF", "a different STRUCTURE: LIMITED (structure reason only; the setup comparison is not hidden)");
   Check(H3AbReasons("S", "S", "U1", "U2", "E", "E", H3_BULL, 100, 50, "") == "AB_SETUP_DIFF", "a different SETUP: LIMITED (setup reason only)");
   Check(H3AbReasons("S1", "S2", "U1", "U2", "E", "E", H3_BULL, 100, 50, "") == "AB_STRUCTURE_DIFF+AB_SETUP_DIFF", "both differ: both reasons are reported");
   Check(H3AbReasons("S", "S", "U", "U", "E", "E", H3_BULL, 40, 50, "") == "ANCHOR_IN_WARMUP", "the anchor before A's warm-up end: LIMITED (anchor reason only)");
   Check(H3AbReasons("S", "S", "U", "U", "E", "E", H3_NONE, 0, 50, "") == "", "NONE has no anchor: the anchor rule does not apply");
   Check(H3AbReasons("S1", "S2", "U1", "U2", "E1", "E2", H3_BEAR, 10, 50, "") == "AB_STRUCTURE_DIFF+AB_SETUP_DIFF+AB_EVENT_DIFF+ANCHOR_IN_WARMUP", "reasons are combined in a fixed order");
   SH3Event ea[];
   SH3Event eb[];
   int na = 0;
   int nb = 0;
   H3AddEvent(ea, na, H3_EV_WICK, 1000, "L", "x");
   H3AddEvent(ea, na, H3_EV_FLIP, 5000, "L", "y");
   H3AddEvent(eb, nb, H3_EV_FLIP, 5000, "L", "y");
   Check(H3EventsSigText(ea, na, 4000) == H3EventsSigText(eb, nb, 4000) && H3EventsSigText(ea, na, 0) != H3EventsSigText(eb, nb, 0),
         "events older than B's trusted region are ignored by the comparison");
   Check(H3ConsumerPrevOk(true, true, "K", "K") && !H3ConsumerPrevOk(true, false, "K", "K") && !H3ConsumerPrevOk(false, true, "K", "K") &&
         !H3ConsumerPrevOk(true, true, "K", "J"), "the state before the bar counts only if RELIABLE and reproduced by the current window");
   SH3State st;
   H3StateInit(st);
   st.src_time = 1000;
   SH4Fvg f;
   f.bullish = true;
   f.time_a = 1000;
   bool ok1 = H3FvgEligible(f, st, true);
   f.time_a = 999;
   bool ok2 = H3FvgEligible(f, st, true);
   f.time_a = 1000;
   bool ok3 = H3FvgEligible(f, st, false);
   Check(ok1 && !ok2 && !ok3, "eligibility: A at the source time qualifies, A one bar earlier or the wrong type does not");
  }

//+------------------------------------------------------------------+
//| 17 sliding, first reliable evaluation, invariants                |
//+------------------------------------------------------------------+
void T3QuietExtend(MqlRates &all[], int &na, const int count, const int centre)
  {
   for(int i = 0; i < count; i++)
     {
      int cc = centre + (i % 2 == 0 ? 4 : 0);
      T3AddBar(all, na, all[na - 1].time + (datetime)T3_PERIOD, cc + 5.0, cc - 5.0, (double)cc);
     }
  }

void TestSliding(void)
  {
   Print("--- 17. sliding window, first reliable evaluation, event discipline");
   MqlRates b[];
   int n, kind;
   SH3Params p;
   string ex;
   T3Get("p17_reduced_depth_ok", b, n, kind, p, ex);
   MqlRates all[];
   int na = 0;
   for(int i = 0; i < n; i++)
      T3AddBar(all, na, b[i].time, b[i].high, b[i].low, b[i].close);
   T3QuietExtend(all, na, 12, 134);
   SH3Params pl;
   T3Params(20, 64, 5000, pl);
   bool stable = true;
   bool quiet_nothing = true;
   SH3Eval e;
   SH3Track tr[];
   SH3Event ev[];
   SH3Event out[];
   int nout;
   for(int m = 64; m < 70; m++)
     {
      H3EvaluateLatest(all, m, pl, e, tr, ev);
      if(!(e.reliable && e.prev_ok && e.cause == ""))
         stable = false;
      int st = H3ConsumeNew(e, ev, all[m - 2].time, T3_PERIOD, out, nout);
      if(st != H3_C_OK || nout != 0)
         quiet_nothing = false;
     }
   Check(stable && quiet_nothing, "sliding by one bar keeps the final state of a converged window (no re-derivation, no event)");
   bool late_ok = true;
   for(int m2 = 70; m2 <= na; m2++)
     {
      H3EvaluateLatest(all, m2, pl, e, tr, ev);
      if(m2 == 70 && !(e.cause == "REDERIVATION:LIMITED_ENTER" && !e.reliable))
         late_ok = false;
      if(e.reliable)
         late_ok = false;
      H3ConsumeNew(e, ev, all[0].time, T3_PERIOD, out, nout);
      if(nout != 0)
         late_ok = false;
     }
   Check(late_ok, "a state that depends on bars leaving the window becomes LIMITED (a RE-DERIVATION), never an event");
   //--- first reliable evaluation: the event of that bar must not be emitted
   T3Get("p17_first_event_n60", b, n, kind, p, ex);
   H3EvaluateLatest(b, 60, p, e, tr, ev);
   int st2 = H3ConsumeNew(e, ev, b[58].time, T3_PERIOD, out, nout);
   Check(e.reliable && T3CountEvents(ev, e.ne, H3_EV_BREAK_SET) == 1 && e.cause == "REDERIVATION:LIMITED_EXIT" && st2 == H3_C_REDERIVED && nout == 0,
         "the state before the bar is LIMITED (59 < 3L): the BREAK_SET of the 60th bar is a RE-DERIVATION, not an event");
   MqlRates b61[];
   int n61 = 0;
   for(int i2 = 0; i2 < 60; i2++)
      T3AddBar(b61, n61, b[i2].time, b[i2].high, b[i2].low, b[i2].close);
   T3AddBar(b61, n61, b[59].time + (datetime)T3_PERIOD, 125.0, 115.0, 120.0);
   H3EvaluateLatest(b61, 61, p, e, tr, ev);
   int st3 = H3ConsumeNew(e, ev, b[59].time, T3_PERIOD, out, nout);
   Check(e.reliable && e.prev_ok && e.cause == "" && st3 == H3_C_OK && nout == 0, "one bar later both states are reliable: no event for a quiet bar");
   //--- the window slides past a structure: the SEED is emitted once, the departure is a re-derivation
   T3Get("p16d_limit_r60", b, n, kind, p, ex);
   MqlRates ext[];
   int ne2 = 0;
   for(int i3 = 0; i3 < n; i3++)
      T3AddBar(ext, ne2, b[i3].time, b[i3].high, b[i3].low, b[i3].close);
   T3QuietExtend(ext, ne2, 80, 125);
   SH3Params p60;
   T3Params(20, 60, 5000, p60);
   int seeds = 0;
   int slid = 0;
   int leak = 0;
   for(int m3 = 100; m3 <= ne2; m3++)
     {
      H3EvaluateLatest(ext, m3, p60, e, tr, ev);
      int sx = H3ConsumeNew(e, ev, ext[m3 - 2].time, T3_PERIOD, out, nout);
      if(sx == H3_C_OK)
         seeds += T3CountEvents(out, nout, H3_EV_SEED);
      if(StringSubstr(e.cause, 0, 12) == "REDERIVATION")
        {
         slid++;
         if(nout > 0)
            leak++;
        }
     }
   Check(seeds == 1, "the SEED of the structure is emitted exactly once while the window moves over it");
   Check(slid >= 1 && leak == 0, "when the structure leaves the window the change is a RE-DERIVATION (" + IntegerToString(slid) + " times) and no event leaks through it");
   //--- events only when both states are reliable and A/B agree
   int viol = 0;
   SH3Params pinv;
   T3Params(20, 60, 5000, pinv);
   string nm4[] = {"p16a_converged_break", "p16a_converged_seed", "p16b_ab_difference", "p16c_anchor_warmup"};
   for(int c = 0; c < 4; c++)
     {
      T3Get(nm4[c], b, n, kind, p, ex);
      for(int m4 = 61; m4 <= n; m4++)
        {
         H3EvaluateLatest(b, m4, pinv, e, tr, ev);
         H3ConsumeNew(e, ev, b[m4 - 2].time, T3_PERIOD, out, nout);
         if(nout > 0 && !(e.reliable && e.prev_ok))
            viol++;
        }
     }
   Check(viol == 0, "events are consumed only when the state before and after the bar are RELIABLE and A/B agree");
  }

//+------------------------------------------------------------------+
//| technical requirement (b): history versus new events             |
//+------------------------------------------------------------------+
void TestConsumer(void)
  {
   Print("--- technical requirement (b): history of events versus new events for the consumer");
   MqlRates base[];
   int nb, kind;
   SH3Params p;
   string ex;
   T3Get("p16a_converged_break", base, nb, kind, p, ex);
   SH3Params pc;
   T3Params(20, 1000, 5000, pc);
   SH3Eval e0;
   SH3Eval e1;
   SH3Eval e2;
   SH3Eval e3;
   SH3Eval el;
   SH3Track tr[];
   SH3Event ev0[];
   SH3Event ev1[];
   SH3Event ev2[];
   SH3Event ev3[];
   SH3Event evl[];
   SH3Event out[];
   int nout;
   H3EvaluateLatest(base, nb, pc, e0, tr, ev0);
   datetime cur = H3BaselineCursor(e0);
   Check(e0.reliable && e0.ne >= 2 && cur == base[nb - 1].time, "the replay carries the full event log (history) with absolute bar times");
   int s = H3ConsumeNew(e0, ev0, cur, T3_PERIOD, out, nout);
   Check(s == H3_C_NOTHING_NEW && nout == 0, "init/restart: the cursor is set to the last closed bar, no historical event is re-emitted");
   s = H3ConsumeNew(e0, ev0, 0, T3_PERIOD, out, nout);
   Check(s == H3_C_GAP && nout == 0, "an uninitialised cursor emits nothing (it must be baselined first)");
   H3EvaluateLatest(base, nb, pc, e0, tr, ev0);
   s = H3ConsumeNew(e0, ev0, cur, T3_PERIOD, out, nout);
   Check(s == H3_C_NOTHING_NEW, "re-evaluation at the same bar emits nothing");
   MqlRates nbars[];
   int nn = 0;
   for(int i = 0; i < nb; i++)
      T3AddBar(nbars, nn, base[i].time, base[i].high, base[i].low, base[i].close);
   T3AddBar(nbars, nn, base[nb - 1].time + (datetime)T3_PERIOD, 135.0, 104.0, 112.0);
   H3EvaluateLatest(nbars, nn, pc, e1, tr, ev1);
   s = H3ConsumeNew(e1, ev1, cur, T3_PERIOD, out, nout);
   Check(s == H3_C_OK && nout == 1 && out[0].type == H3_EV_WICK && out[0].bar_time == nbars[nn - 1].time,
         "the next closed bar emits its event (WICK) once");
   cur = H3BaselineCursor(e1);
   H3EvaluateLatest(nbars, nn, pc, e2, tr, ev2);
   s = H3ConsumeNew(e2, ev2, cur, T3_PERIOD, out, nout);
   Check(s == H3_C_NOTHING_NEW && nout == 0, "and not a second time");
   H3EvaluateLatest(nbars, nn, pc, e2, tr, ev2);
   H3ConsumeNew(e2, ev2, H3BaselineCursor(e2), T3_PERIOD, out, nout);
   Check(T3CountEvents(ev2, e2.ne, H3_EV_WICK) >= 1 && nout == 0,
         "a restart sets the baseline again: the WICK stays in the history and is not a new signal");
   MqlRates gap[];
   int ng = 0;
   for(int j = 0; j < nn; j++)
      T3AddBar(gap, ng, nbars[j].time, nbars[j].high, nbars[j].low, nbars[j].close);
   T3AddBar(gap, ng, nbars[nn - 1].time + (datetime)T3_PERIOD, 115.0, 105.0, 110.0);
   T3AddBar(gap, ng, nbars[nn - 1].time + (datetime)(2 * T3_PERIOD), 116.0, 106.0, 111.0);
   H3EvaluateLatest(gap, ng, pc, e3, tr, ev3);
   s = H3ConsumeNew(e3, ev3, H3BaselineCursor(e1), T3_PERIOD, out, nout);
   Check(s == H3_C_GAP && nout == 0, "a cursor older than the previous bar (missed bars) emits nothing and must be re-baselined");
   MqlRates lim[];
   int nl, lk;
   SH3Params pl;
   string lex;
   T3Get("p16b_ab_difference", lim, nl, lk, pl, lex);
   H3EvaluateLatest(lim, nl, pl, el, tr, evl);
   s = H3ConsumeNew(el, evl, lim[nl - 2].time, T3_PERIOD, out, nout);
   Check(s == H3_C_NOT_RELIABLE && nout == 0, "a LIMITED_BY_HISTORY evaluation emits no event");
  }

//+------------------------------------------------------------------+
//| entries-block flags are separate and REPORT only                 |
//+------------------------------------------------------------------+
void TestFlags(void)
  {
   Print("--- entries-block flags (hold = S3, sweep wait = technical proposal, separate)");
   MqlRates b[];
   int n, kind;
   SH3Params p;
   string ex;
   T3Get("w_wick", b, n, kind, p, ex);
   SH3Rep r;
   SH3Track tr[];
   SH3Event ev[];
   string k[];
   H3Replay(b, n, p, r, tr, ev, k, false);
   Check(H3HoldBlock(r.st) && !H3SweepBlock(r.st), "HOLD raises the hold block (S3), not the sweep block");
   T3Get("s_sweep_fvg_touch", b, n, kind, p, ex);
   H3Replay(b, n, p, r, tr, ev, k, false);
   int sidx = -1;
   for(int i = 0; i < r.ne; i++)
     {
      if(ev[i].type == H3_EV_INT_SWEEP)
         sidx = T3IndexOfTime(b, n, ev[i].bar_time);
     }
   H3Replay(b, sidx + 1, p, r, tr, ev, k, false);
   Check(sidx > 0 && r.st.phase == H3_PH_SWEEP_WAIT && H3SweepBlock(r.st) && !H3HoldBlock(r.st),
         "SWEEP_WAIT exposes the entries-block as a separate TECHNICAL-PROPOSAL flag (not the S3 hold flag)");
  }


//+------------------------------------------------------------------+
//| helpers for tests 22 and 23                                      |
//+------------------------------------------------------------------+
//--- the level id inside a state key ("LV=<id>@<price>" or "LV=-")
string T3LvIdOfKey(const string key)
  {
   int a = StringFind(key, ";LV=");
   if(a < 0)
      return("");
   string rest = StringSubstr(key, a + 4);
   int b = StringFind(rest, ";");
   if(b >= 0)
      rest = StringSubstr(rest, 0, b);
   int at = StringFind(rest, "@");
   if(at >= 0)
      rest = StringSubstr(rest, 0, at);
   return(rest);
  }

//--- id of the protecting level a derivation from the closed prefix bars[0..upto] would give
string T3DeriveIdAt(const MqlRates &bars[], const int n, const int upto, const int d)
  {
   SH4Swing sw[];
   int amb = 0;
   int ns = H4FindSwings(bars, n, 2, 2, T3_PERIOD, sw, amb);
   bool hl, he, hi;
   SH3Cand lv, ex, li;
   H3DeriveLevel(sw, H3KnownCount(sw, ns, 2, upto), d, hl, lv, he, ex, hi, li);
   return(hl ? lv.id : "-");
  }

bool T3EndsWith(const string text, const string tail)
  {
   int lt = StringLen(text);
   int ll = StringLen(tail);
   return(lt >= ll && StringSubstr(text, lt - ll) == tail);
  }

//--- index of the first event of this type, or -1
int T3FirstEvent(const SH3Event &events[], const int ne, const int type)
  {
   for(int i = 0; i < ne; i++)
     {
      if(events[i].type == type)
         return(i);
     }
   return(-1);
  }

bool T3InTimes(const datetime &refs[], const int nr, const datetime t)
  {
   for(int i = 0; i < nr; i++)
     {
      if(refs[i] == t)
         return(true);
     }
   return(false);
  }

//+------------------------------------------------------------------+
//| 22. REWRITTEN in revision 10 (PROPOSAL / PROTOTYPE, awaiting the |
//| client). The revision 6-7 tests of this group asserted that the |
//| protecting level is FROZEN during RECONFIRMED(INTERNAL) and      |
//| thawed and re-derived at the end of the thaw bar. Revision 10    |
//| removes the freeze: the STRUCTURE updates on every closed bar in |
//| every phase and the setup context is separate. The same         |
//| scenarios are kept; the changed expectation is stated per check. |
//| KEPT: a new level is used only from the FOLLOWING bar, no event  |
//| is lost on T+1, a wick restarts / a body break flips, another    |
//| eligible FVG can be touched on the bar of the loss.              |
//+------------------------------------------------------------------+
//--- value of a field inside a state key (";LABEL=value;")
string T3KeyField(const string key, const string label)
  {
   int a = StringFind(key, ";" + label + "=");
   if(a < 0)
      return("");
   string rest = StringSubstr(key, a + StringLen(label) + 2);
   int b = StringFind(rest, ";");
   if(b >= 0)
      rest = StringSubstr(rest, 0, b);
   return(rest);
  }

//--- the last event of this type, or -1
int T3LastEvent(const SH3Event &events[], const int ne, const int type)
  {
   int r = -1;
   for(int i = 0; i < ne; i++)
     {
      if(events[i].type == type)
         r = i;
     }
   return(r);
  }

void TestFreezeInternal(void)
  {
   Print("--- 22. (REWRITTEN, revision 10) RECONFIRMED(INTERNAL): the structure is NOT frozen; RECONF_LOST keeps the setup");
   for(int pi = 0; pi < 2; pi++)
     {
      string pref = (pi == 0 ? "" : "m_");
      string tag = (pi == 0 ? "SELL" : "BUY");
      int d0 = (pi == 0 ? H3_BEAR : H3_BULL);
      MqlRates b[];
      int n, kind;
      SH3Params p;
      string ex;
      SH3Rep r;
      SH3Track tr[];
      SH3Event ev[];
      string keys[];
      //--- (a) was: a swing confirmed long after the reconfirmation leaves the level frozen. NOW: the level advances
      T3Get(pref + "s_recon_later_swing", b, n, kind, p, ex);
      H3Replay(b, n, p, r, tr, ev, keys, true);
      int ri = T3IndexOfTime(b, n, ev[T3FirstEvent(ev, r.ne, H3_EV_RECONFIRMED)].bar_time);
      string lv_touch = T3LvIdOfKey(keys[ri - 1]);
      string setup_touch = T3KeyField(keys[ri], "SU");
      Check(r.st.phase == H3_PH_RECONFIRMED && r.st.recon_reason == H3_RR_INTERNAL && !r.st.frozen &&
            T3LvIdOfKey(keys[n - 1]) != lv_touch && T3LvIdOfKey(keys[n - 1]) != "-" && T3LvIdOfKey(keys[n - 1]) == T3DeriveIdAt(b, n, n - 1, d0),
            tag + " (a): CHANGED - the level advances to the newer leg during RECONFIRMED(INTERNAL) (it is no longer frozen)");
      Check(T3KeyField(keys[n - 1], "SU") == setup_touch && r.st.rec_id == ev[T3FirstEvent(ev, r.ne, H3_EV_RECONFIRMED)].ref,
            tag + " (a): the setup (setup_id, recorded FVG) is unchanged by the structure update");
      bool cont_after = false;
      for(int q = 0; q < r.ne; q++)
        {
         if(ev[q].type == H3_EV_CONTINUATION && ev[q].bar_time > b[ri].time)
            cont_after = true;
        }
      Check(cont_after, tag + " (a): CHANGED - observation events (CONTINUATION) are raised also while RECONFIRMED");
      //--- (a2) was: the touching candle confirms a swing and the event's level stays frozen. NOW: the touch bar is
      //--- judged with the level known BEFORE it; the new level exists at the END of the bar and is used from the next
      T3Get(pref + "s_recon_touch_swing", b, n, kind, p, ex);
      H3Replay(b, n, p, r, tr, ev, keys, true);
      ri = T3IndexOfTime(b, n, ev[T3FirstEvent(ev, r.ne, H3_EV_RECONFIRMED)].bar_time);
      string before = T3LvIdOfKey(keys[ri - 1]);
      string after = T3LvIdOfKey(keys[ri]);
      Check(before != "-" && after == T3DeriveIdAt(b, n, ri, d0) && after != before && after != "-",
            tag + " (a2): CHANGED - the touching candle confirms a new swing: the level known before the bar judged it; the new level exists at the end of the bar and is used from the next");
      Check(T3DeriveIdAt(b, n, ri - 1, d0) == before,
            tag + " (a2): control: a derivation up to the bar before the touch gives the level the touch bar was judged against");
      //--- (b) was: the recorded FVG is invalidated: thaw and re-derivation. NOW: RECONF_LOST returns the setup to waiting
      T3Get(pref + "s_recon_thaw", b, n, kind, p, ex);
      H3Replay(b, n, p, r, tr, ev, keys, true);
      int li = T3FirstEvent(ev, r.ne, H3_EV_RECONF_LOST);
      int ti = T3IndexOfTime(b, n, ev[li].bar_time);
      string su_before = T3KeyField(keys[ti - 1], "SU");
      string su_after = T3KeyField(keys[ti], "SU");
      Check(T3CountEvents(ev, r.ne, H3_EV_RECONF_LOST) == 1 && T3EndsWith(ev[li].detail, "to=SWEEP_WAIT") &&
            T3Contains(keys[ti], "PH=SWEEP_WAIT") && T3Contains(keys[ti - 1], "PH=RECONFIRMED"),
            tag + " (b): the invalidated FVG sends RECONFIRMED(INTERNAL) back to SWEEP_WAIT");
      int swi = T3IndexOfTime(b, n, r.st.sweep_time);
      Check(su_before == su_after && su_after != "-" && T3CountEvents(ev, r.ne, H3_EV_SETUP_ENDED) == 0 && r.st.sweep_time != 0 &&
            r.st.rec_id == "" && r.st.setup_id == su_after && swi >= 0 && r.st.wait_start == b[swi + 1].time,
            tag + " (b): RECONF_LOST KEEPS setup_id, the sweep record and wait_start, clears rec_id and is NOT a SETUP_ENDED");
      Check(T3LvIdOfKey(keys[n - 1]) == T3DeriveIdAt(b, n, n - 1, d0) && !r.st.frozen && H3SweepBlock(r.st),
            tag + " (b): CHANGED - nothing thaws (the level was never frozen): it is the ratcheted level; the wait continues and the entries-block flag (technical proposal) is raised again");
      //--- (b2) KEPT: the following bar is judged against the CURRENT level (the one at the end of T)
      string lvT = T3LvIdOfKey(keys[ti]);
      T3Get(pref + "s_recon_thaw_wick", b, n, kind, p, ex);
      H3Replay(b, n, p, r, tr, ev, keys, true);
      int wi = T3FirstEvent(ev, r.ne, H3_EV_WICK);
      int se = T3LastEvent(ev, r.ne, H3_EV_SETUP_ENDED);
      Check(T3CountEvents(ev, r.ne, H3_EV_WICK) == 1 && ev[wi].ref == lvT && T3EndsWith(ev[wi].detail, "restart=0") && r.st.phase == H3_PH_HOLD &&
            se >= 0 && StringFind(ev[se].detail, "reason=REPLACED") == 0 && r.st.setup_type == "WICK",
            tag + " (b2): a wick on T+1 is judged against the current level (the end of T); the sweep setup is REPLACED by a WICK setup");
      T3Get(pref + "s_recon_thaw_break", b, n, kind, p, ex);
      H3Replay(b, n, p, r, tr, ev, keys, true);
      int fi = T3FirstEvent(ev, r.ne, H3_EV_FLIP);
      se = T3LastEvent(ev, r.ne, H3_EV_SETUP_ENDED);
      Check(T3CountEvents(ev, r.ne, H3_EV_FLIP) == 1 && ev[fi].ref == lvT && r.st.dir == -d0 &&
            se >= 0 && StringFind(ev[se].detail, "reason=INVALIDATED_BY_FLIP") == 0,
            tag + " (b2): a body close on T+1 beyond the current level flips the bias and ends the setup");
      //--- (b3) KEPT: no event lost on T+1 after RECONF_LOST
      string kn[] = {"cont", "isweep", "ibreak"};
      int kt[] = {H3_EV_CONTINUATION, H3_EV_INT_SWEEP, H3_EV_INT_BREAK};
      string kl[] = {"CONTINUATION", "INTERNAL_SWEEP", "INTERNAL_BREAK"};
      for(int k3 = 0; k3 < 3; k3++)
        {
         T3Get(pref + "s_recon_thaw_" + kn[k3], b, n, kind, p, ex);
         H3Replay(b, n, p, r, tr, ev, keys, true);
         int late = 0;
         for(int e3 = 0; e3 < r.ne; e3++)
           {
            if(ev[e3].type == kt[k3] && ev[e3].bar_time == b[n - 1].time)
               late++;
           }
         int tix = T3IndexOfTime(b, n, ev[T3FirstEvent(ev, r.ne, H3_EV_RECONF_LOST)].bar_time);
         Check(late == 1 && tix == n - 2 && r.st.dir == d0,
               tag + " (b3): " + kl[k3] + " is still raised on T+1 after RECONF_LOST (no event lost)");
        }
      //--- (c) KEPT in substance: wick / body break during RECONFIRMED(INTERNAL); CHANGED: the setup is REPLACED / ENDED
      T3Get(pref + "s_recon_wick", b, n, kind, p, ex);
      H3Replay(b, n, p, r, tr, ev, keys, true);
      wi = T3FirstEvent(ev, r.ne, H3_EV_WICK);
      se = T3LastEvent(ev, r.ne, H3_EV_SETUP_ENDED);
      string prev_key = keys[n - 2];
      Check(T3CountEvents(ev, r.ne, H3_EV_WICK) == 1 && T3EndsWith(ev[wi].detail, "restart=1") && r.st.phase == H3_PH_HOLD && r.st.setup_type == "WICK" &&
            T3Contains(prev_key, "PH=RECONFIRMED") && T3Contains(prev_key, "RSN=INTERNAL") &&
            ev[wi].ref == T3LvIdOfKey(prev_key) && r.st.sweep_time == 0 && r.st.rec_id == "" &&
            se >= 0 && StringFind(ev[se].detail, "reason=REPLACED") == 0,
            tag + " (c): a wick through the current level during RECONFIRMED(INTERNAL) starts HOLD (restart): the sweep setup is REPLACED by a WICK setup");
      T3Get(pref + "s_recon_break", b, n, kind, p, ex);
      H3Replay(b, n, p, r, tr, ev, keys, true);
      fi = T3FirstEvent(ev, r.ne, H3_EV_FLIP);
      se = T3LastEvent(ev, r.ne, H3_EV_SETUP_ENDED);
      prev_key = keys[n - 2];
      Check(T3CountEvents(ev, r.ne, H3_EV_FLIP) == 1 && ev[fi].ref == T3LvIdOfKey(prev_key) && T3Contains(prev_key, "PH=RECONFIRMED") &&
            T3Contains(prev_key, "RSN=INTERNAL") && T3CountEvents(ev, r.ne, H3_EV_RECONF_LOST) == 0 && r.st.dir == -d0 &&
            se >= 0 && StringFind(ev[se].detail, "reason=INVALIDATED_BY_FLIP") == 0,
            tag + " (c): a body close beyond the current level during RECONFIRMED(INTERNAL) flips the bias and ends the setup (priority before reconfirmation)");
      //--- (d) KEPT: invalidation of the recorded FVG and a touch of ANOTHER FVG on the same bar
      T3Get(pref + "s_recon_two_fvg", b, n, kind, p, ex);
      H3Replay(b, n, p, r, tr, ev, keys, true);
      li = T3FirstEvent(ev, r.ne, H3_EV_RECONF_LOST);
      ti = T3IndexOfTime(b, n, ev[li].bar_time);
      int r1 = T3FirstEvent(ev, r.ne, H3_EV_RECONFIRMED);
      int r2 = -1;
      for(int e4 = r1 + 1; e4 < r.ne; e4++)
        {
         if(ev[e4].type == H3_EV_RECONFIRMED && r2 < 0)
            r2 = e4;
        }
      su_before = T3KeyField(keys[ti - 1], "SU");
      Check(T3CountEvents(ev, r.ne, H3_EV_RECONF_LOST) == 1 && T3CountEvents(ev, r.ne, H3_EV_RECONFIRMED) == 2 && r2 > 0 &&
            ev[r2].bar_time == ev[li].bar_time && ev[r2].ref != ev[li].ref && r.st.phase == H3_PH_RECONFIRMED &&
            r.st.recon_reason == H3_RR_INTERNAL && r.st.rec_id == ev[r2].ref && r.st.setup_id == su_before &&
            T3CountEvents(ev, r.ne, H3_EV_SETUP_ENDED) == 0,
            tag + " (d): the recorded FVG is lost and another one is touched on the same bar: RECONFIRMED(INTERNAL) again, SAME setup_id, other recorded FVG");
      //--- (e) REWRITTEN: was 'a touch while no protecting level is defined is not recorded'. A candidate crossed by a
      //--- close is now REJECTED and the previous level stays, so a level-less setup cannot arise; the same touch IS recorded.
      T3Get(pref + "s_recon_nolevel", b, n, kind, p, ex);
      H3Replay(b, n, p, r, tr, ev, keys, true);
      int rc0 = T3FirstEvent(ev, r.ne, H3_EV_RECONFIRMED);
      Check(T3CountEvents(ev, r.ne, H3_EV_RECONFIRMED) == 1 && rc0 >= 0 && ev[rc0].bar_time == b[n - 2].time && r.st.has_level && r.st.phase == H3_PH_RECONFIRMED,
            tag + " (e): CHANGED - the touch of s_recon_nolevel IS recorded: the crossed candidate is rejected and the previous level stays in force (no level-less setup)");
      T3Get(pref + "s_recon_nolevel_ctl", b, n, kind, p, ex);
      H3Replay(b, n, p, r, tr, ev, keys, true);
      int rc = T3FirstEvent(ev, r.ne, H3_EV_RECONFIRMED);
      Check(T3CountEvents(ev, r.ne, H3_EV_RECONFIRMED) == 1 && rc >= 0 && ev[rc].bar_time == b[n - 2].time && r.st.has_level && !r.st.frozen,
            tag + " (e): control: the same touch with the candidate not crossed is recorded as RECONFIRMED(INTERNAL); nothing is frozen");
      //--- a structural RECONFIRMED lost to FVG invalidation returns to HOLD (setup kept)
      T3Get(pref + "w_invalid_after_reconf", b, n, kind, p, ex);
      H3Replay(b, n, p, r, tr, ev, keys, false);
      Check(r.st.phase == H3_PH_HOLD && !r.st.frozen && T3CountEvents(ev, r.ne, H3_EV_RECONF_LOST) >= 1 &&
            T3CountEvents(ev, r.ne, H3_EV_SETUP_ENDED) == 0 && StringFind(r.st.setup_id, "WICK@") == 0,
            tag + ": a structural RECONFIRMED lost to FVG invalidation returns to HOLD with the same setup (RECONF_LOST is not SETUP_ENDED)");
     }
   //--- invariant over every replay case, every bar: a setup never exists without a protecting level
   int bad = 0;
   for(int ci = 0; ci < T3_CASE_COUNT; ci++)
     {
      MqlRates cb[];
      int cn, ckind, lb, rb, cap;
      string nm, cex;
      T3LoadCase(ci, cb, cn, ckind, lb, rb, cap, nm, cex);
      if(ckind != 0)
         continue;
      SH3Params cp;
      T3Params(lb, rb, cap, cp);
      SH3Rep cr;
      SH3Track ctr[];
      SH3Event cev[];
      string ckeys[];
      H3Replay(cb, cn, cp, cr, ctr, cev, ckeys, true);
      if(cr.st.dir != H3_NONE && cr.st.phase != H3_PH_ACTIVE && !cr.st.has_level)
         bad++;
      for(int kx = 0; kx < cn; kx++)
        {
         if(!T3Contains(ckeys[kx], ";PH=ACTIVE;") && !T3Contains(ckeys[kx], ";PH=-;") && T3Contains(ckeys[kx], ";LV=-;"))
           {
            bad++;
            break;
           }
        }
     }
   Check(bad == 0, "invariant (every case, every bar): a setup (HOLD, SWEEP_WAIT, RECONFIRMED) never exists without a protecting level");
  }

//+------------------------------------------------------------------+
//| 28. revision 10 (PROPOSAL / PROTOTYPE, awaiting the client):     |
//| structure / setup separation, ratchet, current level, RECONF_LOST|
//| keeps the setup, setup_id, A/B by function, setup context,       |
//| confirm_time across weekends with RightBars 1, 2, 3.             |
//| Python-only (no MQL5 mirror of the switch): the R0 control that  |
//| shows SNAPSHOT_CROSSED without the ratchet.                       |
//+------------------------------------------------------------------+
double T3LvPriceOfKey(const string key)
  {
   string v = T3KeyField(key, "LV");
   int at = StringFind(v, "@");
   if(at < 0)
      return(0.0);
   string rest = StringSubstr(v, at + 1);
   int sl = StringFind(rest, "/");
   if(sl >= 0)
      rest = StringSubstr(rest, 0, sl);
   return(StringToDouble(rest));
  }

string T3ExIdOfKey(const string key)
  {
   string v = T3KeyField(key, "EX");
   int at = StringFind(v, "@");
   if(at >= 0)
      v = StringSubstr(v, 0, at);
   return(v);
  }

string T3BiasOfKey(const string key)
  {
   int e = StringFind(key, ";");
   if(e < 0)
      return(key);
   return(StringSubstr(key, 0, e));
  }

//--- the distinct protecting level ids in the life of a replay (no "-")
int T3LevelSequence(const string &keys[], const int n, string &lvs[])
  {
   ArrayResize(lvs, 0);
   int c = 0;
   for(int i = 0; i < n; i++)
     {
      string v = T3LvIdOfKey(keys[i]);
      if(v == "-" || v == "")
         continue;
      if(c == 0 || lvs[c - 1] != v)
        {
         ArrayResize(lvs, c + 1);
         lvs[c] = v;
         c++;
        }
     }
   return(c);
  }

//--- the A/B reasons of two (state, tracks) pairs with the other layers' events equal
string T3Reasons(const SH3State &a, const SH3Track &ta[], const int na, const SH3State &b, const SH3Track &tb[], const int nb)
  {
   return(H3AbReasons(H3StructKey(a), H3StructKey(b), H3SetupKey(a, ta, na), H3SetupKey(b, tb, nb), "-", "-",
                      H3_BEAR, (datetime)4000000000, 0, ""));
  }

//--- index of the first track that is not INVALID, or -1
int T3LiveTrack(const SH3Track &tr[], const int nt)
  {
   for(int i = 0; i < nt; i++)
     {
      if(!tr[i].invalid)
         return(i);
     }
   return(-1);
  }

//--- MUTATION helper: equal after removing the labels flagged in drop[] (equal = the mutated comparison would say reliable)
bool T3EqualWithout(const string &va[], const string &vb[], const bool &drop[])
  {
   for(int i = 0; i < H3_STATE_FIELD_COUNT; i++)
     {
      if(!drop[i] && va[i] != vb[i])
         return(false);
     }
   return(true);
  }

double T3Rand(ulong &st)
  {
   st = st * (ulong)6364136223846793005 + (ulong)1442695040888963407;
   return((double)((st >> 11) & 0x1FFFFF) / 2097152.0);
  }

//--- deterministic random-walk H4 bars (property tests only; no real data)
void T3RandBars(const int seed, const int count, MqlRates &bars[], int &n)
  {
   ulong st = (ulong)(seed + 1) * 2654435761;
   n = 0;
   ArrayResize(bars, 0);
   double c = 1000.0;
   for(int i = 0; i < count; i++)
     {
      double o = c;
      c = o + (T3Rand(st) * 2.0 - 1.0) * 7.0;
      double hi = (o > c ? o : c) + T3Rand(st) * 5.6;
      double lo = (o < c ? o : c) - T3Rand(st) * 5.6;
      T3AddBar(bars, n, T3Base() + (datetime)(i * T3_PERIOD), NormalizeDouble(hi, 2), NormalizeDouble(lo, 2), NormalizeDouble(c, 2));
     }
  }

void TestRevision10(void)
  {
   Print("--- 28. revision 10 (PROPOSAL / PROTOTYPE, awaiting the client): structure/setup separation, ratchet, current level, RECONF_LOST, setup_id");
   for(int pi = 0; pi < 2; pi++)
     {
      string pref = (pi == 0 ? "" : "m_");
      string tag = (pi == 0 ? "SELL" : "BUY");
      int sg = (pi == 0 ? 1 : -1);
      int d0 = (pi == 0 ? H3_BEAR : H3_BULL);
      MqlRates b[];
      int n, kind;
      SH3Params p;
      string ex;
      SH3Rep r;
      SH3Track tr[];
      SH3Event ev[];
      string keys[];
      string lvs[];
      //--- R1 / R2: the structure updates while a setup waits; the wick top never raises the level
      T3Get(pref + "r10_hold", b, n, kind, p, ex);
      H3Replay(b, n, p, r, tr, ev, keys, true);
      int nl = T3LevelSequence(keys, n, lvs);
      int wix = T3FirstEvent(ev, r.ne, H3_EV_WICK);
      int wi = T3IndexOfTime(b, n, ev[wix].bar_time);
      Check(nl == 2 && lvs[0] != lvs[1] && r.st.phase == H3_PH_HOLD && r.st.setup_type == "WICK" && r.st.snap_id == lvs[0] &&
            T3LvIdOfKey(keys[n - 1]) == lvs[1],
            tag + " R1: in HOLD the protecting level advances to the newer leg (2 levels in the life of the setup) while the setup stays; the snapshot is the first level");
      string ex0 = T3ExIdOfKey(keys[wi]);
      int jx = -1;
      for(int i = wi; i < n && jx < 0; i++)
        {
         if(T3ExIdOfKey(keys[i]) != ex0)
            jx = i;
        }
      Check(jx > 0 && T3LvIdOfKey(keys[jx]) == lvs[0] && T3LvIdOfKey(keys[n - 1]) == lvs[1] && jx < n - 1,
            tag + " R2: a newer low is confirmed while the level stays: its leg top is the wick top, rejected because it is not more advanced than the level");
      string sw = H4TimeStamp(ev[wix].bar_time);
      bool all_same = true;
      for(int i2 = wi; i2 < n; i2++)
        {
         if(!T3Contains(keys[i2], ";SU=WICK@" + sw + "#"))
            all_same = false;
        }
      Check(all_same, tag + " R1: setup_id is the same on every bar from the wick to the end of the case");
      bool mono = true;
      for(int i3 = 1; i3 < n; i3++)
        {
         if(T3BiasOfKey(keys[i3]) == T3BiasOfKey(keys[i3 - 1]) && T3LvIdOfKey(keys[i3]) != "-" && T3LvIdOfKey(keys[i3 - 1]) != "-")
           {
            if(sg * T3LvPriceOfKey(keys[i3]) > sg * T3LvPriceOfKey(keys[i3 - 1]) + 0.000000001)
               mono = false;
           }
        }
      Check(mono, tag + " R2: the protecting level price is monotone in the trend direction (the ratchet)");
      //--- R3 / R13: the FLIP comes from the CURRENT level before the snapshot is crossed (revision 9 example 1)
      T3Get(pref + "r10_flip", b, n, kind, p, ex);
      H3Replay(b, n, p, r, tr, ev, keys, true);
      wix = T3FirstEvent(ev, r.ne, H3_EV_WICK);
      int fx = T3FirstEvent(ev, r.ne, H3_EV_FLIP);
      int fbar = T3IndexOfTime(b, n, ev[fx].bar_time);
      int sx = T3LastEvent(ev, r.ne, H3_EV_SETUP_ENDED);
      string snap_in_su = T3KeyField(keys[fbar - 1], "SU");
      int hash = StringFind(snap_in_su, "#");
      string snap_lv = (hash >= 0 ? StringSubstr(snap_in_su, hash + 1) : "");
      Check(T3CountEvents(ev, r.ne, H3_EV_FLIP) == 1 && ev[fx].ref == T3LvIdOfKey(keys[fbar - 1]) && ev[fx].ref != snap_lv && snap_lv != "" &&
            r.st.dir == -d0 && sx >= 0 && StringFind(ev[sx].detail, "reason=INVALIDATED_BY_FLIP") == 0,
            tag + " R13: the FLIP comes from the NEW (current) level before the snapshot level; the setup ends INVALIDATED_BY_FLIP");
      bool beyond = false;
      int wbar = T3IndexOfTime(b, n, ev[wix].bar_time);
      double snap_px = 0.0;
      H3Replay(b, wbar + 1, p, r, tr, ev, keys, false);
      snap_px = r.st.snap_price;
      H3Replay(b, n, p, r, tr, ev, keys, false);
      for(int i4 = wbar + 1; i4 <= fbar; i4++)
        {
         if(sg * (b[i4].close - snap_px) > 0)
            beyond = true;
        }
      Check(!beyond && T3CountEvents(ev, r.ne, H3_EV_SNAP_CROSSED) == 0,
            tag + " R13: no close was beyond the snapshot level (it was not crossed) and no SNAPSHOT_CROSSED was reported");
      //--- example 2: with the ratchet the close beyond the snapshot is a FLIP at that bar
      T3Get(pref + "r10_ex2", b, n, kind, p, ex);
      H3Replay(b, n, p, r, tr, ev, keys, false);
      Check(T3CountEvents(ev, r.ne, H3_EV_SNAP_CROSSED) == 0 && T3CountEvents(ev, r.ne, H3_EV_FLIP) == 1,
            tag + " R14: WITH the ratchet the close beyond the snapshot is a FLIP at that bar and no SNAPSHOT_CROSSED exists (the R0 control without the ratchet is Python-only)");
      //--- sweep wait and reconfirmed structural updates
      string nms[] = {"r10_sweep", "r10_reconf"};
      int phs[] = {H3_PH_SWEEP_WAIT, H3_PH_RECONFIRMED};
      string phn[] = {"SWEEP_WAIT", "RECONFIRMED"};
      for(int q = 0; q < 2; q++)
        {
         T3Get(pref + nms[q], b, n, kind, p, ex);
         H3Replay(b, n, p, r, tr, ev, keys, true);
         nl = T3LevelSequence(keys, n, lvs);
         string su0 = "";
         bool one_su = true;
         for(int i5 = 0; i5 < n; i5++)
           {
            string su = T3KeyField(keys[i5], "SU");
            if(su == "-" || su == "")
               continue;
            if(su0 == "")
               su0 = su;
            else
               if(su != su0)
                  one_su = false;
           }
         Check(r.st.phase == phs[q] && nl >= 2 && lvs[nl - 1] != lvs[0] && one_su && T3CountEvents(ev, r.ne, H3_EV_SETUP_ENDED) == 0,
               tag + " R1: in " + phn[q] + " the level advances to newer legs (" + IntegerToString(nl) + " levels) and the setup (setup_id) is untouched");
        }
      //--- R15: RECONF_LOST keeps the setup (STRUCT -> HOLD); a second touch gives RECONFIRMED in the same setup
      T3Get(pref + "r10_retouch", b, n, kind, p, ex);
      H3Replay(b, n, p, r, tr, ev, keys, true);
      int rc1 = T3FirstEvent(ev, r.ne, H3_EV_RECONFIRMED);
      int rc2 = -1;
      for(int e1 = rc1 + 1; e1 < r.ne; e1++)
        {
         if(ev[e1].type == H3_EV_RECONFIRMED && rc2 < 0)
            rc2 = e1;
        }
      int lx = T3FirstEvent(ev, r.ne, H3_EV_RECONF_LOST);
      int lbar = T3IndexOfTime(b, n, ev[lx].bar_time);
      string su_b = T3KeyField(keys[lbar - 1], "SU");
      string su_a = T3KeyField(keys[lbar], "SU");
      Check(T3CountEvents(ev, r.ne, H3_EV_RECONFIRMED) == 2 && T3CountEvents(ev, r.ne, H3_EV_RECONF_LOST) == 1 && rc2 > 0 && ev[rc1].ref != ev[rc2].ref &&
            su_b == su_a && su_a == r.st.setup_id && T3CountEvents(ev, r.ne, H3_EV_SETUP_ENDED) == 0 && r.st.phase == H3_PH_RECONFIRMED && r.st.rec_id == ev[rc2].ref,
            tag + " R15: STRUCT - RECONFIRMED, RECONF_LOST (back to HOLD), a second FVG is touched: RECONFIRMED again, SAME setup_id, another recorded FVG, no SETUP_ENDED");
      string post = keys[lbar];
      Check(T3Contains(post, "PH=HOLD") && T3Contains(post, ";REC=-;") && T3Contains(post, ";RSN=-;") &&
            T3Contains(post, ";WAIT=" + H3Tx(r.st.wait_start) + ";") && T3Contains(post, ";SRC=" + H3Tx(r.st.src_time) + ";"),
            tag + " R15: after RECONF_LOST rec_id and the reason are cleared; wait_start and the source time are kept");
      bool lost_inv = false;
      bool rec_ok = false;
      for(int t1 = 0; t1 < r.nt; t1++)
        {
         if(tr[t1].id == ev[rc1].ref && tr[t1].invalid)
            lost_inv = true;
         if(tr[t1].id == ev[rc2].ref && tr[t1].recorded)
            rec_ok = true;
        }
      Check(lost_inv && rec_ok, tag + " R15: the lost FVG stays INVALID, the other track is the recorded one (other valid tracks kept through the loss)");
      //--- R16: a new wick / sweep replaces the setup (new setup_id, REPLACED); a retired id never reappears
      string nm16[] = {"w_second_wick_hold", "w_second_wick_reconf", "s_restart", "s_wait_wick"};
      for(int c16 = 0; c16 < 4; c16++)
        {
         T3Get(pref + nm16[c16], b, n, kind, p, ex);
         H3Replay(b, n, p, r, tr, ev, keys, true);
         string seen = "|";
         int nseen = 0;
         bool uniq = true;
         string last_su = "";
         string seq[];
         ArrayResize(seq, 0);
         for(int i6 = 0; i6 < n; i6++)
           {
            string v = T3KeyField(keys[i6], "SU");
            if(v == "-" || v == "" || v == last_su)
               continue;
            if(StringFind(seen, "|" + v + "|") >= 0)
               uniq = false;
            seen += v + "|";
            ArrayResize(seq, nseen + 1);
            seq[nseen] = v;
            nseen++;
            last_su = v;
           }
         int nend = 0;
         bool all_rep = true;
         bool refs_ok = true;
         for(int e2 = 0; e2 < r.ne; e2++)
           {
            if(ev[e2].type == H3_EV_SETUP_ENDED)
              {
               if(StringFind(ev[e2].detail, "reason=REPLACED") != 0)
                  all_rep = false;
               if(nend >= nseen || ev[e2].ref != seq[nend])
                  refs_ok = false;
               nend++;
              }
           }
         Check(nend >= 1 && all_rep && uniq && nseen >= 2 && refs_ok && r.st.setup_id == seq[nseen - 1],
               tag + " R16 (" + nm16[c16] + "): a new wick/sweep ends the live setup with REPLACED and starts a NEW setup_id; a retired id never reappears");
        }
     }
   //--- R8 LEGS: replays from window starts before and after the wick end in the same state
   MqlRates lb[];
   int ln, lkind;
   SH3Params lp;
   string lex;
   T3Get("r10_legs", lb, ln, lkind, lp, lex);
   string fin0 = "";
   bool fin_same = true;
   int nfin = 0;
   for(int st0 = 0; st0 < 56; st0 += 4)
     {
      MqlRates sl[];
      T3Slice(lb, st0, ln - st0, sl);
      SH3Rep sr;
      SH3Track st_tr[];
      SH3Event st_ev[];
      string st_k[];
      H3Replay(sl, ln - st0, lp, sr, st_tr, st_ev, st_k, false);
      string fin = H3DirName(sr.st.dir) + "/" + H3PhaseName(sr.st.phase) + "/" + sr.st.lv_id + "/" + H3Pf(sr.st.lv_price);
      if(nfin == 0)
         fin0 = fin;
      else
         if(fin != fin0)
            fin_same = false;
      nfin++;
     }
   Check(fin_same && nfin == 14 && StringFind(fin0, "BULL/") == 0,
         "R8 LEGS (SYNTHETIC): wick, two newer legs, recovery above the newer level: replays from 14 window starts all end in the same BULL state with the same level");
   //--- SC-1 stays LIMITED (checked in group 16/17 'b'); the mutation controls
   MqlRates sb[];
   int sn, skind;
   SH3Params sp;
   string sex;
   SH3Eval se;
   SH3Track str[];
   SH3Event sev[];
   T3Get("sc1_limited", sb, sn, skind, sp, sex);
   H3Evaluate(sb, sn, sp, se, str, sev);
   SH3Rep ra;
   SH3Rep rb;
   SH3Track ta[];
   SH3Track tb[];
   SH3Event ea[];
   SH3Event eb[];
   string ka[];
   string kb[];
   H3Replay(sb, sn, sp, ra, ta, ea, ka, false);
   MqlRates sbb[];
   T3Slice(sb, sn - se.b_depth, se.b_depth, sbb);
   H3Replay(sbb, se.b_depth, sp, rb, tb, eb, kb, false);
   string la[];
   string lb2[];
   string va[];
   string vb[];
   H3StateFields(ra.st, ta, ra.nt, la, va);
   H3StateFields(rb.st, tb, rb.nt, lb2, vb);
   bool none_drop[];
   bool all_drop[];
   bool struct_drop[];
   bool setup_drop[];
   ArrayResize(none_drop, H3_STATE_FIELD_COUNT);
   ArrayResize(all_drop, H3_STATE_FIELD_COUNT);
   ArrayResize(struct_drop, H3_STATE_FIELD_COUNT);
   ArrayResize(setup_drop, H3_STATE_FIELD_COUNT);
   for(int k = 0; k < H3_STATE_FIELD_COUNT; k++)
     {
      none_drop[k] = false;
      all_drop[k] = true;
      struct_drop[k] = (k < H3_STRUCT_FIELD_COUNT);
      setup_drop[k] = (k >= H3_STRUCT_FIELD_COUNT);
     }
   Check(se.flag == H3_FLAG_LIMITED && T3Contains(se.reason, "AB_STRUCTURE_DIFF") && !T3EqualWithout(va, vb, none_drop) && T3EqualWithout(va, vb, all_drop),
         "R18 mutation: the SC-1 comparison flags the difference, and with EVERY compared term removed it would call the windows equal (so the SC-1 test really guards the comparison)");
   Check(!T3EqualWithout(va, vb, setup_drop) && !T3EqualWithout(va, vb, struct_drop),
         "R17: SC-1 differs in BOTH layers (STRUCTURE and SETUP), each layer alone is enough to flag it");
   //--- R22: variant A limit - the STRUCTURE agrees, the SETUP differs (a documented limit, not a pass)
   string r22n[] = {"r22_variant_a_limit", "m_r22_variant_a_limit"};
   for(int q22 = 0; q22 < 2; q22++)
     {
      MqlRates xb[];
      int xn, xk;
      SH3Params xp;
      string xex;
      SH3Eval xe;
      SH3Track xtr[];
      SH3Event xev[];
      T3Get(r22n[q22], xb, xn, xk, xp, xex);
      H3Evaluate(xb, xn, xp, xe, xtr, xev);
      SH3Rep xa;
      SH3Rep xr;
      SH3Track xta[];
      SH3Track xtb[];
      SH3Event xea[];
      SH3Event xeb[];
      string xka[];
      string xkb[];
      H3Replay(xb, xn, xp, xa, xta, xea, xka, false);
      MqlRates xs[];
      T3Slice(xb, xn - xe.b_depth, xe.b_depth, xs);
      H3Replay(xs, xe.b_depth, xp, xr, xtb, xeb, xkb, false);
      Check(xe.flag == H3_FLAG_LIMITED && T3Contains(xe.reason, "AB_SETUP_DIFF") && !T3Contains(xe.reason, "AB_STRUCTURE_DIFF") &&
            H3StructKey(xa.st) == H3StructKey(xr.st) && xa.st.setup_type == "WICK" && xr.st.setup_type != "WICK",
            (q22 == 0 ? "SELL " : "BUY ") + "R22: variant A limit - same BIAS and PL in both windows, but A holds the old WICK setup and B has none (AB_SETUP_DIFF, no AB_STRUCTURE_DIFF): LIMITED, a documented limit");
     }
   //--- single-field mutations of a real state (SELL series s_recon_two_fvg)
   MqlRates mb[];
   int mn, mkind;
   SH3Params mp;
   string mex;
   SH3Rep mr;
   SH3Track mtr[];
   SH3Event mev[];
   string mk[];
   T3Get("s_recon_two_fvg", mb, mn, mkind, mp, mex);
   H3Replay(mb, mn, mp, mr, mtr, mev, mk, false);
   SH3State s2;
   H3StateInit(s2);
   SH3Track t2[];
   int live = T3LiveTrack(mtr, mr.nt);
   H3StateCopy(mr.st, s2);
   ArrayResize(t2, mr.nt);
   for(int a1 = 0; a1 < mr.nt; a1++)
      H3TrackCopy(mtr[a1], t2[a1]);
   Check(live >= 0 && T3Reasons(mr.st, mtr, mr.nt, s2, t2, mr.nt) == "", "mutation base: an unchanged copy gives no reason");
   H3StateCopy(mr.st, s2);
   s2.wait_start = s2.wait_start + (datetime)T3_PERIOD;
   Check(T3Reasons(mr.st, mtr, mr.nt, s2, t2, mr.nt) == "AB_SETUP_DIFF", "R17/R20: a different wait_start (decides which touches count after RECONF_LOST) is flagged: AB_SETUP_DIFF");
   H3StateCopy(mr.st, s2);
   s2.src_time = s2.src_time + (datetime)T3_PERIOD;
   Check(T3Reasons(mr.st, mtr, mr.nt, s2, t2, mr.nt) == "AB_SETUP_DIFF", "R17: a different wick / sweep source time is flagged: AB_SETUP_DIFF");
   H3StateCopy(mr.st, s2);
   t2[live].lower = t2[live].lower - 1.0;
   Check(T3Reasons(mr.st, mtr, mr.nt, s2, t2, mr.nt) == "AB_SETUP_DIFF", "R17: a different FVG bound is flagged: AB_SETUP_DIFF");
   t2[live].lower = mtr[live].lower;
   t2[live].conf = t2[live].conf + (datetime)T3_PERIOD;
   Check(T3Reasons(mr.st, mtr, mr.nt, s2, t2, mr.nt) == "AB_SETUP_DIFF", "R17: a different FVG confirm time is flagged: AB_SETUP_DIFF");
   t2[live].conf = mtr[live].conf;
   t2[live].recorded = !t2[live].recorded;
   Check(T3Reasons(mr.st, mtr, mr.nt, s2, t2, mr.nt) == "AB_SETUP_DIFF", "R17: a different candidate (track) state is flagged: AB_SETUP_DIFF");
   t2[live].recorded = mtr[live].recorded;
   s2.setup_id = "WICK@000000000000#X";
   Check(T3Reasons(mr.st, mtr, mr.nt, s2, t2, mr.nt) == "AB_SETUP_DIFF", "R17: a different setup_id is flagged: AB_SETUP_DIFF");
   H3StateCopy(mr.st, s2);
   s2.ex_consumed = !s2.ex_consumed;
   Check(T3Reasons(mr.st, mtr, mr.nt, s2, t2, mr.nt) == "AB_STRUCTURE_DIFF", "R21: a different consumed flag of the pending continuation (HH/LL) candidate is flagged: AB_STRUCTURE_DIFF alone");
   H3StateCopy(mr.st, s2);
   s2.li_consumed = !s2.li_consumed;
   Check(T3Reasons(mr.st, mtr, mr.nt, s2, t2, mr.nt) == "AB_STRUCTURE_DIFF", "R21: a different consumed flag of the pending interior candidate is flagged: AB_STRUCTURE_DIFF alone");
   H3StateCopy(mr.st, s2);
   s2.lv_known = s2.lv_known + (datetime)T3_PERIOD;
   bool k1 = (T3Reasons(mr.st, mtr, mr.nt, s2, t2, mr.nt) == "AB_STRUCTURE_DIFF");
   H3StateCopy(mr.st, s2);
   s2.lv_price = s2.lv_price + 1.0;
   bool k2 = (T3Reasons(mr.st, mtr, mr.nt, s2, t2, mr.nt) == "AB_STRUCTURE_DIFF");
   Check(k1 && k2, "R17: a different level known time or price is flagged: AB_STRUCTURE_DIFF alone");
   H3StateCopy(mr.st, s2);
   s2.dir = -s2.dir;
   Check(T3Reasons(mr.st, mtr, mr.nt, s2, t2, mr.nt) == "AB_STRUCTURE_DIFF", "R17: a different bias is flagged: AB_STRUCTURE_DIFF");
   H3StateCopy(mr.st, s2);
   s2.origin = (s2.origin == H3_ORG_SEED ? H3_ORG_BREAK : H3_ORG_SEED);
   s2.origin_ref = s2.origin_ref + (datetime)T3_PERIOD;
   s2.wk_retro = !s2.wk_retro;
   s2.none_reason = H3_NR_CONFLICT;
   s2.snap_price = s2.snap_price + 1.0;
   s2.bias_start = s2.bias_start + (datetime)T3_PERIOD;
   s2.t2dir = "MIXED";
   s2.pre = "X";
   Check(T3Reasons(mr.st, mtr, mr.nt, s2, t2, mr.nt) == "",
         "R19: provenance-only differences (origin name, origin_ref, retro, none_reason, snapshot price, bias_start after a level exists, T002 text) give NO AB reason: reliable");
   SH3State u1;
   SH3State u2;
   SH3Track none_t[];
   H3StateInit(u1);
   H3StateInit(u2);
   u1.dir = H3_BEAR;
   u1.bias_start = T3Base();
   u2.dir = H3_BEAR;
   u2.bias_start = T3Base() + (datetime)T3_PERIOD;
   bool nolv_diff = (H3StructKey(u1) != H3StructKey(u2));
   u1.has_level = true;
   u2.has_level = true;
   bool lv_same = (H3StructKey(u1) == H3StructKey(u2));
   Check(nolv_diff && lv_same, "R20: bias_start is compared while the bias has NO level and is provenance once a level exists");
   //--- R19 at replay level (the comparison function used by H3Evaluate): origin NAME only
   MqlRates pb[];
   int pn, pkind;
   SH3Params pp2;
   string pex;
   T3Get("p16b_ab_difference", pb, pn, pkind, pp2, pex);
   SH3Rep pa;
   SH3Rep pbr;
   SH3Track pta[];
   SH3Track ptb[];
   SH3Event pea[];
   SH3Event peb[];
   string pka[];
   string pkb[];
   H3Replay(pb, pn, pp2, pa, pta, pea, pka, false);
   MqlRates pbb[];
   T3Slice(pb, 20, pn - 20, pbb);
   H3Replay(pbb, pn - 20, pp2, pbr, ptb, peb, pkb, false);
   int seed_b = T3FirstEvent(peb, pbr.ne, H3_EV_SEED);
   string org_note;
   string why19 = H3AbCompare(pa, pta, pea, pbr, ptb, peb, peb[seed_b].bar_time + (datetime)T3_PERIOD, (datetime)4000000000, 0, "", org_note);
   Check(why19 == "" && org_note == "ORG_DIFF A=BREAK B=SEED",
         "R19: origin differs only by NAME (A BREAK, B SEED), same level, setup, candidates and events afterwards: no AB_* reason, ORG_DIFF reported");
  }

void TestRevision10b(void)
  {
   Print("--- 28b. property tests on deterministic random SYNTHETIC paths (own generator; no real data)");
   SH3Params p;
   H3ParamsDefault(p);
   p.lookback = 20;
   p.rebuild = 1000;
   bool mono_ok = true;
   bool setup_level_ok = true;
   bool reasons_ok = true;
   bool ids_ok = true;
   bool snap_ok = true;
   int n_setups = 0;
   int n_paths = 30;
   for(int seed = 0; seed < n_paths; seed++)
     {
      MqlRates b[];
      int n;
      T3RandBars(seed, 260, b, n);
      SH3Rep r;
      SH3Track tr[];
      SH3Event ev[];
      string keys[];
      H3Replay(b, n, p, r, tr, ev, keys, true);
      string prev_bias = "";
      double prev_price = 0.0;
      string retired = "|";
      string live = "";
      for(int t = 0; t < n; t++)
        {
         string bias = T3BiasOfKey(keys[t]);
         bool hl = (T3LvIdOfKey(keys[t]) != "-");
         double lp = T3LvPriceOfKey(keys[t]);
         if(bias != "BIAS=NONE" && hl)
           {
            if(bias == prev_bias && prev_price != 0.0)
              {
               int sg = (bias == "BIAS=BEAR" ? 1 : -1);
               if(sg * lp > sg * prev_price + 0.000000001)
                  mono_ok = false;
              }
            prev_price = lp;
           }
         else
            prev_price = 0.0;
         prev_bias = bias;
         string ph = T3KeyField(keys[t], "PH");
         if(bias != "BIAS=NONE" && ph != "ACTIVE" && !hl)
            setup_level_ok = false;
         string sid = T3KeyField(keys[t], "SU");
         if(sid == "-")
            sid = "";
         if(sid != "" && sid != live)
           {
            if(StringFind(retired, "|" + sid + "|") >= 0)
               ids_ok = false;
            if(live != "")
               retired += live + "|";
            live = sid;
            n_setups++;
           }
         if(sid == "" && live != "")
           {
            retired += live + "|";
            live = "";
           }
        }
      for(int e = 0; e < r.ne; e++)
        {
         if(ev[e].type == H3_EV_SNAP_CROSSED)
            snap_ok = false;
         if(ev[e].type == H3_EV_SETUP_ENDED && StringFind(ev[e].detail, "reason=INVALIDATED_BY_FLIP") != 0 && StringFind(ev[e].detail, "reason=REPLACED") != 0)
            reasons_ok = false;
        }
     }
   Check(mono_ok, "R2 (property, " + IntegerToString(n_paths) + " paths): inside a bias the protecting level never retreats against the trend");
   Check(snap_ok, "R14 (property): SNAPSHOT_CROSSED never occurs with the ratchet");
   Check(setup_level_ok && n_setups > 10, "invariant (property): a setup never exists without a protecting level (" + IntegerToString(n_setups) + " setups seen)");
   Check(reasons_ok && ids_ok, "R6/R16 (property): SETUP_ENDED has only the reasons INVALIDATED_BY_FLIP and REPLACED; a retired setup_id never comes back");
   //--- R6: no arbitrary expiry
   MqlRates qb[];
   int qn, qk;
   SH3Params qp;
   string qex;
   SH3Rep qr;
   SH3Track qtr[];
   SH3Event qev[];
   string qkeys[];
   T3Get("r6_quiet_150", qb, qn, qk, qp, qex);
   H3Replay(qb, qn, qp, qr, qtr, qev, qkeys, false);
   Check(qr.st.phase == H3_PH_HOLD && StringFind(qr.st.setup_id, "WICK@") == 0 && T3CountEvents(qev, qr.ne, H3_EV_SETUP_ENDED) == 0,
         "R6: a setup is never ended by age: after 150 quiet bars it is still HOLD (no expiry of any kind)");
  }

//--- same prices, new open times: mode 0 contiguous, 1 weekend (6 bars a day, 5 days a week), 2 gap of 3 slots after bar 26,
//--- 3 gap of 12 slots after bar gap_after
void T3Retime(const MqlRates &src[], const int n, const int mode, const int gap_after, MqlRates &dst[])
  {
   ArrayResize(dst, n);
   for(int i = 0; i < n; i++)
     {
      int slot = i;
      if(mode == 1)
        {
         int q = 4 + i;
         slot = (q / 30) * 42 + (q % 30);
        }
      if(mode == 2 && i >= 26)
         slot = i + 3;
      if(mode == 3 && i > gap_after)
         slot = i + 12;
      dst[i] = src[i];
      dst[i].time = T3Base() + (datetime)(slot * T3_PERIOD);
     }
  }

void TestWeekendRight(void)
  {
   Print("--- 28c. confirm_time and known-bar usage across weekends and gaps with RightBars 1, 2, 3");
   MqlRates base[];
   int n, kind;
   SH3Params p;
   string ex;
   T3Get("p16a_converged_break", base, n, kind, p, ex);
   string lab[] = {"contiguous", "weekend", "gap"};
   for(int right = 1; right <= 3; right++)
     {
      for(int mode = 0; mode < 3; mode++)
        {
         MqlRates bars[];
         T3Retime(base, n, mode, 0, bars);
         SH4Swing sw[];
         int amb = 0;
         int ns = H4FindSwings(bars, n, 2, right, T3_PERIOD, sw, amb);
         bool ok = (ns > 3);
         for(int i = 0; i < ns; i++)
           {
            if(sw[i].confirm_time != bars[sw[i].index + right].time + (datetime)T3_PERIOD)
               ok = false;
           }
         Check(ok, "right=" + IntegerToString(right) + " " + lab[mode] + ": every swing confirm_time = open time of the real bar index+RightBars plus one period");
         bool ok2 = true;
         for(int t = 1; t < n; t++)
           {
            int by_index = H3KnownCount(sw, ns, right, t - 1);
            int by_time = 0;
            for(int j = 0; j < ns; j++)
              {
               if(sw[j].confirm_time <= bars[t].time)
                  by_time++;
              }
            if(by_index != by_time)
               ok2 = false;
           }
         Check(ok2, "right=" + IntegerToString(right) + " " + lab[mode] + ": for every bar t the swings known before it (by index) are exactly those with confirm_time <= open(t)");
        }
      //--- control: a gap right after a pivot makes the arithmetic pivot_time + (Right+1) periods wrong by the whole gap
      MqlRates cb[];
      T3Retime(base, n, 0, 0, cb);
      SH4Swing sw0[];
      int amb0 = 0;
      int ns0 = H4FindSwings(cb, n, 2, right, T3_PERIOD, sw0, amb0);
      int pidx = -1;
      for(int i2 = 0; i2 < ns0 && pidx < 0; i2++)
        {
         if(sw0[i2].index >= 6)
            pidx = sw0[i2].index;
        }
      MqlRates gb[];
      T3Retime(base, n, 3, pidx, gb);
      SH4Swing swg[];
      int ambg = 0;
      int nsg = H4FindSwings(gb, n, 2, right, T3_PERIOD, swg, ambg);
      bool hit_ok = false;
      for(int i3 = 0; i3 < nsg; i3++)
        {
         if(swg[i3].index == pidx)
           {
            datetime naive = swg[i3].pivot_time + (datetime)((right + 1) * T3_PERIOD);
            hit_ok = (swg[i3].confirm_time == gb[pidx + right].time + (datetime)T3_PERIOD && swg[i3].confirm_time != naive &&
                      (long)swg[i3].confirm_time - (long)naive == 12 * T3_PERIOD);
           }
        }
      Check(pidx >= 0 && hit_ok,
            "right=" + IntegerToString(right) + " gap right after a pivot (control): confirm_time is the real bar plus one period; pivot_time + " + IntegerToString(right + 1) +
            " periods would be wrong by the whole 12-period gap");
     }
  }

void TestSetupContext(void)
  {
   Print("--- 28d. read-only setup context for the next module (no M15_OUTCOME mechanism)");
   MqlRates b[];
   int n, kind;
   SH3Params p;
   string ex;
   SH3Rep r;
   SH3Track tr[];
   SH3Event ev[];
   string keys[];
   SH3SetupCtx c;
   T3Get("r10_retouch", b, n, kind, p, ex);
   H3Replay(b, n, p, r, tr, ev, keys, false);
   H3SetupContext(r.st, tr, r.nt, c);
   string before = H3ReplayText(r, tr, ev);
   string ctx1 = H3SetupContextText(c);
   Check(c.valid && c.ready && c.direction == "BEAR" && c.reason == "STRUCT" && c.stype == "WICK" && c.setup_id == r.st.setup_id &&
         c.fvg_id == r.st.rec_id && c.fvg_lower < c.fvg_upper && c.live_id == r.st.lv_id && c.snap_id != "" && c.valid_from >= c.wait_start,
         "RECONFIRMED setup: the context carries setup_id, direction, reason, snapshot, live level, FVG id and bounds, valid-from and ready");
   SH3SetupCtx c2;
   H3SetupContext(r.st, tr, r.nt, c2);
   Check(H3ReplayText(r, tr, ev) == before && H3SetupContextText(c2) == ctx1, "the context is read-only: reading it changes nothing");
   T3Get("r10_hold", b, n, kind, p, ex);
   H3Replay(b, n, p, r, tr, ev, keys, false);
   H3SetupContext(r.st, tr, r.nt, c);
   Check(c.valid && !c.ready && c.fvg_id == "" && c.live_id != c.snap_id && c.reason == "STRUCT",
         "HOLD: not ready, no FVG; the live level (advanced) differs from the snapshot (reference only)");
   T3Get("r10_sweep", b, n, kind, p, ex);
   H3Replay(b, n, p, r, tr, ev, keys, false);
   H3SetupContext(r.st, tr, r.nt, c);
   Check(c.valid && !c.ready && c.reason == "INTERNAL" && c.stype == "SWEEP", "SWEEP_WAIT: reason INTERNAL, not ready");
   T3Get("c_history", b, n, kind, p, ex);
   H3Replay(b, n, p, r, tr, ev, keys, false);
   H3SetupContext(r.st, tr, r.nt, c);
   Check(!c.valid && H3SetupContextText(c) == "CTX=-" && !c.ready, "no setup (phase ACTIVE): the context is empty and not ready");
   int m15 = 0;
   for(int i = 0; i < T3_CASE_COUNT; i++)
     {
      MqlRates cb[];
      int cn, ck, lb, rb, cap;
      string nm, cex;
      T3LoadCase(i, cb, cn, ck, lb, rb, cap, nm, cex);
      if(ck != 0)
         continue;
      if(StringFind(cex, "M15_OUTCOME") >= 0 || StringFind(cex, "SUPERSEDED_BY_STRUCTURE") >= 0)
         m15++;
     }
   Check(m15 == 0, "M15_OUTCOME and SUPERSEDED_BY_STRUCTURE are NOT implemented: no transcript carries them (no mechanism is defined)");
  }

//+------------------------------------------------------------------+
//| 23. FINDING 1: anchor located by EXISTING bars                   |
//+------------------------------------------------------------------+
void TestAnchorByBars(void)
  {
   Print("--- 23. FINDING 1: anchor located by EXISTING bars (weekend, history gap, window start)");
   MqlRates b[];
   int n, kind;
   SH3Params p;
   string ex;
   SH3Eval e0;
   SH3Eval e;
   SH3Track tr[];
   SH3Event ev[];
   SH3Event ev0[];
   datetime refs[];
   T3Get("p16a_converged_break", b, n, kind, p, ex);
   H3Evaluate(b, n, p, e0, tr, ev0);
   int nr = H3AnchorRefs(e0.st, refs);
   datetime r0 = refs[0];
   for(int i = 1; i < nr; i++)
     {
      if(refs[i] < r0)
         r0 = refs[i];
     }
   Check(e0.reliable && e0.anchor == r0 - (datetime)(2 * T3_PERIOD),
         "contiguous series: the anchor equals the old arithmetic result (2 existing bars before the earliest reference)");
   string names[] = {"f1_weekend_gap", "f1_history_gap"};
   string labels[] = {"weekend gap", "history gap (3 missing bars)"};
   for(int c = 0; c < 2; c++)
     {
      T3Get(names[c], b, n, kind, p, ex);
      H3Evaluate(b, n, p, e, tr, ev);
      nr = H3AnchorRefs(e.st, refs);
      datetime rmin = refs[0];
      for(int k = 1; k < nr; k++)
        {
         if(refs[k] < rmin)
            rmin = refs[k];
        }
      int ix = H3BarIndexByTime(b, n, rmin);
      datetime old = rmin - (datetime)(2 * T3_PERIOD);
      Check(e.reliable && ix >= 2 && e.anchor == b[ix - 2].time && T3IndexOfTime(b, n, e.anchor) >= 0 && e.anchor_missing == "",
            labels[c] + ": the anchor is the open time of the 2nd EXISTING bar before the reference");
      Check(T3IndexOfTime(b, n, old) < 0 && e.anchor != old,
            labels[c] + ": control: the old arithmetic result (reference minus 2 periods) is not a bar of the series");
      bool same_ev = (e.ne == e0.ne && e.flag == e0.flag && e.st.dir == e0.st.dir);
      for(int q = 0; q < e.ne && q < e0.ne; q++)
        {
         if(ev[q].type != ev0[q].type)
            same_ev = false;
        }
      Check(same_ev, labels[c] + ": same structure and events as the contiguous series (only the absolute times differ)");
     }
   //--- window start, holes, several references (crafted state, crafted series)
   SH3Params pp;
   H3ParamsDefault(pp);
   MqlRates bars[];
   int nb = 0;
   for(int j = 0; j < 10; j++)
      T3AddBar(bars, nb, T3Base() + (datetime)(j * T3_PERIOD), 110.0, 100.0, 105.0);
   SH3State st;
   H3StateInit(st);
   st.dir = H3_BULL;
   string miss;
   st.origin_ref = bars[2].time;
   datetime a = H3AnchorTime(st, pp, bars, nb, miss);
   Check(a == bars[0].time && miss == "", "window start: a reference with exactly Left bars before it anchors at the first bar");
   st.origin_ref = bars[1].time;
   a = H3AnchorTime(st, pp, bars, nb, miss);
   Check(a == 0 && StringFind(miss, "ANCHOR_NEEDS_2_BARS_BEFORE") == 0,
         "window start: one bar fewer than Left: missing history reported, no time fabricated (anchor 0)");
   st.origin_ref = bars[0].time;
   a = H3AnchorTime(st, pp, bars, nb, miss);
   Check(a == 0 && StringFind(miss, "ANCHOR_NEEDS_2_BARS_BEFORE") == 0, "window start: a reference at the very first bar: missing history");
   st.origin_ref = bars[5].time + 3600;
   a = H3AnchorTime(st, pp, bars, nb, miss);
   Check(a == 0 && StringFind(miss, "ANCHOR_REF_NOT_IN_SERIES") == 0,
         "a reference that is not in the series: missing history reported, no time fabricated");
   MqlRates hole[];
   int nh = 0;
   for(int h = 0; h < 10; h++)
     {
      if(h != 4)
         T3AddBar(hole, nh, bars[h].time, 110.0, 100.0, 105.0);
     }
   st.origin_ref = bars[4].time;
   a = H3AnchorTime(st, pp, hole, nh, miss);
   Check(a == 0 && StringFind(miss, "ANCHOR_REF_NOT_IN_SERIES") == 0,
         "history gap on the reference bar itself: the reference is missing, reported");
   st.origin_ref = bars[6].time;
   a = H3AnchorTime(st, pp, hole, nh, miss);
   Check(a == bars[3].time && miss == "", "a hole before the reference: the Left existing bars are used (the missing slot is skipped)");
   st.origin_ref = bars[8].time;
   st.has_level = true;
   st.lv_pivot = bars[6].time;
   st.lv_ext = bars[7].time;
   st.lv_prev = bars[3].time;
   a = H3AnchorTime(st, pp, bars, nb, miss);
   Check(a == bars[1].time && miss == "", "several references: the earliest anchor wins");
   st.lv_prev = bars[1].time;
   a = H3AnchorTime(st, pp, bars, nb, miss);
   Check(a == 0 && miss != "", "several references: one reference without Left bars before it makes the anchor missing (never partial)");
   //--- which references count. REWRITTEN in revision 10: there is no frozen branch any more; the references are the
   //--- origin, the level's pivots, the source wick of a structural setup and the sweep of an internal one.
   SH3Rep r;
   string keys[];
   T3Get("s_recon_later_swing", b, n, kind, p, ex);
   H3Replay(b, n, p, r, tr, ev, keys, false);
   nr = H3AnchorRefs(r.st, refs);
   Check(T3InTimes(refs, nr, r.st.sweep_time) && T3InTimes(refs, nr, r.st.lv_pivot) && T3InTimes(refs, nr, r.st.origin_ref) &&
         !T3InTimes(refs, nr, r.st.wk_src),
         "RECONFIRMED(INTERNAL): the references are the origin, the (live) level pivots and the sweep");
   T3Get("w_wick", b, n, kind, p, ex);
   H3Replay(b, n, p, r, tr, ev, keys, false);
   nr = H3AnchorRefs(r.st, refs);
   Check(T3InTimes(refs, nr, r.st.wk_src) && T3InTimes(refs, nr, r.st.lv_pivot) && T3InTimes(refs, nr, r.st.origin_ref) &&
         !T3InTimes(refs, nr, 0), "HOLD: the references are the origin, the level pivots and the source wick");
   T3Get("s_recon_thaw", b, n, kind, p, ex);
   H3Replay(b, n, p, r, tr, ev, keys, false);
   nr = H3AnchorRefs(r.st, refs);
   Check(T3InTimes(refs, nr, r.st.origin_ref) && T3InTimes(refs, nr, r.st.sweep_time) && T3InTimes(refs, nr, r.st.lv_pivot),
         "SWEEP_WAIT: the references are the origin, the level pivots and the sweep");
   //--- the reliability rule
   Check(H3AbReasons("S", "S", "U", "U", "E", "E", H3_BULL, 0, 50, "ANCHOR_NEEDS_2_BARS_BEFORE x") == "ANCHOR_HISTORY_MISSING",
         "missing anchor history: LIMITED_BY_HISTORY with its own reason (not reported as a warm-up case)");
   Check(H3AbReasons("S1", "S2", "U", "U", "E", "E", H3_BULL, 0, 50, "m") == "AB_STRUCTURE_DIFF+ANCHOR_HISTORY_MISSING",
         "missing anchor history combines with the other reasons in the fixed order");
   Check(H3AbReasons("S", "S", "U", "U", "E", "E", H3_NONE, 0, 50, "m") == "", "NONE has no anchor: missing-history text cannot make it LIMITED");
   T3Get("p16c_anchor_warmup", b, n, kind, p, ex);
   H3Evaluate(b, n, p, e, tr, ev);
   Check(!e.reliable && e.reason == "ANCHOR_IN_WARMUP" && e.anchor == b[0].time && e.anchor_missing == "",
         "reference close to the start of the series (Left bars exist): the anchor is the first bar and the case is LIMITED by the warm-up rule");
  }

//+------------------------------------------------------------------+
//| 24. diagnostics (behaviour neutral): ordered fields, first       |
//| differing field/event, windows, anchors, level undefined         |
//+------------------------------------------------------------------+
string T3JoinFields(const SH3State &st, const SH3Track &tr[], const int nt)
  {
   string lab[];
   string val[];
   H3StateFields(st, tr, nt, lab, val);
   string out = "";
   for(int i = 0; i < H3_STATE_FIELD_COUNT; i++)
     {
      if(i > 0)
         out += ";";
      out += lab[i] + "=" + val[i];
     }
   return(out);
  }

//--- evaluation plus diagnostics of a named case (uses the case's own parameters)
bool T3DiagOf(const string name, SH3Eval &e, SH3Diag &d, MqlRates &bars[], int &n, SH3Params &p)
  {
   int kind;
   string ex;
   if(!T3Get(name, bars, n, kind, p, ex))
      return(false);
   SH3Track tr[];
   SH3Event ev[];
   H3Evaluate(bars, n, p, e, tr, ev);
   H3Diagnose(bars, n, p, e, d);
   return(true);
  }

void TestDiagnostics(void)
  {
   Print("--- 24. diagnostics (behaviour neutral): ordered fields, first differing field/event, windows, anchors, level undefined");
   bool join_ok = true;
   bool flips_ok = true;
   int n_r = 0;
   for(int i = 0; i < T3_CASE_COUNT; i++)
     {
      MqlRates b[];
      int n, kind, lb, rb, cap;
      string nm, ex;
      T3LoadCase(i, b, n, kind, lb, rb, cap, nm, ex);
      if(kind != 0)
         continue;
      SH3Params p;
      T3Params(lb, rb, cap, p);
      SH3Rep rep;
      SH3Track tr[];
      SH3Event ev[];
      string keys[];
      H3Replay(b, n, p, rep, tr, ev, keys, false);
      n_r++;
      if(T3JoinFields(rep.st, tr, rep.nt) != H3StateKey(rep.st, tr, rep.nt))
         join_ok = false;
      if(rep.flips_after_run != 0 || rep.n_flips != T3CountEvents(ev, rep.ne, H3_EV_FLIP))
         flips_ok = false;
     }
   Check(join_ok && n_r > 60 && H3FieldOrderText() == "BIAS>LV>EX>LI>BS>SU>PH>SRC>WAIT>REC>RSN>EL",
         "the ordered state fields joined as label=value equal the state key (all replay cases) and follow the documented order");
   Check(flips_ok, "no FLIP is ever dated after a 'bias without a level' run began; flips counted from the events (all replay cases)");
   //--- first differing field = first in the explicit order
   string base[H3_STATE_FIELD_COUNT];
   string v1[H3_STATE_FIELD_COUNT];
   string v2[H3_STATE_FIELD_COUNT];
   string v3[H3_STATE_FIELD_COUNT];
   for(int k = 0; k < H3_STATE_FIELD_COUNT; k++)
     {
      base[k] = "x";
      v1[k] = "x";
      v2[k] = "x";
      v3[k] = "x";
     }
   v1[6] = "y";
   v1[1] = "y";
   v2[11] = "y";
   v2[1] = "y";
   v3[0] = "y";
   v3[11] = "y";
   Check(H3FirstDiffField(base, v1) == 1, "two fields differ (PH, LV): the earlier one in the explicit order (STRUCTURE before SETUP) is named");
   Check(H3FirstDiffField(base, v2) == 1, "two fields differ (LV, EL): LV is named, EL is not");
   Check(H3FirstDiffField(base, v3) == 0 && H3FirstDiffField(base, base) == -1, "BIAS comes first; identical lists give none");
   SH3Track ta[];
   SH3Track tb[];
   ArrayResize(ta, 2);
   ArrayResize(tb, 2);
   ta[0].id = "F1";
   ta[0].invalid = false;
   ta[0].recorded = false;
   ta[1].id = "F2";
   ta[1].invalid = false;
   ta[1].recorded = false;
   tb[0].id = "F1";
   tb[0].invalid = false;
   tb[0].recorded = false;
   tb[1].id = "F2";
   tb[1].invalid = true;
   tb[1].recorded = false;
   Check(H3TrackDiffText(ta, 2, tb, 2) == "track #1 A=F2:FRESH B=F2:INVALID (counts 2 vs 2)" &&
         H3TrackDiffText(ta, 2, ta, 1) == "track #1 A=F2:FRESH B=- (counts 2 vs 1)" && H3TrackDiffText(ta, 2, ta, 2) == "",
         "eligible-FVG tracks: the first differing track, or a count difference, is named; equal lists give nothing");
   //--- p16b (REWRITTEN in revision 10): the origin NAME differs and the first event of the zone differs; every compared field is equal
   SH3Eval e;
   SH3Diag d;
   MqlRates b[];
   int n;
   SH3Params p;
   T3DiagOf("p16b_ab_difference", e, d, b, n, p);
   Check(!d.reliable && d.reason == "AB_EVENT_DIFF+ANCHOR_IN_WARMUP" && d.field_idx < 0 && d.org_diff == "ORG_DIFF A=BREAK B=SEED",
         "p16b: all 12 compared fields are equal, the origin NAME differs (ORG_DIFF A=BREAK B=SEED, provenance)");
   Check(d.event_idx == 0 && StringFind(d.event_a, "INTERNAL_SWEEP@202601130800#") == 0 && StringFind(d.event_b, "SEED@202601120400#") == 0,
         "p16b: the first differing event of the zone is #0, A INTERNAL_SWEEP at 202601130800 versus B SEED at 202601120400 (absolute times)");
   Check(d.a.start == b[0].time && d.a.bars == e.r_eff && d.b.start == b[n - e.b_depth].time && d.b.bars == e.b_depth &&
         d.a.warm_end == b[e.warm].time && d.b.warm_end == b[n - e.b_depth + e.warm].time &&
         d.zone_start == e.trusted_from && d.zone_start == d.b.warm_end,
         "p16b: window starts, bar counts, warm-up end times and the comparison-zone start are the absolute times of the bars used");
   Check(d.a.origin == H3_ORG_BREAK && d.b.origin == H3_ORG_SEED && !d.a.frozen && d.a.anchor_name == "origin" &&
         d.a.anchor < d.a.warm_end && d.a.origin_ref < d.b.start && d.b.start <= d.b.origin_ref,
         "p16b: A's bias was set by a break dated before B starts, B can only seed later; the anchor (via the origin; the frozen branch no longer exists) lies in the warm-up");
   string pl4[];
   H3DiagLines(d, pl4);
   Check(d.common_diff > 0 && d.common_first_diff >= d.b.start &&
         StringFind(pl4[3], "DIAG4 final states A and B: all 12 compared fields equal | ORG_DIFF A=BREAK B=SEED (provenance, not compared)") == 0,
         "p16b: the state keys differ on some common bars (before B seeds) and the report names ORG_DIFF");
   //--- p16e: same final state, only an event differs; level undefined since the flip
   T3DiagOf("p16e_event_only_diff", e, d, b, n, p);
   Check(d.reason == "AB_EVENT_DIFF" && d.field_idx < 0 && StringFind(d.event_a, "FLIP@") == 0 && StringFind(d.event_b, "BREAK_SET@") == 0,
         "p16e: all 12 compared fields equal, the first differing event is A FLIP versus B BREAK_SET");
   Check(d.a.nolv_now && d.b.nolv_now && d.a.nolv_cause == "FLIP" && d.b.nolv_cause == "BREAK_SET" && d.a.nolv_since == d.b.nolv_since &&
         d.a.flips == 1 && d.b.flips == 0 && d.a.flips_after_run == 0 && d.b.flips_after_run == 0 && StringFind(d.a.nolv_why, "NO_CANDIDATE") == 0,
         "p16e: the protecting level stayed UNDEFINED since the flip bar, 0 flips since, the reason is named (no candidate)");
   //--- p16c: anchor in the warm-up only
   T3DiagOf("p16c_anchor_warmup", e, d, b, n, p);
   Check(d.reason == "ANCHOR_IN_WARMUP" && d.field_idx < 0 && d.event_idx < 0 && !d.event_count_diff && d.a.anchor_name == "origin" &&
         d.a.anchor < d.a.warm_end && d.b.anchor >= d.b.start,
         "p16c: only the anchor reason: A's anchor (via origin) lies before A's warm-up end, the final states and the events agree");
   //--- the triple reason on a synthetic series
   T3DiagOf("p16d_limit_r140", e, d, b, n, p);
   Check(d.reason == "AB_STRUCTURE_DIFF+AB_SETUP_DIFF+AB_EVENT_DIFF+ANCHOR_IN_WARMUP" && d.field_label == "BIAS" && d.field_a == "BULL" && d.field_b == "BEAR" &&
         d.a.anchor_ref < d.b.start && d.a.anchor < d.a.warm_end && StringFind(d.event_a, "SEED@") == 0 && StringFind(d.event_b, "SEED@") == 0,
         "p16d r140 (SYNTHETIC): structure, setup and event reasons plus the anchor, as in the owner's observation: A keeps an old BULL bias (no newer bullish leg), B seeds BEAR later");
   //--- count difference, reliable, unavailable
   T3DiagOf("d_diag_count_differs", e, d, b, n, p);
   string lines[];
   H3DiagLines(d, lines);
   Check(d.event_idx < 0 && d.event_count_diff && d.zone_na != d.zone_nb &&
         StringFind(lines[4], "count differs: nA " + IntegerToString(d.zone_na) + " vs nB " + IntegerToString(d.zone_nb)) >= 0,
         "count difference in the comparison zone is reported as 'count differs: nA vs nB' with the first extra event");
   T3DiagOf("p16a_converged_break", e, d, b, n, p);
   H3DiagLines(d, lines);
   Check(d.reliable && d.field_idx < 0 && d.event_idx < 0 && !d.event_count_diff && d.common_diff == 0 && StringFind(lines[0], "DIAG1 RELIABLE reasons=-") == 0,
         "p16a (reliable): fields equal, events identical, keys agree on every common bar");
   MqlRates b1[];
   int n1, kind1;
   SH3Params p1;
   string ex1;
   T3Get("p17_reduced_depth", b1, n1, kind1, p1, ex1);
   SH3Eval e1;
   SH3Track tr1[];
   SH3Event ev1[];
   SH3Diag d1;
   H3Evaluate(b1, 50, p1, e1, tr1, ev1);
   H3Diagnose(b1, 50, p1, e1, d1);
   SH3Eval e2;
   SH3Diag d2;
   H3Evaluate(b1, 0, p1, e2, tr1, ev1);
   H3Diagnose(b1, 0, p1, e2, d2);
   string l1[];
   string l2[];
   int c1 = H3DiagLines(d1, l1);
   int c2 = H3DiagLines(d2, l2);
   Check(!d1.valid && !d2.valid && c1 == 1 && c2 == 1 && l1[0] == "DIAG1 no replay ran: SHORT_HISTORY (bars available 50)" &&
         l2[0] == "DIAG1 no replay ran: NO_BARS (bars available 0)",
         "SHORT_HISTORY and a failed copy: no replay ran, the report says so in one line");
   //--- level undefined right after a flip (replay level)
   MqlRates fb[];
   int fn, fkind;
   SH3Params fp;
   string fex;
   T3Get("s_no_level_after_flip", fb, fn, fkind, fp, fex);
   SH3Rep fr;
   SH3Track ft[];
   SH3Event fe[];
   string fk[];
   H3Replay(fb, fn, fp, fr, ft, fe, fk, false);
   int fi = -1;
   datetime flip_t = 0;
   for(int q = 0; q < fr.ne; q++)
     {
      if(fe[q].type == H3_EV_FLIP && flip_t == 0)
        {
         flip_t = fe[q].bar_time;
         fi = T3IndexOfTime(fb, fn, flip_t);
        }
     }
   SH3Rep fr2;
   H3Replay(fb, fi + 2, fp, fr2, ft, fe, fk, false);
   Check(fi > 0 && fr2.st.dir != H3_NONE && !fr2.st.has_level && fr2.nolv_cause == "FLIP" && fr2.nolv_run_start == flip_t &&
         fr2.flips_after_run == 0 && fr2.nolv_run_bars == 2 && fr2.n_flips == 1 && fr2.nolv_runs >= 1,
         "s_no_level_after_flip: right after the FLIP the replay has a bias without a level since the flip bar (run of 2 bars), no flip since");
   H3Replay(fb, fn, fp, fr2, ft, fe, fk, false);
   Check(fr2.st.has_level && fr2.nolv_run_start == 0 && fr2.nolv_runs >= 1 && fr2.nolv_total >= 2,
         "s_no_level_after_flip: when a level is defined again the run is closed (counted in runs and total, not 'now')");
   //--- anchor binding equals the anchor of the evaluation; the diagnostics change nothing
   bool anch_ok = true;
   bool same = true;
   int n_anch = 0;
   for(int i2 = 0; i2 < T3_CASE_COUNT; i2++)
     {
      MqlRates xb[];
      int xn, xkind, xlb, xrb, xcap;
      string xnm, xex;
      T3LoadCase(i2, xb, xn, xkind, xlb, xrb, xcap, xnm, xex);
      if(xkind == 0)
         continue;
      SH3Params xp;
      T3Params(xlb, xrb, xcap, xp);
      SH3Eval xe;
      SH3Track xt[];
      SH3Event xv[];
      H3Evaluate(xb, xn, xp, xe, xt, xv);
      string t_before = H3EvalText(xe, xt, xv);
      SH3Diag xd;
      H3Diagnose(xb, xn, xp, xe, xd);
      SH3Eval xe2;
      H3Evaluate(xb, xn, xp, xe2, xt, xv);
      if(H3EvalText(xe2, xt, xv) != t_before)
         same = false;
      if(!xe.has_state)
         continue;
      n_anch++;
      if(xd.a.anchor != xe.anchor || xd.a.anchor_missing != xe.anchor_missing)
         anch_ok = false;
     }
   Check(anch_ok && n_anch > 15, "the anchor reported by the diagnostics (with the reference that binds it) equals the anchor of the evaluation");
   Check(same, "calling the diagnostics does not change any evaluation (all E and D cases)");
   //--- no lookahead: later bars replaced by garbage give the same report
   MqlRates gb[];
   int gn, gkind;
   SH3Params gp;
   string gex;
   T3Get("p16b_ab_difference", gb, gn, gkind, gp, gex);
   int nn = gn - 6;
   gp.rebuild = nn;
   SH3Eval g1;
   SH3Eval g2;
   SH3Track gt[];
   SH3Event gv[];
   SH3Diag gd1;
   SH3Diag gd2;
   H3Evaluate(gb, nn, gp, g1, gt, gv);
   H3Diagnose(gb, nn, gp, g1, gd1);
   MqlRates gc[];
   T3Slice(gb, 0, gn, gc);
   for(int z = nn; z < gn; z++)
     {
      gc[z].high = 9999.0;
      gc[z].low = -9999.0;
      gc[z].close = 5000.0;
     }
   H3Evaluate(gc, nn, gp, g2, gt, gv);
   H3Diagnose(gc, nn, gp, g2, gd2);
   Check(H3DiagText(gd1) == H3DiagText(gd2), "the diagnostics read only bars[0..n_avail-1] (later bars replaced by garbage give the same report)");
  }

//+------------------------------------------------------------------+
//| 25. TrackChanges decision after GAP / RE-DERIVATION               |
//+------------------------------------------------------------------+
void TestTrackChanges(void)
  {
   Print("--- 25. TrackChanges after GAP / RE-DERIVATION: a rebuild difference is never a market change");
   Check(H3TrackChangesMode(H3_C_OK, true) == H3_TC_REPORT && H3TrackChangesMode(H3_C_REDERIVED, true) == H3_TC_REDERIVE &&
         H3TrackChangesMode(H3_C_GAP, true) == H3_TC_REDERIVE && H3TrackChangesMode(H3_C_NOTHING_NEW, true) == H3_TC_REDERIVE &&
         H3TrackChangesMode(H3_C_OK, false) == H3_TC_BASELINE && H3TrackChangesMode(H3_C_BASELINE, true) == H3_TC_BASELINE &&
         H3TrackChangesMode(H3_C_GAP, false) == H3_TC_BASELINE,
         "decision table: only OK with a previous snapshot reports; REDERIVED, GAP and NOTHING_NEW re-derive silently; no snapshot or a baseline stores it");
   MqlRates base[];
   int nb, kind;
   SH3Params p;
   string ex;
   T3Get("p16a_converged_break", base, nb, kind, p, ex);
   SH3Params pc;
   T3Params(20, 1000, 5000, pc);
   MqlRates allb[];
   int na = 0;
   for(int i = 0; i < nb; i++)
      T3AddBar(allb, na, base[i].time, base[i].high, base[i].low, base[i].close);
   T3AddBar(allb, na, base[nb - 1].time + (datetime)T3_PERIOD, 135.0, 104.0, 112.0);
   T3AddBar(allb, na, base[nb - 1].time + (datetime)(2 * T3_PERIOD), 115.0, 105.0, 110.0);
   T3AddBar(allb, na, base[nb - 1].time + (datetime)(3 * T3_PERIOD), 116.0, 106.0, 111.0);
   SH3Eval e0;
   SH3Eval e1;
   SH3Eval e3;
   SH3Track tr[];
   SH3Event ev0[];
   SH3Event ev1[];
   SH3Event ev3[];
   SH3Event out[];
   int nout;
   H3EvaluateLatest(base, nb, pc, e0, tr, ev0);
   datetime cur = H3BaselineCursor(e0);
   H3EvaluateLatest(allb, nb + 1, pc, e1, tr, ev1);
   int s1 = H3ConsumeNew(e1, ev1, cur, T3_PERIOD, out, nout);
   Check(s1 == H3_C_OK && H3TrackChangesMode(s1, true) == H3_TC_REPORT && e1.st.phase == H3_PH_HOLD && e0.st.phase == H3_PH_ACTIVE,
         "the next closed bar (the wick) is an OK step: the PHASE change ACTIVE -> HOLD is reportable at that bar");
   H3EvaluateLatest(allb, na, pc, e3, tr, ev3);
   int s3 = H3ConsumeNew(e3, ev3, cur, T3_PERIOD, out, nout);
   Check(s3 == H3_C_GAP && H3TrackChangesMode(s3, true) == H3_TC_REDERIVE && e3.st.phase == H3_PH_HOLD,
         "bars were missed (GAP): the same phase difference arrives as a GAP step, which the EA treats as a re-derivation, never as a market change");
  }

//+------------------------------------------------------------------+
//| 26. candle export text building                                   |
//+------------------------------------------------------------------+
void TestCsvExport(void)
  {
   Print("--- 26. candle export (text building)");
   Check(H3CsvName("XAUUSD.r", T3Base() + (datetime)T3_PERIOD) == T3CsvExpectedName() && H3CsvName("XAUUSD", T3Base()) == "velo_t003_diag_XAUUSD_202601050000.csv" &&
         H3CsvName("XAU/USD #1", T3Base()) == "velo_t003_diag_XAU_USD__1_202601050000.csv",
         "file name velo_t003_diag_<symbol>_<last closed bar>.csv; characters outside [A-Za-z0-9._-] become _");
   MqlRates r;
   r.time = T3Base() + (datetime)(40 * T3_PERIOD);
   r.open = 4120.5;
   r.high = 4130.25;
   r.low = 4118.0;
   r.close = 4127.75;
   r.tick_volume = 1234;
   r.spread = 12;
   r.real_volume = 0;
   Check(H3CsvRow(r, 2) == T3CsvExpectedRow(), "a row: epoch, readable server time, open high low close with the symbol digits, tick volume, spread, real volume");
   SH3Export x;
   x.source = "EA";
   x.symbol = "XAUUSD";
   x.mode = "HISTORICAL";
   x.asof = T3Base() + (datetime)(100 * T3_PERIOD);
   x.digits = 2;
   x.period = 14400;
   x.left = 2;
   x.right = 2;
   x.lookback = 300;
   x.rebuild = 1000;
   x.r_req = 1000;
   x.r_eff = 1000;
   x.b_depth = 700;
   x.chk = 300;
   x.warm = 300;
   x.hard_cap = 5000;
   x.bars = 3;
   x.first = T3Base();
   x.last = T3Base() + (datetime)(2 * T3_PERIOD);
   x.flag = "LIMITED_BY_HISTORY";
   x.reason = "AB_STATE_DIFF";
   x.note = "";
   Check(H3CsvHeader(x) == T3CsvExpectedHeader(), "header: symbol, mode, as-of, lookback, rebuild, depths, warm-up, check depth, result, then the column line");
   x.asof = 0;
   x.note = "reduced depth 700 of 1000";
   string h2 = H3CsvHeader(x);
   Check(StringFind(h2, "# asof_input=0\n") >= 0 && StringFind(h2, "# note=reduced depth 700 of 1000\n") >= 0,
         "live mode writes asof_input=0; a note is carried into the header");
  }

void TestDeferred(void)
  {
   Print("--- deferred groups (NOT counted as PASS)");
   Deferred("test 9 (EA lifecycle and reload: no duplicate objects, clear/rebuild as in T002)");
   Deferred("test 18 (intrabar overlay P12: crossing blocks only, wick-only close -> HOLD, body close -> flip, equality)");
   Deferred("test 20 (target candidate P13: latest HH shown, pullback level not, newer HH changes it, T002 ERL unchanged)");
   Deferred("drawing/panel tests (criterion 10: labels, panel, LIMITED_BY_HISTORY display)");
   Deferred("M5/M15 logic (out of scope)");
   Print("  NOT RUN in MQL5 (Python-only exploration, not counted): CONFLICT never occurs in 120 random series");
  }

void OnStart(void)
  {
   Print("T003 LOGIC TEST start - proposed H4 bias model, MQL5 vs Python-model expectations");
   TestGeneratedCases();
   TestUnits();
   TestNoLookahead();
   TestMirror();
   TestInvariants();
   TestIds();
   TestDeterminism();
   TestDepth();
   TestAbUnits();
   TestSliding();
   TestConsumer();
   TestFlags();
   TestFreezeInternal();
   TestRevision10();
   TestRevision10b();
   TestWeekendRight();
   TestSetupContext();
   TestAnchorByBars();
   TestDiagnostics();
   TestTrackChanges();
   TestCsvExport();
   TestDeferred();
   PrintFormat("T003 LOGIC TEST finished: %d passed, %d failed, %d deferred (deferred are NOT passes)", g_pass, g_fail, g_deferred);
  }
