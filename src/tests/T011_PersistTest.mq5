// END GENERATED FIXTURES
#define POS 987654
#define STEP 0.01
#define LEVEL 4310.5
#define VINIT 0.5
SEsIdentity Ident()
  {
   SEsIdentity i;
   i.server="MetaQuotes-Demo";
   i.login=5001234;
   i.symbol="XAUUSD.r";
   i.position_id=POS;
   return(i);
  }
bool Quote(SEaState &s,SEaResult &r,const double bid)
  {
   return(EA_OnQuote(s,POS,1,LEVEL,bid,bid+0.3,VINIT,VINIT,0.01,STEP,100.0,r));
  }
// an EMPTY expectation means "no condition on the text" (as in the Python table); a non-empty one must be found in one of the two reasons
bool ReasonOk(const string expected,const string reason_a,const string reason_b)
  {
   if(expected=="") return(true);
   return(StringFind(reason_a,expected)>=0 || StringFind(reason_b,expected)>=0);
  }
void TestReasonOk(void)
  {
   Check(ReasonOk("","anything","else"),"an empty expectation puts no condition on the reason");
   Check(ReasonOk("","",""),"an empty expectation accepts empty reasons");
   Check(ReasonOk("MISSING","MISSING: no state file",""),"a non-empty expectation is found in the first reason");
   Check(ReasonOk("MISSING","","RECOVERY_REQUIRED: MISSING"),"a non-empty expectation is found in the second reason");
   Check(!ReasonOk("MISSING","other","reasons"),"a non-empty expectation that is absent fails");
   Check(!ReasonOk("MISSING","",""),"a non-empty expectation fails against empty reasons");
  }
void RunRows(void)
  {
   for(int i=0;i<NROWS;i++)
     {
      string tag=R_NAME[i]+": ";
      SEsIdentity id;
      id.server=R_SERVER[i];
      id.login=R_LOGIN[i];
      id.symbol=R_SYMBOL[i];
      id.position_id=(ulong)R_POS[i];
      SEaState st;
      EA_StateInit(st);
      SEsRestore o;
      ESC_Restore(R_KIND[i]!=1,R_TEXT[i],id,R_KIND[i]==2,st,o);
      Check((int)o.verdict==X_VERDICT[i],tag+"verdict "+ESC_VerdictName(o.verdict)+" ("+o.reason+")");
      Check((int)st.status==X_STATUS[i],tag+"status "+EA_StateName(st.status));
      Check((int)o.new_request_allowed==X_NEWREQ[i],tag+"new_request_allowed "+(string)o.new_request_allowed);
      Check((int)o.reconcile_required==X_RECON[i],tag+"reconcile_required "+(string)o.reconcile_required);
      Check(ReasonOk(X_REASON[i],o.reason,st.reason),tag+"reason contains '"+X_REASON[i]+"' got '"+o.reason+"'");
      if(X_CONF[i]>0) Check(st.confirmations==X_CONF[i],tag+"confirmations preserved "+IntegerToString(st.confirmations));
      if(X_EXEC[i]>0) Check(st.executed_steps==X_EXEC[i],tag+"executed steps preserved");
      if(!(X_VERDICT[i]==3 && X_STATUS[i]==4))
        {
         Check(o.n_orders==X_NORD[i],tag+"order map entries "+IntegerToString(o.n_orders));
         Check(o.generation==X_GEN[i],tag+"generation "+IntegerToString(o.generation));
         Check((o.plan_set ? o.plan_rpol : 0)==X_PLAN[i],tag+"plan code (0 none, 1 typed, 2 R_GEOM) "+IntegerToString(o.plan_rpol));
         if(X_PLAN[i]==2)
            Check((o.plan_e_src==4300.0 && o.plan_s_src==4295.0 && o.plan_e_out==4300.0 && o.plan_s_out==4295.0) || (o.plan_e_src==4300.0 && o.plan_s_src==4305.0 && o.plan_e_out==4300.0 && o.plan_s_out==4305.0),tag+"R_GEOM basis restored");
        }
      if(X_VERDICT[i]==3 && X_STATUS[i]==4)
        {
         SEaResult r;
         bool request=Quote(st,r,4320.0);
         Check(!request && r.event==EA_EV_BLOCKED,tag+"the blocked state cannot produce a request ("+EA_EventName(r.event)+")");
        }
      if(X_CANON[i]==1)
        {
         SEsRecord rc;
         string why,again;
         bool ok=ESC_Decode(R_TEXT[i],rc,why) && ESC_Encode(rc,again,why);
         Check(ok && again==R_TEXT[i],tag+"canonical: re-encoding the decoded record gives the same text");
        }
     }
  }
void MakePending(SEaState &s)
  {
   EA_StateInit(s);
   SEaResult r;
   Quote(s,r,4310.6);
  }
void TestRoundTripOfRealStates(void)
  {
   SEaState s;
   MakePending(s);
   Check(s.status==EA_ST_REQUEST_PENDING,"the real activation reaches REQUEST_PENDING");
   SEsRecord r;
   ESC_RecordInit(r);
   r.generation=2;
   r.id=Ident();
   r.state=s;
   r.send_phase=ESC_SEND_MAPPED;
   r.n_orders=1;
   r.orders[0]=111222;
   string text,why;
   Check(ESC_Encode(r,text,why),"a real PENDING record encodes ("+why+")");
   SEsRecord back;
   Check(ESC_Decode(text,back,why),"and decodes ("+why+")");
   Check(back.state.status==s.status && back.state.request_id==s.request_id && back.state.request_steps==s.request_steps && back.state.close_volume==s.close_volume &&
         back.state.initial_steps==s.initial_steps && back.state.level==s.level && back.state.volume_initial==s.volume_initial && back.state.volume_step==s.volume_step &&
         back.state.confirmations==s.confirmations && back.state.reason==s.reason,"every state field survives the round trip exactly");
   int bad=0;
   int n=StringLen(text);
   for(int k=0;k<n;k++)
     {
      SEsRecord t;
      if(ESC_Decode(StringSubstr(text,0,k),t,why)) bad++;
     }
   Check(bad==0,"every truncation is rejected ("+IntegerToString(bad)+" accepted)");
   bad=0;
   for(int k=0;k<n;k++)
     {
      ushort c=StringGetCharacter(text,k);
      ushort d=(c=='0' ? 'x' : '0');
      string mut=StringSubstr(text,0,k)+ShortToString(d)+StringSubstr(text,k+1);
      SEsRecord t;
      if(ESC_Decode(mut,t,why)) bad++;
     }
   Check(bad==0,"every single-character change is rejected ("+IntegerToString(bad)+" accepted)");
  }
void TestNoRoundingAndInvalidRecords(void)
  {
   SEaState s;
   MakePending(s);
   SEsRecord r;
   ESC_RecordInit(r);
   r.generation=1;
   r.id=Ident();
   r.state=s;
   r.send_phase=ESC_SEND_MAPPED;
   r.n_orders=1;
   r.orders[0]=5;
   string text,why;
   Check(ESC_Encode(r,text,why),"base record encodes");
   r.state.level=0.1+0.2;
   Check(!ESC_Encode(r,text,why),"a value that is not exactly representable with 12 decimals is refused, not rounded");
   r.state.level=s.level;
   r.state.confirmations=2;
   Check(!ESC_Encode(r,text,why),"two confirmations are never written");
   r.state.confirmations=0;
   r.send_phase=ESC_SEND_NONE;
   r.n_orders=0;
   Check(!ESC_Encode(r,text,why),"a request without a persisted send intent is never written");
  }
void TestRestartScenarios(void)
  {
   SEsIdentity id=Ident();
   // restart with a pending request: no second request
   SEaState s;
   MakePending(s);
   SEsRecord r;
   ESC_RecordInit(r);
   r.generation=2;
   r.id=id;
   r.state=s;
   r.send_phase=ESC_SEND_MAPPED;
   r.n_orders=1;
   r.orders[0]=111222;
   string text,why;
   ESC_Encode(r,text,why);
   SEaState restored;
   SEsRestore o;
   ESC_Restore(true,text,id,false,restored,o);
   Check(o.verdict==ESC_USABLE_REQUEST && restored.status==EA_ST_REQUEST_PENDING && !o.new_request_allowed && o.reconcile_required,"pending request restored, reconciliation required, no new request");
   int requests=0;
   for(int k=0;k<3;k++)
     {
      SEaResult res;
      if(Quote(restored,res,4320.0+k)) requests++;
      Check(res.event==EA_EV_IGNORED,"restored pending: quote "+IntegerToString(k)+" is ignored");
     }
   Check(requests==0,"restart with a pending request produces no second request");
   // send intent without a map
   r.send_phase=ESC_SEND_INTENT;
   r.n_orders=0;
   r.orders[0]=0;
   ESC_Encode(r,text,why);
   ESC_Restore(true,text,id,false,restored,o);
   Check(o.verdict==ESC_RECOVERY_REQUIRED && restored.status==EA_ST_NEEDS_RECONCILIATION && o.n_orders==0,"uncertain send: RECOVERY_REQUIRED, no invented map");
   SEaResult res;
   Check(!Quote(restored,res,4320.0) && res.event==EA_EV_RECONCILE_REQUIRED,"and no request is produced");
   // missing file
   ESC_Restore(false,"",id,false,restored,o);
   Check(o.verdict==ESC_RECOVERY_REQUIRED && !o.new_request_allowed && !Quote(restored,res,4320.0),"missing file: no request");
   // IDLE under the protocol: exactly one request, then persist-before-send
   EA_StateInit(s);
   ESC_RecordInit(r);
   r.generation=1;
   r.id=id;
   r.state=s;
   ESC_Encode(r,text,why);
   ESC_Restore(true,text,id,false,restored,o);
   Check(o.verdict==ESC_USABLE_IDLE && o.new_request_allowed,"stored IDLE is usable");
   Check(Quote(restored,res,4320.0) && res.action==EA_ACT_REQUEST_PARTIAL_CLOSE,"IDLE restored: the first request is produced once");
   r.generation=2;
   r.state=restored;
   r.send_phase=ESC_SEND_INTENT;
   ESC_Encode(r,text,why);
   ESC_Restore(true,text,id,false,restored,o);
   Check(!o.new_request_allowed && !Quote(restored,res,4320.0),"after the persisted intent a crash cannot lead to another request");
  }
void TestConfirmationPreserved(void)
  {
   SEsIdentity id=Ident();
   SEaState s;
   MakePending(s);
   SEaResult res;
   EA_OnReport(s,s.request_id,EA_REP_FULL,0.4,STEP,res);
   Check(s.status==EA_ST_DONE && s.confirmations==1,"DONE with one confirmation");
   SEsRecord r;
   ESC_RecordInit(r);
   r.generation=2;
   r.id=id;
   r.state=s;
   r.send_phase=ESC_SEND_MAPPED;
   r.n_orders=1;
   r.orders[0]=111222;
   string text,why;
   Check(ESC_Encode(r,text,why),"DONE encodes");
   SEaState restored;
   SEsRestore o;
   for(int k=0;k<3;k++)
     {
      ESC_Restore(true,text,id,false,restored,o);
      Check(restored.status==EA_ST_DONE && restored.confirmations==1 && restored.executed_steps==40,"restore "+IntegerToString(k)+": DONE, confirmations 1, executed 40");
      r.generation=o.generation+1;
      r.state=restored;
      ESC_Encode(r,text,why);
     }
   ESC_Restore(true,text,id,false,restored,o);
   SErSnapshot snap;
   ER_SnapshotInit(snap,true,POS,restored.request_id,STEP,0.1,true);
   ER_AddExec(snap,"d1",restored.request_id,0.4);
   SErOutcome out;
   ER_Reconcile(restored,snap,out);
   Check(out.decision==ER_CONFIRMED && restored.confirmations==1 && restored.status==EA_ST_DONE,"reconciliation after the restore keeps confirmations at 1");
   EA_OnReport(restored,restored.request_id,EA_REP_FULL,0.4,STEP,res);
   Check(res.event==EA_EV_DUPLICATE_IGNORED && restored.confirmations==1,"a duplicate report after the restore is a duplicate, not a second confirmation");
  }
void TestCrc(void)
  {
   Check(ESC_Crc32("abc")==0x352441C2,"CRC-32 of 'abc' is 352441C2 (the standard check value)");
   Check(ESC_Crc32("")==0,"CRC-32 of the empty string is 0");
   string back;
   Check(ESC_Unescape(ESC_Escape("A B=C"),back) && back=="A B=C" && ESC_Escape("A B=C")=="A%0020B%003DC","escape round trip");
   Check(!ESC_Unescape("a b",back) && !ESC_Unescape("%00",back) && !ESC_Unescape("%00zz",back),"malformed escapes are rejected");
  }
void OnStart()
  {
   TestReasonOk();
   RunRows();
   TestRoundTripOfRealStates();
   TestNoRoundingAndInvalidRecords();
   TestRestartScenarios();
   TestConfirmationPreserved();
   TestCrc();
   PrintFormat("T011 PERSIST TEST finished: %d passed, %d failed",g_pass,g_fail);
  }
