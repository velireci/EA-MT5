// END GENERATED FIXTURES
bool SameState(const SEaState &a,const SEaState &b)
  {
   return(a.status==b.status && a.bound==b.bound && a.position_id==b.position_id && a.direction==b.direction && a.level==b.level &&
          a.volume_initial==b.volume_initial && a.volume_step==b.volume_step && a.request_id==b.request_id && a.request_steps==b.request_steps &&
          a.close_volume==b.close_volume && a.initial_steps==b.initial_steps && a.executed_steps==b.executed_steps &&
          a.confirmations==b.confirmations && a.duplicates_ignored==b.duplicates_ignored && a.reason==b.reason);
  }
// the same set-ups as tests/t011_adapter_fixtures.py setup()
void MakeState(const string name,SEaState &st)
  {
   EA_StateInit(st);
   SEaResult r;
   if(name=="IDLE")
     {
      EA_OnQuote(st,7,1,2000.0,1999.0,1999.3,0.5,0.5,0.01,0.01,100.0,r);
      return;
     }
   bool sell=(StringLen(name)>=4 && StringSubstr(name,StringLen(name)-4)=="SELL");
   if(sell)
      EA_OnQuote(st,7,-1,1990.0,1989.0,1989.4,0.5,0.5,0.01,0.01,100.0,r);
   else
      EA_OnQuote(st,7,1,2000.0,2000.0,2000.3,0.5,0.5,0.01,0.01,100.0,r);
   if(StringSubstr(name,0,3)=="REC")
      EA_OnReport(st,"X2R80-7",EA_REP_TIMEOUT,0.0,0.01,r);
   if(StringSubstr(name,0,4)=="DONE")
      EA_OnReport(st,"X2R80-7",EA_REP_FULL,0.4,0.01,r);
   if(name=="BLOCKED")
      EA_OnReport(st,"X2R80-8",EA_REP_FULL,0.4,0.01,r);
  }
string ExecIds(const SErSnapshot &s)
  {
   string r="";
   for(int i=0;i<s.n_exec;i++)
      r+=(i>0 ? "," : "")+s.exec[i].exec_id;
   return(r);
  }
void RunRows(void)
  {
   for(int i=0;i<NROWS;i++)
     {
      SEaState st,before;
      MakeState(R_SETUP[i],st);
      before=st;
      SXaMap mp;
      XA_MapInit(mp,M_REQ[i],(ulong)M_POS[i],M_SYM[i],M_COMPLETE[i]==1);
      for(int k=0;k<M_NORD[i];k++)
         XA_MapAdd(mp,(ulong)M_ORD[i*FMAXM+k]);
      SXaRaw raw;
      XA_RawInit(raw);
      raw.api_ok=(W_APIOK[i]==1);
      raw.api_error="terminal error";
      raw.symbol_ok=(W_SYMOK[i]==1);
      raw.vol_step=W_STEP[i];
      raw.vol_min=W_MIN[i];
      raw.vol_max=W_MAX[i];
      raw.margin_ok=(W_MARGINOK[i]==1);
      raw.margin_mode=W_MODE[i];
      raw.n_pos=W_NPOS[i];
      raw.pos_ticket=(ulong)W_POSTICKET[i];
      raw.pos_type=W_POSTYPE[i];
      raw.pos_volume=W_POSVOL[i];
      raw.pos_symbol=W_POSSYM[i];
      raw.hist_ok=(W_HISTOK[i]==1);
      raw.deals_truncated=(W_TRUNC[i]==1);
      raw.n_deals=D_N[i];
      for(int d=0;d<D_N[i];d++)
        {
         raw.deal[d].ticket=(ulong)D_TICKET[i*FMAXD+d];
         raw.deal[d].order=(ulong)D_ORDER[i*FMAXD+d];
         raw.deal[d].position_id=(ulong)D_POS[i*FMAXD+d];
         raw.deal[d].entry=D_ENTRY[i*FMAXD+d];
         raw.deal[d].type=D_TYPE[i*FMAXD+d];
         raw.deal[d].volume=D_VOL[i*FMAXD+d];
        }
      raw.n_orders=O_N[i];
      for(int o=0;o<O_N[i];o++)
        {
         raw.ord[o].ticket=(ulong)O_TICKET[i*FMAXO+o];
         raw.ord[o].where=O_WHERE[i*FMAXO+o];
         raw.ord[o].state=O_STATE[i*FMAXO+o];
         raw.ord[o].vol_initial=O_VINIT[i*FMAXO+o];
         raw.ord[o].vol_current=O_VCUR[i*FMAXO+o];
         raw.ord[o].position_id=(ulong)O_POS[i*FMAXO+o];
        }
      SErSnapshot snap;
      SXaResult res;
      bool ok=XA_Build(st,mp,raw,R_STABLE[i]==1,snap,res);
      string tag=R_NAME[i]+": ";
      Check(XA_VerdictName(res.verdict)==X_VERDICT[i],tag+"verdict "+XA_VerdictName(res.verdict)+" expected "+X_VERDICT[i]+" ("+res.reason+")");
      Check(ok==(X_VERDICT[i]=="READY"),tag+"return value matches the verdict");
      Check(SameState(before,st),tag+"the adapter did not touch the state");
      if(X_WHY[i]!="")
         Check(StringFind(res.reason,X_WHY[i])==0,tag+"reason tag "+X_WHY[i]+" got: "+res.reason);
      if(X_VERDICT[i]!="READY")
         continue;
      Check((int)res.complete==X_COMPLETE[i],tag+"completeness "+res.proof);
      Check(res.linked_deals==X_LINKED[i] && res.duplicate_deals==X_DUP[i] && res.excluded_entries==X_EXE[i] && res.excluded_other==X_EXO[i],tag+"counts");
      Check(ExecIds(snap)==X_EXECS[i],tag+"snapshot executions "+ExecIds(snap));
      Check((int)snap.position_found==X_FOUND[i] && snap.volume_current==X_VCUR[i] && snap.volume_step==X_VSTEP[i],tag+"snapshot position and the real volume step");
      Check(snap.executions_complete==res.complete && snap.position_id==(ulong)M_POS[i] && snap.request_id==st.request_id,tag+"snapshot identity and completeness flag");
      SErOutcome o;
      ER_Reconcile(st,snap,o);
      Check(ER_DecisionName(o.decision)==X_DECISION[i] && EA_StateName(st.status)==X_STATE[i],
            tag+"reconcile decides "+ER_DecisionName(o.decision)+" / "+EA_StateName(st.status)+" expected "+X_DECISION[i]+" / "+X_STATE[i]);
      if(res.complete==false)
         Check(o.decision!=ER_CONFIRMED,tag+"an unproven list is never confirmed");
     }
  }
void TestConstants(void)
  {
   Check(XA_ENTRY_IN==(int)DEAL_ENTRY_IN && XA_ENTRY_OUT==(int)DEAL_ENTRY_OUT && XA_ENTRY_INOUT==(int)DEAL_ENTRY_INOUT && XA_ENTRY_OUT_BY==(int)DEAL_ENTRY_OUT_BY,"deal entry mirrors equal the terminal constants");
   Check(XA_DEAL_BUY==(int)DEAL_TYPE_BUY && XA_DEAL_SELL==(int)DEAL_TYPE_SELL,"deal type mirrors equal the terminal constants");
   Check(XA_POS_BUY==(int)POSITION_TYPE_BUY && XA_POS_SELL==(int)POSITION_TYPE_SELL,"position type mirrors equal the terminal constants");
   Check(XA_ORD_PLACED==(int)ORDER_STATE_PLACED && XA_ORD_CANCELED==(int)ORDER_STATE_CANCELED && XA_ORD_PARTIAL==(int)ORDER_STATE_PARTIAL &&
         XA_ORD_FILLED==(int)ORDER_STATE_FILLED && XA_ORD_REJECTED==(int)ORDER_STATE_REJECTED && XA_ORD_EXPIRED==(int)ORDER_STATE_EXPIRED,"order state mirrors equal the terminal constants");
   Check(XA_MARGIN_NETTING==(int)ACCOUNT_MARGIN_MODE_RETAIL_NETTING && XA_MARGIN_EXCHANGE==(int)ACCOUNT_MARGIN_MODE_EXCHANGE && XA_MARGIN_HEDGING==(int)ACCOUNT_MARGIN_MODE_RETAIL_HEDGING,"margin mode mirrors equal the terminal constants");
  }
void TestModeRead(void)
  {
   int mode;
   bool ok;
   XA_ModeRead(0,0,mode,ok);
   Check(ok && mode==XA_MARGIN_NETTING,"margin mode 0 (netting) with no error is a VALID read, not a failure");
   XA_ModeRead(2,0,mode,ok);
   Check(ok && mode==XA_MARGIN_HEDGING,"margin mode 2 (hedging) with no error is valid");
   XA_ModeRead(2,4001,mode,ok);
   Check(!ok && mode==-1,"an error code makes the read fail whatever the value");
   XA_ModeRead(0,4001,mode,ok);
   Check(!ok && mode==-1,"an error code with value 0 still fails");
  }
void TestStability(void)
  {
   SXaRaw a,b;
   XA_RawInit(a);
   XA_RawInit(b);
   a.n_deals=1; b.n_deals=1;
   a.deal[0].ticket=1001; b.deal[0].ticket=1001;
   a.deal[0].volume=0.4; b.deal[0].volume=0.4;
   Check(XA_RawEqual(a,b),"two identical reads are equal");
   b.deal[0].volume=0.3;
   Check(!XA_RawEqual(a,b),"a deal that changed between the reads is detected");
   b.deal[0].volume=0.4;
   b.pos_volume=0.09;
   Check(!XA_RawEqual(a,b),"a position volume that changed between the reads is detected");
   b.pos_volume=0.0;
   b.n_orders=1;
   Check(!XA_RawEqual(a,b),"an order that appeared between the reads is detected");
  }
void OnStart()
  {
   RunRows();
   TestConstants();
   TestModeRead();
   TestStability();
   PrintFormat("T011 ADAPTER TEST finished: %d passed, %d failed",g_pass,g_fail);
  }
