// END GENERATED FIXTURES
void Fill(SDlInput &in,const int i)
  {
   in.utc=(datetime)R_UTC[i];
   in.snapshot_day=R_SNAP[i];
   in.balance_start=R_BAL[i];
   in.closed_result=R_RES[i];
   in.trades_today=R_TRADES[i];
   in.wins_today=R_WINS[i];
   in.consecutive_losses=R_LOSS[i];
   in.max_trades_set=(R_MSET[i]==1);
   in.max_trades=R_MTR[i];
  }
void RunRows(void)
  {
   for(int i=0;i<NROWS;i++)
     {
      SDlInput in;
      SDlResult r;
      Fill(in,i);
      bool ok=DL_Check(in,r);
      string tag=R_NAME[i]+": ";
      Check((int)r.entry_allowed==X_ALLOWED[i] && ok==r.entry_allowed,tag+"entry_allowed "+(string)r.entry_allowed+" ("+DL_Joined(r)+")");
      Check(r.primary==X_PRIMARY[i],tag+"primary reason '"+r.primary+"' expected '"+X_PRIMARY[i]+"'");
      Check(DL_Joined(r)==X_REASONS[i],tag+"all reasons '"+DL_Joined(r)+"' expected '"+X_REASONS[i]+"'");
      Check((int)r.cancel_pending_due==X_CANCEL[i] && (int)r.daily_limit_reached==X_CANCEL[i],tag+"cancel_pending_due / daily_limit_reached "+(string)r.cancel_pending_due);
      Check(r.day_key==X_DAY[i],tag+"Tirane day "+IntegerToString(r.day_key)+" expected "+IntegerToString(X_DAY[i]));
      Check(r.entry_allowed==(r.n_reasons==0),tag+"allowed exactly when there is no reason");
      SDlResult r2;
      DL_Check(in,r2);
      Check(DL_Joined(r)==DL_Joined(r2) && r.primary==r2.primary,tag+"deterministic");
     }
  }
void TestDirect(void)
  {
   double nan=MathSqrt(-1.0);
   double inf=MathExp(1000.0);
   SDlInput in;
   SDlResult r;
   in.utc=(datetime)1784106000; in.snapshot_day=20260715; in.balance_start=10000.0; in.closed_result=0.0;
   in.trades_today=0; in.wins_today=0; in.consecutive_losses=0; in.max_trades_set=true; in.max_trades=3;
   Fill(in,0);
   in.balance_start=nan;
   DL_Check(in,r);
   Check(!r.entry_allowed && r.primary=="INVALID_SNAPSHOT:balance_start" && !r.cancel_pending_due,"NaN balance is invalid and invents no limit");
   Fill(in,0);
   in.balance_start=inf;
   DL_Check(in,r);
   Check(!r.entry_allowed && r.primary=="INVALID_SNAPSHOT:balance_start" && !r.cancel_pending_due,"infinite balance is invalid");
   Fill(in,0);
   in.closed_result=nan;
   DL_Check(in,r);
   Check(!r.entry_allowed && r.primary=="INVALID_SNAPSHOT:closed_result" && !r.cancel_pending_due,"NaN closed result is invalid");
   Fill(in,0);
   in.closed_result=-inf;
   DL_Check(in,r);
   Check(!r.entry_allowed && r.primary=="INVALID_SNAPSHOT:closed_result" && !r.cancel_pending_due,"an infinite loss is invalid, not a limit");
   // review of 43fc94a: a tiny balance never turns a zero or positive result into a daily loss; an underflowing threshold is refused
   double tiny_bal[5];
   tiny_bal[0]=1e-15; tiny_bal[1]=1e-100; tiny_bal[2]=1e-300; tiny_bal[3]=0.01; tiny_bal[4]=1e300;
   double res_ok[4];
   res_ok[0]=0.0; res_ok[1]=1e-300; res_ok[2]=1.0; res_ok[3]=1e6;
   int bad_loss=0;
   for(int b=0;b<5;b++)
      for(int q=0;q<4;q++)
        {
         Fill(in,0);
         in.balance_start=tiny_bal[b];
         in.closed_result=res_ok[q];
         in.max_trades_set=true; in.max_trades=2; in.trades_today=0; in.wins_today=0; in.consecutive_losses=0;
         DL_Check(in,r);
         if(StringFind(DL_Joined(r),"DAILY_LOSS_LIMIT")>=0 || r.cancel_pending_due)
            bad_loss++;
        }
   Check(bad_loss==0,"a zero or positive result is never a daily loss, whatever the balance (tiny and huge)");
   Fill(in,0);
   in.balance_start=1e-15; in.closed_result=-2e-17;
   DL_Check(in,r);
   Check(StringFind(DL_Joined(r),"DAILY_LOSS_LIMIT")>=0,"tiny balance: a loss at the 2% line still blocks");
   Fill(in,0);
   in.balance_start=DBL_MIN; in.closed_result=-1.0;
   DL_Check(in,r);
   Check(!r.entry_allowed && DL_Joined(r)=="INVALID_SNAPSHOT:balance_start" && !r.cancel_pending_due && !r.daily_limit_reached,"a balance whose 2% threshold underflows is refused, no limit is invented");
   Fill(in,0);
   in.balance_start=DBL_MIN*50.0; in.closed_result=0.0;
   DL_Check(in,r);
   Check(r.entry_allowed,"the smallest balance with a representable threshold is accepted and a zero result is clear");
   // an invalid utc never proves a limit
   Fill(in,0);
   in.utc=(datetime)0; in.wins_today=1; in.trades_today=1;
   DL_Check(in,r);
   Check(!r.entry_allowed && r.primary=="INVALID_UTC" && !r.cancel_pending_due && !r.daily_limit_reached,"invalid UTC with a counted win: blocked, no daily limit invented");
  }
void OnStart()
  {
   RunRows();
   TestDirect();
   PrintFormat("T012 DAILY LIMITS TEST finished: %d passed, %d failed",g_pass,g_fail);
  }
