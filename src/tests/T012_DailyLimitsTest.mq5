// T012 test script: pure daily-limit check. Mirrors tests/test_t012_daily.py; the fixtures below are the hand-written scenario table of
// tests/t012_daily_fixtures.py. NOT YET COMPILED OR RUN in MT5 (UNVERIFIED). No order, no account read, no clock, no persistence.
#property strict
#property script_show_inputs
#property version "1.00"
#include "../include/DailyLimits.mqh"
int g_pass=0,g_fail=0;
void Check(const bool ok,const string message)
  {
   if(ok) {g_pass++; Print("PASS ",message);}
   else {g_fail++; Print("FAIL ",message);}
  }
