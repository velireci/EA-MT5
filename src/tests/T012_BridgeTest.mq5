// T012 bridge test script: DB_Check (history FACTS + explicit policies -> DL_Check). Mirrors tests/test_t012_bridge.py; the fixtures below are the
// hand-written scenario table of tests/t012_bridge_fixtures.py. NOT YET COMPILED OR RUN in MT5 (UNVERIFIED).
// Pure: no terminal read, no order, no clock (the instant is a fixture), no persistence. Only the SDhFacts members the bridge reads are set.
#property strict
#property script_show_inputs
#property version "1.00"
#include "../include/DailyBridge.mqh"
int g_pass=0,g_fail=0;
void Check(const bool ok,const string message)
  {
   if(ok) {g_pass++; Print("PASS ",message);}
   else {g_fail++; Print("FAIL ",message);}
  }
