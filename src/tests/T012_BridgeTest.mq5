// END GENERATED FIXTURES
void SetFacts(SDhFacts &f,const int i)
  {
   f.day_key=R_FDAY[i];
   f.complete=(R_COMPLETE[i]==1);
   f.n_pos=R_NPOS[i];
   f.deals_in_window=R_DEALS[i];
   f.candidate_profit=(R_NANP[i]==1 ? MathSqrt(-1.0) : R_CP[i]);
   f.candidate_profit_commission_swap=R_CPCS[i];
   f.candidate_profit_commission_swap_fee=R_CPCSF[i];
  }
void RunRows(void)
  {
   for(int i=0;i<NROWS;i++)
     {
      SDhFacts f;
      SetFacts(f,i);
      SDbBalance b;
      b.known=(R_BKNOWN[i]==1);
      b.day=R_BDAY[i];
      b.amount=R_BAMT[i];
      SDbPolicy p;
      p.result_formula=R_FORMULA[i];
      p.classification=R_CLASSIF[i];
      SDbClassified c;
      c.trades=R_TRADES[i];
      c.wins=R_WINS[i];
      c.consecutive_losses=R_LOSSES[i];
      SDbResult r;
      bool allowed=DB_Check((ENUM_DH_VERDICT)R_VERDICT[i],f,(datetime)R_UTC[i],b,p,c,R_MAXSET[i]==1,R_MAXT[i],r);
      string tag=R_NAME[i]+": ";
      string reasons=DB_Joined(r);
      Check((int)allowed==X_ALLOWED[i] && allowed==r.entry_allowed,tag+"allowed "+(string)allowed+" ("+reasons+")");
      Check(reasons==X_REASONS[i],tag+"reasons '"+reasons+"' expected '"+X_REASONS[i]+"'");
      Check((int)r.dl_called==X_CALLED[i],tag+"daily check called "+(string)r.dl_called);
      Check((int)r.cancel_pending_due==X_CANCEL[i] && (int)r.daily_limit_reached==X_CANCEL[i],tag+"cancel_pending_due (diagnostic) "+(string)r.cancel_pending_due);
      if(X_CALLED[i]==1 && !(R_NANP[i]==1 && R_FORMULA[i]==DB_FORMULA_PROFIT))
         Check(MathAbs(r.closed_result-X_CLOSED[i])<=1e-9,tag+"closed result "+DoubleToString(r.closed_result,2)+" expected "+DoubleToString(X_CLOSED[i],2));
      if(X_CALLED[i]==0)
         Check(!allowed && !r.cancel_pending_due && !r.daily_limit_reached,tag+"a bridge gap proves no limit");
      Check(r.primary==(r.n_reasons>0 ? r.reasons[0] : ""),tag+"primary is the first reason");
     }
  }
void OnStart()
  {
   RunRows();
   PrintFormat("T012 BRIDGE TEST finished: %d passed, %d failed",g_pass,g_fail);
  }
