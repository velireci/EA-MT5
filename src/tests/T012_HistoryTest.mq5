// END GENERATED FIXTURES
void RunRows(void)
  {
   for(int i=0;i<NROWS;i++)
     {
      SDhCfg cfg;
      cfg.ea_magic=C_MAGIC[i];
      cfg.utc_in_day=(datetime)C_UTC[i];
      cfg.server_offset_seconds=C_OFFSET[i];
      cfg.history_complete_asserted=(C_ASSERTED[i]==1);
      SDhRaw raw;
      DH_RawInit(raw);
      raw.api_ok=(W_APIOK[i]==1);
      raw.api_error="terminal error";
      raw.hist_ok=(W_HISTOK[i]==1);
      raw.positions_ok=(W_POSOK[i]==1);
      raw.margin_ok=(W_MARGINOK[i]==1);
      raw.margin_mode=W_MODE[i];
      raw.vol_step=W_STEP[i];
      raw.deals_truncated=(W_DTRUNC[i]==1);
      raw.pos_truncated=(W_PTRUNC[i]==1);
      raw.n_deals=D_N[i];
      for(int d=0;d<D_N[i];d++)
        {
         int k=i*FMAXD+d;
         raw.deal[d].ticket=(ulong)D_TICKET[k];
         raw.deal[d].position_id=(ulong)D_POS[k];
         raw.deal[d].time=D_TIME[k];
         raw.deal[d].entry=D_ENTRY[k];
         raw.deal[d].type=D_TYPE[k];
         raw.deal[d].magic=D_MAGIC[k];
         raw.deal[d].volume=D_VOL[k];
         raw.deal[d].profit=D_PROFIT[k];
         raw.deal[d].commission=D_COMM[k];
         raw.deal[d].swap=D_SWAP[k];
         raw.deal[d].fee=D_FEE[k];
        }
      raw.n_pos=P_N[i];
      for(int p=0;p<P_N[i];p++)
        {
         int k=i*FMAXP+p;
         raw.pos[p].position_id=(ulong)P_ID[k];
         raw.pos[p].opened_known=(P_KNOWN[k]==1);
         raw.pos[p].opened_magic=P_MAGIC[k];
         raw.pos[p].open_volume_total=P_OPENV[k];
         raw.pos[p].closed_volume_total=P_CLOSEDV[k];
         raw.pos[p].is_open=(P_ISOPEN[k]==1);
        }
      SDhRaw before=raw;
      SDhFacts facts;
      string reason;
      ENUM_DH_VERDICT v=DH_Build(cfg,raw,R_STABLE[i]==1,facts,reason);
      string tag=R_NAME[i]+": ";
      Check(DH_VerdictName(v)==X_VERDICT[i],tag+"verdict "+DH_VerdictName(v)+" expected "+X_VERDICT[i]+" ("+reason+")");
      Check(DH_RawEqual(before,raw),tag+"the core did not change its input");
      if(X_WHY[i]!="")
         Check(StringFind(reason,X_WHY[i])==0,tag+"reason tag "+X_WHY[i]+" got: "+reason);
      if(v==DH_READY)
        {
         string txt=DH_FactsText(facts);
         Check(txt==X_FACTS[i],tag+"facts '"+txt+"' expected '"+X_FACTS[i]+"'");
         Check(facts.result_formula=="UNSET" && !facts.balance_start_known,tag+"no result formula selected, balance at the start of the day not claimed");
        }
     }
  }
void TestConstants(void)
  {
   Check(DH_ENTRY_IN==(int)DEAL_ENTRY_IN && DH_ENTRY_OUT==(int)DEAL_ENTRY_OUT && DH_ENTRY_INOUT==(int)DEAL_ENTRY_INOUT && DH_ENTRY_OUT_BY==(int)DEAL_ENTRY_OUT_BY,"deal entry mirrors equal the terminal constants");
   Check(DH_DEAL_BUY==(int)DEAL_TYPE_BUY && DH_DEAL_SELL==(int)DEAL_TYPE_SELL,"deal type mirrors equal the terminal constants");
   Check((int)DEAL_TYPE_BALANCE!=DH_DEAL_BUY && (int)DEAL_TYPE_BALANCE!=DH_DEAL_SELL && (int)DEAL_TYPE_CREDIT!=DH_DEAL_BUY && (int)DEAL_TYPE_CHARGE!=DH_DEAL_SELL,"balance, credit and charge deals are not trade types");
   Check(DH_MARGIN_HEDGING==(int)ACCOUNT_MARGIN_MODE_RETAIL_HEDGING,"hedging mirror equals the terminal constant");
  }
void OnStart()
  {
   RunRows();
   TestConstants();
   PrintFormat("T012 HISTORY TEST finished: %d passed, %d failed",g_pass,g_fail);
  }
