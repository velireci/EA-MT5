// END GENERATED FIXTURES
void RunRows(void)
  {
   SEaState st;
   EA_StateInit(st);
   string cur="";
   int row_in_scn=0;
   int requests_in_scn=0;
   for(int i=0;i<NROWS;i++)
     {
      if(R_SCN[i]!=cur)
        {
         cur=R_SCN[i];
         EA_StateInit(st);
         row_in_scn=0;
         requests_in_scn=0;
        }
      row_in_scn++;
      SEaResult r;
      if(R_IS_Q[i]==1)
         EA_OnQuote(st,(ulong)R_POS[i],R_DIR[i],R_LEVEL[i],R_BID[i],R_ASK[i],R_VINIT[i],R_VCUR[i],R_VMIN[i],R_STEP[i],R_VMAX[i],r);
      else
         EA_OnReport(st,R_RID[i],(ENUM_EA_REPORT)R_RKIND[i],R_RVOL[i],R_STEP[i],r);
      string tag=StringFormat("%s #%d: ",cur,row_in_scn);
      Check(EA_EventName(r.event)==X_EVENT[i],tag+"event "+EA_EventName(r.event)+" expected "+X_EVENT[i]+" ("+r.reason+")");
      Check(EA_StateName(st.status)==X_STATE[i],tag+"state "+EA_StateName(st.status)+" expected "+X_STATE[i]);
      Check(EA_ActionName(r.action)==X_ACTION[i],tag+"action "+EA_ActionName(r.action));
      Check(r.request_id==X_RID[i] && r.request_steps==X_RSTEPS[i],tag+"request id and steps");
      Check(st.confirmations==X_CONF[i] && st.duplicates_ignored==X_DUP[i],tag+"confirmation counters");
      if(r.event!=EA_EV_OK && r.event!=EA_EV_IGNORED && r.event!=EA_EV_DUPLICATE_IGNORED)
         Check(r.reason!="",tag+"reason reported");
      if(r.action==EA_ACT_REQUEST_PARTIAL_CLOSE)
        {
         requests_in_scn++;
         Check(requests_in_scn==1,tag+"only one request per scenario");
         Check(r.request_steps*5==st.initial_steps*4 && r.request_volume==(double)r.request_steps*R_STEP[i],tag+"request volume is exactly 80 percent of the initial steps");
         Check(r.request_id==EA_RequestId((ulong)R_POS[i]),tag+"stable request id");
        }
     }
  }
void TestInvalid(void)
  {
   double nan=MathSqrt(-1.0);
   double inf=MathExp(1000.0);
   SEaState st;
   SEaResult r;
   double bad[4];
   bad[0]=0.0;
   bad[1]=-1.0;
   bad[2]=nan;
   bad[3]=inf;
   for(int k=0;k<4;k++)
     {
      EA_StateInit(st);
      EA_OnQuote(st,7,1,bad[k],2000.0,2000.3,0.1,0.1,0.01,0.01,100.0,r);
      Check(r.event==EA_EV_INVALID_INPUT && !st.bound && st.status==EA_ST_IDLE,"non-finite or non-positive level changes nothing");
      EA_StateInit(st);
      EA_OnQuote(st,7,1,2000.0,bad[k],2000.3,0.1,0.1,0.01,0.01,100.0,r);
      Check(r.event==EA_EV_INVALID_INPUT && !st.bound,"bad bid changes nothing");
      EA_StateInit(st);
      EA_OnQuote(st,7,1,2000.0,2000.0,bad[k],0.1,0.1,0.01,0.01,100.0,r);
      Check(r.event==EA_EV_INVALID_INPUT && !st.bound,"bad ask changes nothing");
      EA_StateInit(st);
      EA_OnQuote(st,7,1,2000.0,2000.0,2000.3,bad[k],0.1,0.01,0.01,100.0,r);
      Check(r.event==EA_EV_INVALID_INPUT && !st.bound,"bad initial volume changes nothing");
      EA_StateInit(st);
      EA_OnQuote(st,7,1,2000.0,2000.0,2000.3,0.1,bad[k],0.01,0.01,100.0,r);
      Check(r.event==EA_EV_INVALID_INPUT && !st.bound,"bad current volume changes nothing");
      EA_StateInit(st);
      EA_OnQuote(st,7,1,2000.0,2000.0,2000.3,0.1,0.1,0.01,0.01,100.0,r);
      EA_OnReport(st,"X2R80-7",EA_REP_FULL,bad[k]==0.0 ? nan : bad[k],0.01,r);
      Check(r.event==EA_EV_INVALID_INPUT && st.status==EA_ST_REQUEST_PENDING,"bad executed volume keeps the request pending");
     }
   EA_StateInit(st);
   EA_OnQuote(st,0,1,2000.0,2000.0,2000.3,0.1,0.1,0.01,0.01,100.0,r);
   Check(r.event==EA_EV_INVALID_INPUT,"position id 0 is invalid");
   EA_OnQuote(st,7,0,2000.0,2000.0,2000.3,0.1,0.1,0.01,0.01,100.0,r);
   Check(r.event==EA_EV_INVALID_INPUT,"direction 0 is invalid");
   EA_OnQuote(st,7,1,2000.0,2000.4,2000.0,0.1,0.1,0.01,0.01,100.0,r);
   Check(r.event==EA_EV_INVALID_INPUT,"ask below bid is invalid");
   EA_OnReport(st,"X2R80-7",(ENUM_EA_REPORT)9,0.08,0.01,r);
   Check(r.event==EA_EV_INVALID_INPUT && st.status==EA_ST_IDLE,"unknown report kind is invalid and changes nothing");
  }
void OnStart()
  {
   RunRows();
   TestInvalid();
   // determinism and independence: two states fed the same events end identically; the other is untouched
   SEaState a,b,c;
   SEaResult r;
   EA_StateInit(a); EA_StateInit(b); EA_StateInit(c);
   EA_OnQuote(a,7,1,2000.0,2000.0,2000.3,0.1,0.1,0.01,0.01,100.0,r);
   EA_OnQuote(b,7,1,2000.0,2000.0,2000.3,0.1,0.1,0.01,0.01,100.0,r);
   Check(a.status==b.status && a.request_id==b.request_id && a.request_steps==b.request_steps && c.status==EA_ST_IDLE && !c.bound,"determinism; a state the caller did not pass is untouched");
   PrintFormat("T011 ACTIVATION TEST finished: %d passed, %d failed",g_pass,g_fail);
  }
