InpOpenPositions=-1
InpTradesToday=-1
InpExistingRisk=-1
InpMaxPositions=-1
InpMaxTrades=-1
InpDailySource=2
InpDailyBalanceSource=1
InpDailySnapshotDay=0
InpDailyBalanceStart=-1
InpDailyResultKnown=false
InpDailyClosedResult=0
InpDailyWins=-1
InpDailyConsecutiveLosses=-1
